{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "kill-dotnet",
			"type": "shell",
			"command": "Get-Process -Name 'PoMiniGames.API' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; $p=(netstat -aon | Select-String ':5080 ') -replace '.*\\s+(\\d+)$','$1' | Select-Object -First 1; if ($p -and $p -ne '0') { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue }; exit 0",
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"close": true
			},
			"problemMatcher": []
		},
		{
			"label": "start-azurite",
			"type": "shell",
			"command": "docker compose -f \"${workspaceFolder}/docker-compose.yml\" up -d azurite",
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"close": true
			},
			"problemMatcher": []
		},
		{
			"label": "start-api",
			"type": "shell",
			"command": "dotnet run --project ${workspaceFolder}/src/PoMiniGames.API/PoMiniGames.API.csproj",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting PoMiniGames",
					"endsPattern": "Application started"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/PoMiniGames.API/PoMiniGames.API.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "smoke-local",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/smoke-local.ps1"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "build-client",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/PoMiniGames.Client/PoMiniGamesClient.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"group": "build",
			"problemMatcher": "$msCompile",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "prelaunch",
			"dependsOn": [
				"kill-dotnet",
				"start-azurite",
				"start-api"
			],
			"dependsOrder": "sequence",
			"problemMatcher": []
		}
	]
}

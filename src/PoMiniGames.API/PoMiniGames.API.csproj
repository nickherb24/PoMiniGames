<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props -->
    <!-- Project is Po{Name}.API per the naming rule, but the code namespace stays
         PoMiniGames.* — every file declares it explicitly, and the assembly would
         otherwise default RootNamespace to PoMiniGames.API and drop new files into a
         second, parallel namespace root. Pinned so that cannot drift.

         Renaming this project changed the assembly to PoMiniGames.API.dll. That is safe
         because every identity string is a hardcoded constant, NOT reflected from the
         assembly name — see TelemetryExtensions.CloudRoleName, the Key Vault secret
         prefix in PrefixKeyVaultSecretManager, and above all DataProtectionExtensions.SetApplicationName
         ("PoMiniGames"), which keys the cookie key-ring purpose. Had that one been
         derived from the assembly name, this rename would have invalidated every live
         auth cookie on the next deploy. Keep them constant. -->
    <RootNamespace>PoMiniGames</RootNamespace>
    <UserSecretsId>pomini-games-secret-id</UserSecretsId>
    <!--
      Hosting the Blazor WebAssembly client inside this API project (§ Architecture).
      The Microsoft.NET.Sdk.Web glue picks up the referenced Client's static web
      assets via the static-web-assets manifest (`obj/.../staticwebassets.build.json`)
      and exposes them through `UseStaticFiles()` / `UseBlazorFrameworkFiles()`.
      `SpaRoot` is intentionally NOT set — that is the legacy npm/gulp SPA-template
      hook which tries to run `npm install/build` on startup and breaks the
      BlazorWasm static-asset pipeline. `SpaProxyUrl` is similarly unused.
    -->
    <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- §1.2 MinVer: brings in the .targets that compute the version at restore/build
         time. No actual code reference; the only side effect is version stamping. -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- PoVoxelStrike author-time voxel assets (PRD §5.4): the drop folder ships INSIDE
         the deployment package (WEBSITE_RUN_FROM_PACKAGE mounts it read-only; ingestion
         output goes to the writable path from config). Without this include a publish
         carries no GLBs and every deployed arena silently falls back to procedural
         primitives. drop/ only — converted/ is a build product and stays out of both
         git and the package. -->
<Content Include="App_Data/povoxelstrike/drop/*.glb"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Voxel painter (#9): author sidecars ship with the GLBs. The SDK auto-globs every
         file under App_Data/ as Content (EnableDefaultContentItems=true); without the
         explicit <Content Remove> an NETSDK1022 "Duplicate Content items" error fires.
         The Remove uses the same path the SDK computed, leaving only the explicit one. -->
    <Content Remove="App_Data/povoxelstrike/drop/Box.glb.pvx-mat.json" />
    <Content Include="App_Data/povoxelstrike/drop/Box.glb.pvx-mat.json"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Expose internals (e.g. PoRacerSim) to the unit-test tier so the AI sim can be
       driven headlessly in a bot-only race for regression testing. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PoMiniGames.Unit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <!-- The chat clients wrap an ME.AI IChatClient resolved from
         AIFoundryChatClientCache; the .AsIChatClient() adapter extension lives here. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- API -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- PoVoxelStrike: GLB → voxel ingestion (Features/PoVoxelStrike/GlbVoxelizer). -->
    <PackageReference Include="SharpGLTF.Core" />
    <!-- Invites: the lobby QR code (Features/Invites/InviteEndpoints.QrSvg). Server-side only,
         so it costs the WASM bundle nothing. -->
    <PackageReference Include="QRCoder" />
    <!-- Logging / Telemetry -->
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Exceptions" />
  </ItemGroup>

  <!-- Blazor WASM hosting glue: pull the Client's static web assets (the
       `wwwroot/_framework/` directory produced at build time) into the host's
       own `bin/Debug/net10.0/wwwroot/` so `UseBlazorFrameworkFiles()` and
       `UseStaticFiles()` can serve them in `dotnet run` (F5) as well as in
       `dotnet publish`. The SDK normally does this at publish time, but the
       `dotnet run` pipeline skips the file-system copy in some environments —
       the ProjectReference below makes the copy deterministic in dev. -->
  <ItemGroup>
    <ProjectReference Include="..\PoMiniGames.Shared\PoMiniGames.Shared.csproj" />
    <ProjectReference Include="..\PoMiniGames.Domain\PoMiniGames.Domain.csproj" />
    <ProjectReference Include="..\PoMiniGames.Infrastructure\PoMiniGames.Infrastructure.csproj" />
    <ProjectReference Include="..\PoMiniGames.Client\PoMiniGamesClient.csproj" />
  </ItemGroup>

  <!--
    Stage the Client's wwwroot output into the host's wwwroot at build time.
    This is the safety net: even if the static-web-assets manifest pipeline
    is bypassed (e.g. when running with no-build), the framework files
    (blazor.webassembly.js, dotnet.runtime.*.js, the .wasm payload and
    the SRI-bearing blazor.boot.json shim) are present on disk so
    UseBlazorFrameworkFiles() and UseStaticFiles() can find them.

    Source uses a wildcard so the staging rule is re-evaluated on every build
    (no incremental tracking staleness).
  -->
  <Target Name="StageBlazorClientStaticWebAssets" AfterTargets="Build">
    <ItemGroup>
      <_BlazorClientWwwroot Include="..\PoMiniGames.Client\bin\$(Configuration)\net10.0\wwwroot\**\*.*" />
      <!-- The Blazor WASM SDK doesn't auto-copy wwwroot/appsettings*.json into the
           build output, but the runtime needs them (the client reads its API base
           address from them at startup). Copy them directly from the source. -->
      <_BlazorClientSettings Include="..\PoMiniGames.Client\wwwroot\appsettings.json"
                             Condition="Exists('..\PoMiniGames.Client\wwwroot\appsettings.json')" />
      <_BlazorClientSettingsDev Include="..\PoMiniGames.Client\wwwroot\appsettings.Development.json"
                                Condition="Exists('..\PoMiniGames.Client\wwwroot\appsettings.Development.json')" />
    </ItemGroup>
    <RemoveDir Directories="$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\wwwroot\_framework"
               Condition="Exists('$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\wwwroot\_framework')" />
    <Copy
      SourceFiles="@(_BlazorClientWwwroot)"
      DestinationFiles="@(_BlazorClientWwwroot->'$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_BlazorClientSettings)"
      DestinationFiles="@(_BlazorClientSettings->'$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\wwwroot\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_BlazorClientSettingsDev)"
      DestinationFiles="@(_BlazorClientSettingsDev->'$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\wwwroot\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition=" '$(Configuration)' == 'Debug' " />
  </Target>

  <!-- Husky.Net was retired on 2026-09-11: .husky/, .config/dotnet-tools.json and
       package.json are gone, so the pre-commit gate no longer exists. The CI
       format step (deploy.yml, continue-on-error) remains the only format
       watchdog. Do not reintroduce this target without restoring the hook files. -->

</Project>

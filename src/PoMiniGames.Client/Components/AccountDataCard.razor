@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services.Auth
@using PoMiniGamesClient.Services.Http
@using PoMiniGamesClient.Services.Ui
@inject ApiService ApiService
@inject ToastService Toasts
@inject IJSRuntime JS
@inject AuthStateService AuthState
@inject NavigationManager Navigation

@* Export and erase, as a group inside the settings sheet (2026-10-01; it used to close
   the profile's last tab). The sheet supplies the "Your data" legend. Erasing reloads
   the app: every page caches some of what was just deleted. *@
<div class="acct-data">
    <p class="acct-data-blurb">
        Scores, match history and player stats are stored against your
        @(IsGuest ? "guest profile" : "Microsoft account").
        You can take a copy or remove all of it.
    </p>

    <div class="acct-data-actions">
        <button type="button" class="app-btn app-btn--secondary app-btn--sm" disabled="@_dataBusy" @onclick="ExportDataAsync">
            @(_dataBusy && _busyAction == "export" ? "Preparing…" : "Download my data")
        </button>

        @if (!_eraseArmed)
        {
            <button type="button" class="app-btn app-btn--secondary app-btn--sm acct-data-danger"
                    disabled="@_dataBusy" @onclick="() => _eraseArmed = true">
                Erase my data
            </button>
        }
    </div>

    @if (_eraseArmed)
    {
        <div class="acct-data-confirm" role="group" aria-labelledby="acct-erase-label">
            <p id="acct-erase-label" class="acct-data-warn">
                This permanently deletes your leaderboard entries, match history and stats.
                It cannot be undone. Type <strong>ERASE</strong> to confirm.
            </p>
            <div class="acct-data-confirm-row">
                <input class="acct-data-input" type="text" autocomplete="off" spellcheck="false"
                       aria-label="Type ERASE to confirm" placeholder="ERASE"
                       @bind="_eraseConfirm" @bind:event="oninput" />
                <button type="button" class="app-btn app-btn--secondary app-btn--sm acct-data-danger"
                        disabled="@(_dataBusy || !EraseConfirmed)" @onclick="EraseDataAsync">
                    @(_dataBusy && _busyAction == "erase" ? "Erasing…" : "Erase everything")
                </button>
                <button type="button" class="app-btn app-btn--ghost app-btn--sm"
                        disabled="@_dataBusy" @onclick="CancelErase">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>

@code {
    // Same heuristic the profile uses: a guest session's display name is the minted
    // "Guest-NNNNNN" handle; AuthenticatedUserProfile carries no kind of its own.
    private bool IsGuest => AuthState.User?.DisplayName?.StartsWith("Guest", StringComparison.Ordinal) ?? true;

    private bool _dataBusy;
    private string? _busyAction;
    private bool _eraseArmed;
    private string _eraseConfirm = "";

    private bool EraseConfirmed => _eraseConfirm.Trim() == "ERASE";

    private void CancelErase()
    {
        _eraseArmed = false;
        _eraseConfirm = "";
    }

    private async Task ExportDataAsync()
    {
        if (_dataBusy) return;
        _dataBusy = true;
        _busyAction = "export";
        try
        {
            var json = await ApiService.ExportAccountDataAsync();
            if (string.IsNullOrWhiteSpace(json))
            {
                Toasts.Show("Couldn't prepare your data right now. Try again in a moment.", ToastType.Error);
                return;
            }

            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fileDownload.js");
            await using (module)
            {
                await module.InvokeVoidAsync(
                    "saveText",
                    $"pominigames-data-{DateTime.UtcNow:yyyyMMdd}.json",
                    json,
                    "application/json");
            }

            Toasts.Show("Your data is downloading.", ToastType.Success);
        }
        catch
        {
            Toasts.Show("Couldn't prepare your data right now. Try again in a moment.", ToastType.Error);
        }
        finally
        {
            _dataBusy = false;
            _busyAction = null;
        }
    }

    private async Task EraseDataAsync()
    {
        if (_dataBusy || !EraseConfirmed) return;
        _dataBusy = true;
        _busyAction = "erase";
        try
        {
            var result = await ApiService.EraseAccountDataAsync();
            if (result is null)
            {
                Toasts.Show("Nothing was erased — the request didn't reach the server.", ToastType.Error);
                return;
            }

            CancelErase();
            Toasts.Show(
                result.TotalRows == 0
                    ? "Nothing left to erase — you had no stored rows."
                    : $"Erased {result.TotalRows} stored row{(result.TotalRows == 1 ? "" : "s")}.",
                ToastType.Success);

            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch
        {
            Toasts.Show("Couldn't erase your data right now. Try again in a moment.", ToastType.Error);
        }
        finally
        {
            _dataBusy = false;
            _busyAction = null;
        }
    }
}

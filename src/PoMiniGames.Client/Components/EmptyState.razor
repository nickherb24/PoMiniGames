@namespace PoMiniGamesClient.Components

@*
    Universal "no rows yet" view.

    Drop-in primitive for every list / lobby / leaderboard that can render
    empty. Composition: icon (emoji, supplied by caller) + headline + body
    sentence + optional action button. The visual treatment lives entirely
    in wwwroot/css/app.css under `.app-empty-state*`, so a new page should
    never have to write its own empty-state CSS — only this component.

    Pages that currently roll their own empty markup (`<p>No scores yet.</p>`,
    themed one-offs in `.prf-page`, etc.) should migrate here. The
    no-inline-style rule is honoured: this component passes any
    runtime values via CSS custom properties on `style="…"` rather than
    static styles.
*@

<div class="app-empty-state" role="status" aria-live="polite">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <div class="app-empty-state__icon" aria-hidden="true">@Icon</div>
    }
    @if (!string.IsNullOrEmpty(Title))
    {
        <h3 class="app-empty-state__title">@Title</h3>
    }
    @if (ChildContent != null)
    {
        <div class="app-empty-state__body">@ChildContent</div>
    }
    @if (Action != null)
    {
        <div class="app-empty-state__action">@Action</div>
    }
</div>

@code {
    /// <summary>Emoji or short text rendered large and dimmed. Leave null to skip.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Headline (rendered as <h3>). Leave null to skip.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Body sentence or list explaining the empty state.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional action slot — usually a `.app-btn--primary` "Try again" /
    /// "Browse games" / "Sign in" button. The caller owns the styling;
    /// this component only centres it inside `.app-empty-state__action`.
    /// </summary>
    [Parameter] public RenderFragment? Action { get; set; }
}
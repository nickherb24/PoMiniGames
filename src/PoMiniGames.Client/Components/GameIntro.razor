@namespace PoMiniGamesClient.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable

@* ─────────────────────────────────────────────────────────────────────────
   GameIntro — the one centered welcome/controls card every game opens on.

   A blocking overlay rendered inside a game's GameShell ChildContent (or
   standalone for games that can't host GameShell). It welcomes the player,
   shows the controls (reuse the page's existing HowToPlay fragment), and
   gates the start of play by mode:

     • Demo       → flashes for DemoDelayMs (default 2s), then auto-starts.
     • OnePlayer  → stays up until the player presses OK (or Enter/Space).
     • TwoPlayer  → shows an optional Options slot (e.g. Brawl's per-player
                    keyboard character select) and a Start button that is
                    disabled until StartEnabled. Keydowns are forwarded to
                    the host via OnKey so each game wires its own two-player
                    selection to its in-game keys.

   Styling lives in wwwroot/css/game-shell.css (.gps-intro-*), mirroring the
   shared end-of-game modal so intro + outro read as one system.
   ───────────────────────────────────────────────────────────────────────── *@

@* 2026-08-08 audit #6: this card sits between the player and every 1-player
   game, so dismissing it must not require aiming. Keyboard users already had
   Enter/Space/Escape (HandleKey); pointer users had the OK button plus
   tap-to-dismiss on the BACKDROP — the whole screen outside the card, still a
   generous target. Card taps stopped dismissing when the card grew its first
   interactive control (PoBrawl's "Training first" checkbox, 2026-09-23): card
   clicks bubble to the overlay's handler, so a tap meant to tick the box
   started the game instead. The card now stops propagation in every mode,
   which is also what TwoPlayer always did for its character select. *@
@* _skipDecision: null = the localStorage check has not landed yet (render
   nothing for a beat rather than flash the card and yank it away); false =
   show the card; true = the player opted out — auto-started, render nothing. *@
@if (_skipDecision is not true)
{
<div class="gps-intro-overlay" role="dialog" aria-modal="true" aria-label="@(string.IsNullOrWhiteSpace(DialogLabel) ? "Game intro" : DialogLabel)"
     @ref="_root" tabindex="0"
     @onclick="HandleOverlayClick"
     @onkeydown="HandleKey" @onkeydown:preventDefault="CaptureKeys">
    <div class="gps-intro-card gps-intro-card--@ModeClass"
        @onclick:stopPropagation="true">
        @if (Title != null)
        {
            <div class="gps-intro-title">@Title</div>
        }

        @if (!string.IsNullOrWhiteSpace(Objective))
        {
            <p class="gps-intro-objective">@Objective</p>
        }

        @if (Controls != null)
        {
            <div class="gps-intro-controls">
                <div class="gps-intro-section-label">Controls</div>
                @Controls
            </div>
        }

        @if (Options != null)
        {
            <div class="gps-intro-options">@Options</div>
        }

        <div class="gps-intro-actions">
            @switch (Mode)
            {
                case IntroMode.Demo:
                    <div class="gps-intro-demo-hint" role="status">
                        <span class="gps-intro-spinner" aria-hidden="true"></span>
                        Demo starting…
                    </div>
                    break;

                case IntroMode.TwoPlayer:
                    @if (ShowStart)
                    {
                        <button class="gps-intro-btn gps-intro-btn--primary"
                                disabled="@(!StartEnabled)"
                                @onclick="StartAsync">
                            @(StartLabel ?? "Start")
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(StartHint))
                    {
                        <p class="gps-intro-hint">@StartHint</p>
                    }
                    break;

                default:
                    <button class="gps-intro-btn gps-intro-btn--primary"
                            @onclick="StartAsync">
                        @(StartLabel ?? "Start")
                    </button>
                    @if (_rememberSkip is not null && !_forceShow)
                    {
                        @* 2026-08-30: the tick-box is back. It was removed on 2026-08-11
                           along with the /settings toggle that was the only way back
                           from it; the removal made every 1P visit re-show the same
                           card, which repeat players read as friction (audit #5).
                           The flag is per-game localStorage, and `?intro=1` on any
                           game URL forces the card back AND hides this box — the
                           controls copy stays one query parameter away. *@
                        <label class="gps-intro-skip">
                            <input type="checkbox" checked="@_rememberSkip" @onchange="RememberSkipChanged" />
                            Don't show this again
                        </label>
                    }
                    break;
            }
        </div>
    </div>
</div>
}

@code {
    public enum IntroMode { Demo, OnePlayer, TwoPlayer }

    /// <summary>Card heading — normally the game's title fragment.</summary>
    [Parameter] public RenderFragment? Title { get; set; }

    /// <summary>One-line welcome / objective shown under the title.</summary>
    [Parameter] public string? Objective { get; set; }

    /// <summary>Controls list — pass the page's existing HowToPlay fragment.</summary>
    [Parameter] public RenderFragment? Controls { get; set; }

    /// <summary>Optional extra content for TwoPlayer mode (e.g. character select).</summary>
    [Parameter] public RenderFragment? Options { get; set; }

    [Parameter] public IntroMode Mode { get; set; } = IntroMode.OnePlayer;

    /// <summary>In TwoPlayer mode, gates the Start button (both players ready).</summary>
    [Parameter] public bool StartEnabled { get; set; } = true;

    /// <summary>Overrides the action button label ("OK" / "Start").</summary>
    [Parameter] public string? StartLabel { get; set; }

    /// <summary>
    /// TwoPlayer only: false drops the Start button, for a select whose own lock-ins start
    /// the match (PoBrawl) — there, Start was a second way in that skipped the picks.
    /// Escape still calls OnStart (a modal must never trap the keyboard).
    /// </summary>
    [Parameter] public bool ShowStart { get; set; } = true;

    /// <summary>Optional helper line under the TwoPlayer Start button.</summary>
    [Parameter] public string? StartHint { get; set; }

    /// <summary>How long the demo card flashes before auto-starting.</summary>
    [Parameter] public int DemoDelayMs { get; set; } = 2000;

    /// <summary>
    /// Optional accessible label for the modal dialog. Games can provide a
    /// mode-specific label (for example, "Brawl two-player setup") so screen-reader
    /// users get immediate context.
    /// </summary>
    [Parameter] public string? DialogLabel { get; set; }

    /// <summary>Forward keydowns to the host (TwoPlayer option selection).</summary>
    [Parameter] public bool CaptureKeys { get; set; }

    /// <summary>Fired once when the intro is dismissed and play should begin.</summary>
    [Parameter] public EventCallback OnStart { get; set; }

    /// <summary>Raw keydowns while the intro is up (used by TwoPlayer selection).</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKey { get; set; }

    /// <summary>
    /// Cue scope for the start sound — the game key ("tictactoe", "pobrawl", …).
    /// When set, the round opens in that game's own timbre; otherwise it falls
    /// back to the shared rising "ui/open". Every game passes through this
    /// component, so wiring the cue here is what makes the start sound universal
    /// instead of present only in the pages that inject the feedback service.
    /// </summary>
    [Parameter] public string? CueScope { get; set; }

    [Inject] private Services.Ui.UiFeedbackService Feedback { get; set; } = null!;

    [Inject] private IJSRuntime JS { get; set; } = null!;

    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private ElementReference _root;
    private bool _started;
    private Timer? _demoTimer;

    // ── "Don't show this again" (2026-08-30) ──────────────────────────────
    // Per-game localStorage opt-out for the OnePlayer card. null = undecided
    // (only for skip-capable modes before the storage read lands); the card
    // renders nothing while undecided so an opted-out player never sees a
    // flash-then-yank. `?intro=1` forces the card and hides the box, which is
    // the documented way back to the controls copy after opting out.
    private bool? _skipDecision;
    private bool? _rememberSkip;
    private bool _forceShow;

    private string SkipKey => $"poIntro:skip:{CueScope}";

    /// <summary>Whether this instance can persist a skip at all: 1P only, and
    /// only when the game handed us a stable key (CueScope) to store it under.</summary>
    private bool SkipCapable => Mode == IntroMode.OnePlayer && !string.IsNullOrWhiteSpace(CueScope);

    protected override async Task OnInitializedAsync()
    {
        // 2026-09-04 kiosk reel polish: when the URL carries ?kiosk=N (the "Watch
        // all demos" attract loop) we skip the intro card entirely. Every demo
        // page reads the same kiosk query param, so the first 2s × 9 games of a
        // loop used to be spent on the same dialog flashing back at the viewer.
        // Also covers repeat viewers: every loop iteration re-enters the page
        // with the kiosk param set, so the dialog stays suppressed.
        // Only applies to Demo mode — OnePlayer / TwoPlayer still want the card.
        if (Mode == IntroMode.Demo &&
            new Uri(Navigation.Uri).Query.Contains("kiosk=", StringComparison.OrdinalIgnoreCase))
        {
            _skipDecision = true;
            await StartAsync();
            return;
        }

        if (!SkipCapable)
        {
            _skipDecision = false;
            return;
        }

        try
        {
            _forceShow = new Uri(Navigation.Uri).Query.Contains("intro=1", StringComparison.OrdinalIgnoreCase);
            var skip = await JS.InvokeAsync<string?>("localStorage.getItem", SkipKey);
            if (!_forceShow && skip == "1")
            {
                _skipDecision = true;
                await StartAsync();
                return;
            }
            _rememberSkip = false;
        }
        catch
        {
            // Storage unavailable (private mode, blocked) — show the card and
            // the box; a failed write simply never persists.
            _rememberSkip = null;
        }
        _skipDecision = false;
    }

    private async Task RememberSkipChanged(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        _rememberSkip = on;
        try
        {
            if (on) await JS.InvokeVoidAsync("localStorage.setItem", SkipKey, "1");
            else await JS.InvokeVoidAsync("localStorage.removeItem", SkipKey);
        }
        catch { /* best-effort persistence — the card still works without it */ }
    }

    private string ModeClass => Mode switch
    {
        IntroMode.Demo => "demo",
        IntroMode.TwoPlayer => "twoplayer",
        _ => "oneplayer",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 2026-08-30: the per-game "Don't show this again" opt-out returned via
        // OnInitializedAsync/RememberSkipChanged — see the notes there. Unlike
        // the 2026-08-11 removal, there is no /settings page to manage it: the
        // box itself is the only switch, and `?intro=1` forces the card back.

        // Focus the overlay so Enter/Space (1P) and the per-player select keys
        // (2P) land here without the player having to click first.
        try { await _root.FocusAsync(); } catch { /* headless / detached — fine */ }

        if (Mode == IntroMode.Demo && _demoTimer is null)
        {
            _demoTimer = new Timer(async _ => await InvokeAsync(StartAsync),
                null, DemoDelayMs, Timeout.Infinite);
        }
    }

    private async Task StartAsync()
    {
        if (_started) return;
        if (Mode == IntroMode.TwoPlayer && !StartEnabled) return;
        _started = true;
        _demoTimer?.Dispose();
        _demoTimer = null;

        // Demo starts on a timer, not a gesture. Playing a sound there would be
        // audio the player never asked for, and on mobile the AudioContext is
        // still locked anyway (no gesture has happened), so it would be a no-op
        // that only looks like it works on desktop.
        if (Mode != IntroMode.Demo)
        {
            await Feedback.GameStartAsync(CueScope);
        }

        if (OnStart.HasDelegate) await OnStart.InvokeAsync();
    }

    /// <summary>
    /// Tap-on-backdrop dismissal for the informational cards (audit #6). The
    /// CARD stops propagation in every mode — it carries interactive controls
    /// in some games (TwoPlayer's character select, PoBrawl's Training-first
    /// checkbox) that a stray tap must not dismiss past — so the dismiss
    /// surface is the screen outside the card, plus Escape/Enter.
    /// </summary>
    private async Task HandleOverlayClick()
    {
        if (Mode == IntroMode.TwoPlayer) return;
        await StartAsync();
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (Mode == IntroMode.TwoPlayer)
        {
            // Escape is the one key the 2P card handles itself: this is a
            // role="dialog" aria-modal="true", and a modal that ignores Escape
            // is a keyboard trap. It still respects StartEnabled, so it cannot
            // start a match before both players have picked (audit #4).
            if (e.Key == "Escape")
            {
                await StartAsync();
                return;
            }

            if (OnKey.HasDelegate) await OnKey.InvokeAsync(e);
            return;
        }

        // 1P: keyboard players can dismiss without reaching for the mouse.
        // Escape included — see above.
        if (e.Key is "Enter" or " " or "Spacebar" or "Escape")
        {
            await StartAsync();
        }
    }

    public void Dispose()
    {
        _demoTimer?.Dispose();
        _demoTimer = null;
    }
}

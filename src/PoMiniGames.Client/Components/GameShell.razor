@namespace PoMiniGamesClient.Components
@implements IDisposable
@* §6 Wrap the whole shell in a SwipeBack so every game gets a leftward
   swipe-back gesture without each game page having to wire it. *@

@* §11 Consolidated header: the game's status + settings are projected into the
   app top bar (see MainLayout's SectionOutlet), removing the separate second
   row. The back-arrow and title are intentionally dropped — the top bar's brand
   already covers navigation back to the home page; the swipe-back gesture below
   still works. *@
<SectionContent SectionName="game-header">
    <div class="gps-header-slot">
        @* Game title — always rendered as the first child of the chrome slot so
           every game page identifies itself in the top bar. Renders as an
           <h1> (audit #7) so screen readers see a heading hierarchy, not a
           styled <span>. The page's `Title` fragment may compose an icon + name.
           The H1 inherits the same --font-display / 0.95rem styling as the
           span used to, with browser-default margins stripped. *@
        @if (Title != null)
        {
            <h1 class="gps-game-title">@Title</h1>
        }

        @* The "← All games" / "← Game hub" pill was removed on 2026-08-10 (user
           request). It was the third navigate-away control in a header that also
           carried the brand wordmark and the 🎮 Games switcher (itself now gone),
           and it competed for width with the game title on a phone. Leaving a game
           is still one tap on the brand, plus the swipe-back gesture below.

           `BackTo` is NOT dead — it still drives SwipeBack and the Home button on
           <GameOverModal>, which is why it stays a parameter. *@

        @* Live rating badge for single-player, ELO-rated modes: the page passes
           its current rating via Elo and it renders next to the signed-in
           identity (see MainLayout's "game-elo" outlet), so the player can see
           their standing throughout the match. Left null in 2-player / demo /
           unrated modes, which emits nothing. *@

        @* 2026-07-13 top-bar cleanup (user request): the in-game Player name, the
           live Status pill, and the "?" how-to trigger were removed from the
           header to save horizontal space. The signed-in identity now lives once
           on the right (next to Sign out) and the game result surfaces in the
           end-of-game modal.

           The `Status` and `HowToPlay` parameters that survived that cleanup have
           now been removed as well. Nothing rendered them and nothing could: the
           "?" trigger was the only thing that ever set HowToPlayOpen, so once it
           went the popover became unreachable markup behind a permanently-false
           flag, while every game page kept building a Status fragment on each
           render for output that was discarded.

           Controls text is not lost. Pages feed the same HowToPlayContent
           fragment to <GameIntro Controls="…">, which is the live surface for it
           and is what players actually see before a round starts.

           `Player` is NOT dead and stays — it is forwarded to GameOverModal
           below, which uses it to attribute the score. *@
    </div>
</SectionContent>

@if (Elo is int elo)
{
    <SectionContent SectionName="game-elo">
        <span class="gps-elo-badge" title="Your current ELO rating">ELO @elo</span>
    </SectionContent>
}

<SwipeBack BackTo="@BackTo" Class="gps-shell-wrap">
<div class="gps-shell">
    @* 2026-08-07 browser audit #6: every game's state lived only in pixels — on a
       canvas, or in DOM that changes without announcing itself — so a screen
       reader user got no turn, score or result. This is the one polite live
       region every game shares; a page opts in by passing `Announcement`, and
       whatever it sets is read out on change. Visually hidden (`.gps-sr-only`),
       never a layout concern. Kept OUTSIDE `.gps-game-area` so a game that
       replaces its whole area (fullscreen renderers) can't tear the region out
       of the DOM — a live region that gets removed and re-added is not announced. *@
    <div class="gps-sr-only" role="status" aria-live="polite" aria-atomic="true">@Announcement</div>

    <div class="gps-game-area @(Fullscreen ? "gps-game-area--fullscreen" : "")">
        @* Games that cannot render without WebGL get an explanation instead of a
           crash (browser audit #5). ChildContent is not rendered at all, so the
           engine's container never exists and its `init` bails on "container not
           found" rather than throwing from inside three.js.

           Browser audit #7 (2026-08-10): the only escape was "← Back to all games",
           which dropped the player on the catalog grid and made them re-pick a
           game — fine for a desktop, but a phone user who came here from a deep
           link had to back up twice to find a non-WebGL game. Surface the two
           2D classics right in the alert so the player never has to make a
           second choice. *@
        @if (RequiresWebGl && _webGlChecked && !_webGlAvailable)
        {
            <div class="gps-nogl" role="alert">
                <div class="gps-nogl-icon" aria-hidden="true">🎮</div>
                <h2 class="gps-nogl-title">This game needs 3D graphics</h2>
                <p class="gps-nogl-body">
                    Your browser could not start WebGL, which this game renders with.
                    Turning on hardware acceleration in your browser settings usually
                    fixes it — or try a different browser or device.
                </p>
                <div class="gps-nogl-actions">
                    <a class="gps-nogl-link" href="/">← Back to all games</a>
                    <span class="gps-nogl-or">or play a 2D game now:</span>
                    <a class="gps-nogl-link gps-nogl-link--chip" href="/tictactoe/1player">❌ Tic-Tac-Toe</a>
                    <a class="gps-nogl-link gps-nogl-link--chip" href="/connectfive/1player">🔴 Connect Five</a>
                </div>
            </div>
        }
        else
        {
            @ChildContent
        }
    </div>

    @* End-of-game modal: the one centered, blocking dialog every game ends on.
       It surfaces the final result (GameSummary), the stats grid (Stats), this
       game's top 3 (fetched from GameKey), and a single button that returns to the
       home menu. There is intentionally no backdrop-dismiss and no Play Again —
       that button is the only exit, so the flow is identical in every game.

       2026-08-11: GameOverDelayMs lets a game wait a few seconds after the
       result is decided before the modal appears, so the winning move can
       flash / highlight on the board. The win-cascade animation finishes
       well inside the default 5s window; games that don't care (or want
       immediate feedback) pass 0. *@
    @if (GameOver && _showGameOver)
    {
        <GameOverModal Title="@Title"
                       GameSummary="@GameSummary"
                       Stats="@Stats"
                       GameKey="@GameKey"
                       Player="@Player"
                       Outcome="@Outcome"
                       BackTo="@BackTo" />
    }
</div>
</SwipeBack>

@code {
    [Parameter] public RenderFragment? Title { get; set; }
    // Display name credited on the end-of-game modal's leaderboard submission.
    // Passed straight through to GameOverModal — this shell renders it nowhere
    // itself, which is why it looks unused at a glance.
    [Parameter] public string? Player { get; set; }
    // Current ELO for single-player, rated modes. When set, it renders as a
    // small badge beside the signed-in identity in the top bar (via the
    // "game-elo" section outlet in MainLayout). Leave null for 2-player, demo
    // and other unrated modes — nothing is projected.
    [Parameter] public int? Elo { get; set; }
    [Parameter] public List<Models.StatItem>? Stats { get; set; }
    [Parameter] public bool Fullscreen { get; set; }
    // Where the Home button on the end-of-game modal navigates. Default is the
    // home page ("/") — pages only need to override when they sit under a
    // sub-lobby (e.g. PoCoupleQuiz lobby → "/couplequiz"). This makes every
    // game page identical on this dimension by default.
    [Parameter] public string BackTo { get; set; } = "/";
    [Parameter] public bool GameOver { get; set; }
    /// <summary>
    /// 2026-08-11: milliseconds to wait after <see cref="GameOver"/> flips to
    /// true before the modal actually renders. Gives the board's win-cascade
    /// / highlight animation time to finish before the modal covers it.
    /// Default is 0 (no delay); Connect Five passes 5000.
    /// </summary>
    [Parameter] public int GameOverDelayMs { get; set; } = 0;
    // Catalog key for this game's unified leaderboard (e.g. "connectfive").
    // When set, the end-of-game modal fetches and renders that game's top 3.
    // Leave null for modes with no meaningful board (local 2-player, demo).
    [Parameter] public string? GameKey { get; set; }
    // How the match ended, forwarded to GameOverModal so the closing cue matches
    // the result. Left Unknown by games that do not report it, which sounds a
    // neutral round-over instead of guessing.
    [Parameter] public Models.GameResult Outcome { get; set; } = Models.GameResult.InProgress;
    [Parameter] public RenderFragment? GameSummary { get; set; }

    /// <summary>
    /// Sentence read aloud by the shared polite live region whenever it changes —
    /// whose turn it is, the score, how the round ended. Plain prose, not a label:
    /// it is spoken, so "Your turn" beats "TURN: X". Leave null in modes with
    /// nothing meaningful to announce (demos nobody is driving); an unset value
    /// renders an empty region, which is silent.
    /// </summary>
    [Parameter] public string? Announcement { get; set; }

    /// <summary>
    /// Set by games whose renderer is three.js and therefore cannot run at all
    /// without a WebGL context (PoBrawl, PoMarbleRace, PoRacer). Leave false for
    /// games that only use GL as an enhancement over a working DOM/2D board —
    /// TicTacToe and ConnectFive both degrade cleanly on their own and must keep
    /// rendering here.
    /// </summary>
    [Parameter] public bool RequiresWebGl { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; } = null!;

    [Inject] private IJSRuntime JS { get; set; } = null!;

    private bool _webGlChecked;
    private bool _webGlAvailable = true;

    // Probed once, after the first render (JS interop is not available before
    // it). Defaults to "available" so the game renders normally on the first
    // pass and in any host where interop fails — the fallback notice is for a
    // confirmed negative, never for an inconclusive probe.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RequiresWebGl || _webGlChecked) return;

        try
        {
            _webGlAvailable = await JS.InvokeAsync<bool>("isWebGlAvailable");
        }
        catch
        {
            _webGlAvailable = true;
        }

        _webGlChecked = true;
        StateHasChanged();
    }

    // The top-3 fetch and the OK action live in GameOverModal — this shell just
    // decides when to show it and passes the game's data through.

    // 2026-08-11: GameOverDelayMs support. _showGameOver is the gated view of
    // GameOver; the modal only mounts once it's true AND the delay has elapsed.
    // A CancellationToken cancels any in-flight delay when the page tears down
    // (mode change, navigation) so we don't show a stale modal.
    private bool _showGameOver;
    private CancellationTokenSource? _gameOverCts;

    protected override void OnParametersSet()
    {
        if (GameOver && !_showGameOver && _gameOverCts is null)
        {
            if (GameOverDelayMs <= 0)
            {
                _showGameOver = true;
                return;
            }

            _gameOverCts = new CancellationTokenSource();
            _ = DelayThenShowAsync(_gameOverCts.Token);
        }
        else if (!GameOver)
        {
            // Result was reset (Play Again, navigate away) — drop the modal, and cancel a
            // delay still in flight: left running it set _showGameOver after the reset, so the
            // NEXT result's modal skipped its delay and covered that game's KO/win beat.
            _showGameOver = false;
            _gameOverCts?.Cancel();
            _gameOverCts?.Dispose();
            _gameOverCts = null;
        }
    }

    private async Task DelayThenShowAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(GameOverDelayMs, ct);
            if (!ct.IsCancellationRequested)
            {
                _showGameOver = true;
                _gameOverCts?.Dispose();
                _gameOverCts = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* normal on tear-down / reset */ }
    }

    public void Dispose()
    {
        _gameOverCts?.Cancel();
        _gameOverCts?.Dispose();
    }
}

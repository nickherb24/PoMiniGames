@namespace PoMiniGamesClient.Components
@inject NavigationManager Nav
@inject OnlineStatusService Online

@* The one mode switch: 1P / 2P / Online / Demo for whichever game the address is on,
   read from GameCatalog so a mode the game declares cannot go missing from it.

   Changing mode never means going back to the hub. GameIntro renders this on every
   game's opening card; the games with a start card of their own place it there.

   Buttons, not links: app.js turns every in-app <a> click into a full page load. *@
@if (_game is { Modes.Count: > 1 } game)
{
    <div class="app-seg" role="tablist" aria-label="Mode">
        @foreach (var m in game.Modes)
        {
            <button type="button" role="tab" class="app-seg__btn"
                    aria-selected="@(m.Mode == _current ? "true" : "false")"
                    disabled="@(m.RequiresNetwork && !Online.IsOnline)"
                    title="@(m.RequiresNetwork && !Online.IsOnline ? "Needs a connection — unavailable offline" : GameModes.ToDescription(m.Mode))"
                    @onclick="() => SelectAsync(m)">@GameModes.ToLabel(m.Mode)</button>
        }
    </div>
}

@code {
    /// <summary>
    /// The mode to show as selected, for a page whose mode is not in its address
    /// (Voxel Strike's start card switches Solo and Online in place). Null reads the address.
    /// </summary>
    [Parameter] public GameMode? Current { get; set; }

    /// <summary>When set, the page makes the switch itself and nothing navigates.</summary>
    [Parameter] public EventCallback<GameMode> OnSelect { get; set; }

    /// <summary>
    /// False for a page that hosts every mode of its game and follows the address in place
    /// (Racer). True, the default, loads the target the way a hub chip does.
    /// </summary>
    [Parameter] public bool Reload { get; set; } = true;

    private CatalogGame? _game;
    private GameMode _current;

    // What may follow the game in an address that is one of its modes: the four slugs.
    private static readonly string[] ModeSegments =
        [GameModes.OnePlayerSlug, GameModes.TwoPlayerSlug, GameModes.MultiplayerSlug, GameModes.DemoSlug];

    protected override void OnParametersSet()
    {
        var uri = new Uri(Nav.Uri);
        var segments = uri.AbsolutePath.Trim('/').Split('/');

        // Only on a mode's own address (/game or /game/{mode}). A deeper one is a match in
        // progress (/posports/race/{code}), where Parse would call it "1P" and a switch
        // would be a way to walk out of the race.
        if (segments.Length > 2
            || (segments.Length == 2 && !ModeSegments.Contains(segments[1], StringComparer.OrdinalIgnoreCase)))
        {
            _game = null;
            return;
        }

        var root = "/" + segments[0];
        _game = GameCatalog.All.FirstOrDefault(g => g.Modes.Any(m =>
            m.Url.StartsWith(root, StringComparison.OrdinalIgnoreCase)
            && (m.Url.Length == root.Length || m.Url[root.Length] is '/' or '?')));
        _current = Current ?? GameModes.Parse(segments.ElementAtOrDefault(1));
    }

    private async Task SelectAsync(CatalogMode mode)
    {
        if (mode.Mode == _current) return;
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(mode.Mode);
            return;
        }

        // ponytail: a full load by default, the same thing a hub chip does. Most game pages
        // read their mode once, on first mount, so an in-place navigation would leave them
        // in the old one. A page that follows the address (Racer) passes Reload="false";
        // teach the others to and this default can flip.
        Nav.NavigateTo(mode.Url, forceLoad: Reload);
    }
}

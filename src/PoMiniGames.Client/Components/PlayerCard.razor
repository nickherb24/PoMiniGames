@namespace PoMiniGamesClient.Components
@using Microsoft.JSInterop
@using PoMiniGames.Domain.Models
@using PoMiniGamesClient.Services.Http
@using PoMiniGamesClient.Services.Ui
@inject ApiService ApiService
@inject ToastService Toasts
@inject IJSRuntime JS

@if (_loading)
{
    <div class="player-card-skel" role="status" aria-label="Loading competitive card">
        <div class="card-skel-line card-skel-title"></div>
        <div class="card-skel-row"></div>
    </div>
}
else if (Card is not null)
{
    <div class="player-card fx-holo-card" data-fx-holo="14" style="--tier-color: @Card.TierColorHex">
        <div class="card-header">
            <div class="card-brand">
                <span class="brand-title">POMINIGAMES · COMPETITIVE LICENSE</span>
            </div>
            <div class="card-badge @(IsVerified ? "badge-verified" : "badge-guest")">
                <span class="badge-dot"></span>
                <span class="badge-text">@(IsVerified ? "VERIFIED MS" : "GUEST")</span>
            </div>
        </div>

        <div class="card-main">
            <div class="driver-info">
                <div class="avatar-ring" aria-hidden="true">
                    <span class="avatar-text">@Card.Initials</span>
                </div>
                <div class="driver-details">
                    <div class="driver-name" title="@Card.DisplayName">@Card.DisplayName</div>
                    @* A signature game is the one played most. With no games there is none,
                       and the server's default ("PoRacer Main") was shown to a player who
                       had never raced. *@
                    @if (Ranked)
                    {
                        <div class="sig-pill" title="Signature game">
                            <span class="sig-icon">@Card.SignatureGameIcon</span>
                            <span class="sig-name">@Card.SignatureGameTitle Main</span>
                        </div>
                    }
                </div>
            </div>

            <div class="tier-rating-panel">
                <div class="tier-badge-pill">
                    @if (Ranked)
                    {
                        <span class="tier-icon">@Card.TierIcon</span>
                    }
                    <span class="tier-name">@(Ranked ? $"{Card.TierName.ToUpperInvariant()} TIER" : "UNRANKED")</span>
                </div>
                <div class="mmr-display">
                    <span class="mmr-val">@Card.Mmr.ToString("N0")</span>
                    <span class="mmr-lbl">MMR</span>
                </div>
                @if (Ranked)
                {
                    <div class="progress-bar-container" title="@($"{Card.TierProgress:P0} to {Card.NextTierName}")">
                        <div class="progress-bar-fill" style="width: @($"{Math.Clamp(Card.TierProgress * 100, 4, 100):0}%")"></div>
                    </div>
                }
                <div class="progress-bar-sub">
                    @if (!Ranked)
                    {
                        <span>Starting rating. Play an online match to earn a tier.</span>
                    }
                    else if (!string.IsNullOrEmpty(Card.NextTierName))
                    {
                        <span>@($"{Card.TierProgress:P0} to {Card.NextTierName} ({Card.NextTierMinMmr:N0} MMR)")</span>
                    }
                    else
                    {
                        <span>Max Rank Achieved</span>
                    }
                </div>
            </div>
        </div>

        <div class="card-stats-grid">
            <div class="stat-col">
                @* "Online": the page under this card has a Win Rate of its own, for
                   1-player matches, and the two read 0% and a dash side by side. *@
                <span class="stat-label">ONLINE WIN RATE</span>
                <span class="stat-value val-emerald">@(Ranked ? Card.WinRate.ToString("P0") : "—")</span>
            </div>
            <div class="stat-col">
                <span class="stat-label">ONLINE RECORD</span>
                <span class="stat-value">@Card.Wins W · @Card.Losses L · @Card.Draws D</span>
            </div>
            <div class="stat-col">
                <span class="stat-label">PEAK MMR</span>
                <span class="stat-value val-tier">@Card.PeakMmr.ToString("N0")</span>
            </div>
            <div class="stat-col">
                <span class="stat-label">CURRENT STREAK</span>
                <span class="stat-value val-streak">
                    @(Card.CurrentStreak switch {
                        > 0 => $"+{Card.CurrentStreak} W",
                        < 0 => $"{Card.CurrentStreak} L",
                        _ => "—"
                    })
                </span>
            </div>
        </div>

        <div class="card-footer">
            <div class="recent-form">
                <span class="form-label">RECENT FORM</span>
                @if (Card.RecentForm.Count == 0)
                {
                    <span class="form-empty">No ranked games yet</span>
                }
                else
                {
                    <div class="form-dots">
                        @foreach (var outcome in Card.RecentForm)
                        {
                            <span class="form-dot dot-@outcome.ToLowerInvariant()" title="@outcome">
                                @(outcome.Equals("win", StringComparison.OrdinalIgnoreCase) ? "W" :
                                  outcome.Equals("loss", StringComparison.OrdinalIgnoreCase) ? "L" : "D")
                            </span>
                        }
                    </div>
                }
            </div>

            @if (AllowExport)
            {
                <div class="card-actions">
                    <button type="button" class="app-btn app-btn--secondary app-btn--sm" @onclick="CopySvgAsync" title="Copy standalone vector SVG to clipboard">
                        <span>📋</span>
                        <span>@(_copying ? "Copied!" : "Copy SVG")</span>
                    </button>
                    <button type="button" class="app-btn app-btn--secondary app-btn--sm" @onclick="DownloadSvgAsync" title="Download SVG image file">
                        <span>💾</span>
                        <span>Download SVG</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? PlayerName { get; set; }
    [Parameter] public PlayerCardDto? Card { get; set; }
    [Parameter] public bool AllowExport { get; set; } = true;

    private bool _loading;
    private bool _copying;

    // No ranked game on record: the card's numbers are the starting values, not a result.
    private bool Ranked => Card is not null && Card.Wins + Card.Losses + Card.Draws > 0;

    // A dev-login guest holds a real session, so the server's card calls it "microsoft".
    // The minted "Guest-NNNNNN" handle is how the client tells them apart everywhere else
    // (the profile, the data card), and a guest badged VERIFIED MS is simply wrong.
    private bool IsVerified =>
        Card is { AccountKind: "microsoft" } && !Card.DisplayName.StartsWith("Guest", StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        if (Card is null)
        {
            _loading = true;
            Card = await ApiService.GetPlayerCardAsync(PlayerName);
            _loading = false;
        }
    }

    private async Task CopySvgAsync()
    {
        _copying = true;
        try
        {
            var svg = await ApiService.GetPlayerCardSvgAsync(PlayerName);
            if (!string.IsNullOrEmpty(svg))
            {
                try
                {
                    await JS.InvokeVoidAsync("navigator.clipboard.writeText", svg);
                }
                catch
                {
                    await JS.InvokeVoidAsync("poCopyToClipboard", svg);
                }
                Toasts.Show("Player Card SVG copied to clipboard!", ToastType.Success);
            }
            else
            {
                Toasts.Show("Could not load SVG for clipboard.", ToastType.Warning);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Copy failed: {ex.Message}", ToastType.Error);
        }
        finally
        {
            await Task.Delay(1200);
            _copying = false;
            StateHasChanged();
        }
    }

    private async Task DownloadSvgAsync()
    {
        try
        {
            var svg = await ApiService.GetPlayerCardSvgAsync(PlayerName);
            if (!string.IsNullOrEmpty(svg))
            {
                var filename = $"playercard-{(string.IsNullOrWhiteSpace(PlayerName) ? "license" : PlayerName.ToLowerInvariant())}.svg";
                await JS.InvokeVoidAsync("poDownloadTextFile", filename, "image/svg+xml", svg);
                Toasts.Show("Player card downloaded!", ToastType.Success);
            }
        }
        catch
        {
            Toasts.Show("Download failed.", ToastType.Error);
        }
    }
}


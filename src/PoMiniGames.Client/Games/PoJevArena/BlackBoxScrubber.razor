@using System.Globalization

@* The post-match forensic transport. Frame-accurate: the slider is the recorded 60 Hz frame index,
   ticks under it mark every knockout (team colour) and the debrief's key moments (★), and the
   decision jumps land on the frames where Jev's answers arrived. Keyboard (handled by the engine
   while the arena is mounted): Space play/pause, ←/→ one frame (Shift: one second), Home/End. *@
<section class="jev-blackbox" aria-label="Black Box">
    <div class="jev-blackbox__transport">
        <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" aria-label="Previous Jev decision" @onclick='() => Command("prevDecision")'>⏮</button>
        <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" aria-label="Back one frame" @onclick='() => Command("step", -1)'>◀</button>
        <button type="button" class="jev-btn jev-btn--sm jev-blackbox__play" @onclick='() => Command(State?.Playing == true ? "pause" : "play")'>@(State?.Playing == true ? "Pause" : "Play")</button>
        <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" aria-label="Forward one frame" @onclick='() => Command("step", 1)'>▶</button>
        <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" aria-label="Next Jev decision" @onclick='() => Command("nextDecision")'>⏭</button>
        <button type="button" class="jev-btn jev-btn--ghost jev-btn--sm" aria-label="@($"Playback speed {Speed}×, change")" @onclick="CycleSpeed">@(Speed)×</button>
        <span class="jev-blackbox__clock" title="@FrameTitle">@Clock</span>
    </div>

    <div class="jev-blackbox__track">
        <label class="jev-visually-hidden" for="jev-bb-slider">Timeline</label>
        <input id="jev-bb-slider" class="jev-blackbox__slider" type="range" min="0" max="@Last"
               value="@(State?.Frame ?? 0)" @oninput='e => Command("scrub", double.Parse(e.Value?.ToString() ?? "0", CultureInfo.InvariantCulture))' />
        <div class="jev-blackbox__marks" aria-hidden="true">
            @foreach (var ko in Kos)
            {
                <span class="jev-mark jev-mark--@ko.Team" style="--at: @At(ko.Frame)%"></span>
            }
            @foreach (var m in Moments)
            {
                <span class="jev-mark jev-mark--moment" style="--at: @At(m.Frame)%" title="@m.Kind">★</span>
            }
        </div>
    </div>
</section>

@code {
    private static readonly double[] Speeds = [0.25, 0.5, 1, 2, 4];

    [Parameter] public ArenaBlackBoxView? State { get; set; }
    [Parameter] public IReadOnlyList<ArenaKo> Kos { get; set; } = [];
    [Parameter] public IEnumerable<ArenaMoment> Moments { get; set; } = [];
    [Parameter] public EventCallback<(string Command, double Value)> OnCommand { get; set; }

    private int Last => Math.Max(0, (State?.Frames ?? 1) - 1);
    private string Speed => (State?.Speed ?? 1).ToString(CultureInfo.InvariantCulture);
    private string At(int frame) => (Last == 0 ? 0 : 100.0 * frame / Last).ToString("0.##", CultureInfo.InvariantCulture);

    private string Clock
    {
        get
        {
            if (State is null) return "—";
            var now = TimeSpan.FromSeconds(State.Seconds);
            var end = TimeSpan.FromSeconds(Last / 60.0);
            return string.Create(CultureInfo.InvariantCulture, $"{now:m\\:ss\\.f} / {end:m\\:ss}");
        }
    }

    private string FrameTitle => State is null ? "" : $"Frame {State.Frame} of {Last}";

    private Task CycleSpeed()
    {
        var at = Array.IndexOf(Speeds, State?.Speed ?? 1);
        return Command("speed", Speeds[(at + 1) % Speeds.Length]);
    }

    private Task Command(string command, double value = 0) => OnCommand.InvokeAsync((command, value));
}

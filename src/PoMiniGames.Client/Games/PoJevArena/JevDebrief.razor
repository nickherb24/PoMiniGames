@using System.Globalization

@* End-of-match "what was each team thinking": one card per side, in plain sentences first and
   numbers second, with jump links into the Black Box for the moments worth rewatching. Built
   from the Black Box decision log (debrief.js), so it costs no extra Jev calls. *@
<section class="jev-debrief" aria-label="Jev debrief">
    <h2 class="jev-kicker">Jev debrief: what each team was thinking</h2>
    <div class="jev-debrief__teams">
        @foreach (var (team, t) in Teams)
        {
            var name = team == "blue" ? (IsTwoPlayer ? "Player 1 · Blue" : "Blue") : (IsTwoPlayer ? "Player 2 · Red" : "Red");
            <article class="jev-debrief__card jev-debrief__card--@team">
                <header class="jev-debrief__head">
                    <h3>@name</h3>
                    <span class="jev-chip jev-chip--@team">@Outcome(team)</span>
                </header>

                @if (t.Decisions == 0)
                {
                    <p class="jev-muted">Jev made no decisions for this team.</p>
                }
                else
                {
                    <ul class="jev-debrief__story">
                        <li>@Style(name, t)</li>
                        @if (Targeting(t) is { } targeting)
                        {
                            <li>@targeting</li>
                        }
                        <li>@Certainty(t)</li>
                        <li>@Morale(t)</li>
                        @if (t.Failures > 0)
                        {
                            <li>@t.Failures Jev call@(t.Failures == 1 ? "" : "s") failed; those creatures kept acting on their last orders.</li>
                        }
                    </ul>

                    <h4 class="jev-kicker">Choices</h4>
                    <div class="jev-debrief__bars">
                        @foreach (var a in t.Actions.Take(6))
                        {
                            <div class="jev-dist__row">
                                <span class="jev-dist__label">@Pretty(a.Key)</span>
                                <span class="jev-dist__bar" aria-hidden="true"><span style="--pct: @Pct(a.Share)%"></span></span>
                                <span class="jev-dist__value">@Pct(a.Share)%</span>
                            </div>
                        }
                    </div>

                    @if (t.Moments.Length > 0)
                    {
                        <h4 class="jev-kicker">Moments</h4>
                        <ul class="jev-debrief__moments">
                            @foreach (var m in t.Moments)
                            {
                                <li>
                                    <span>@MomentText(m)</span>
                                    <button type="button" class="jev-link" @onclick="() => OnJump.InvokeAsync(m)"
                                            aria-label="@($"Show {m.Unit} at {Clock(m.Frame)} in the Black Box")">Jump</button>
                                </li>
                            }
                        </ul>
                    }

                    <p class="jev-muted jev-small">@t.Decisions decisions · average Jev response @t.AverageLatencyMs ms</p>
                }
            </article>
        }
    </div>

    @if (Debrief.Units is { Length: > 0 } units)
    {
        <UnitStories Units="units" Frames="Frames" OnJump="OnJump" />
    }
</section>

@code {
    [Parameter, EditorRequired] public ArenaDebrief Debrief { get; set; } = default!;
    [Parameter] public string Winner { get; set; } = "draw";
    [Parameter] public bool IsTwoPlayer { get; set; }

    /// <summary>Match length in Black Box frames: the stories' shared time axis.</summary>
    [Parameter] public int Frames { get; set; }
    [Parameter] public EventCallback<ArenaMoment> OnJump { get; set; }

    private static readonly HashSet<string> Aggressive = ["melee_charge", "kite_and_shoot", "lob_boulder"];
    private static readonly HashSet<string> Defensive = ["shield_brace", "shell_up", "fall_back", "dodge_dash", "take_cover"];
    private static readonly HashSet<string> Supportive = ["mend_ally", "peel_to_ally"];

    private IEnumerable<(string Team, ArenaTeamDebrief Summary)> Teams => [("blue", Debrief.Blue), ("red", Debrief.Red)];

    private string Outcome(string team) => Winner == "draw" ? "Draw" : Winner == team ? "Won" : "Lost";

    private static string Style(string team, ArenaTeamDebrief t)
    {
        double Share(HashSet<string> set) => t.Actions.Where(a => set.Contains(a.Key)).Sum(a => a.Share);
        var (aggressive, defensive, supportive) = (Share(Aggressive), Share(Defensive), Share(Supportive));
        // The style names the family of calls that dominated, and says how much — so a team whose
        // single most common pick was a defensive one can still honestly read as aggressive.
        var (style, basis) = supportive >= 0.3 && supportive >= aggressive && supportive >= defensive
                ? ("as a support team", $"{Pct(supportive)}% of calls healed or covered allies")
            : defensive > aggressive
                ? ("defensively", $"{Pct(defensive)}% of calls were blocks, shells, dodges, cover or retreats")
                : ("aggressively", $"{Pct(aggressive)}% of calls were attacks");

        var top = t.Actions.ElementAtOrDefault(0);
        var next = t.Actions.ElementAtOrDefault(1);
        var picks = top is null ? "" : $" Top picks: {Pretty(top.Key)} {Pct(top.Share)}%"
            + (next is null ? "" : $", {Pretty(next.Key)} {Pct(next.Share)}%") + ".";
        return $"{team} played {style}: {basis}.{picks}";
    }

    private static string? Targeting(ArenaTeamDebrief t)
    {
        var top = t.Foci.ElementAtOrDefault(0);
        if (top is null) return null;
        var what = top.Key switch
        {
            "nearest_threat" => "went for whoever was closest",
            "weakest_target" => "hunted the wounded",
            "strongest_threat" => "took on the biggest threat",
            "ranged_threat" => "chased down the shooters",
            "protect_ally" => "stuck close to protect its allies",
            _ => $"focused on {Pretty(top.Key)}",
        };
        return top.Share >= 0.5
            ? $"It mostly {what} ({Pct(top.Share)}% of target calls)."
            : $"Its most common target call: it {what} ({Pct(top.Share)}%, with no single habit dominating).";
    }

    private static string Certainty(ArenaTeamDebrief t)
    {
        // The average alone flatters a team whose calls split between sure and torn, so a large
        // coin-flip share overrides it.
        var flipShare = t.Decisions == 0 ? 0 : (double)t.CoinFlips / t.Decisions;
        var mood = flipShare >= 0.3 ? $"Jev was often torn ({Pct(flipShare)}% of calls were coin-flips)"
            : t.AverageConfidence >= 0.7 ? "Jev was decisive"
            : t.AverageConfidence >= 0.5 ? "Jev was fairly sure of itself"
            : "Jev was often torn";
        var flips = t.CoinFlips == 0 ? "no coin-flip calls" : $"{t.CoinFlips} coin-flip call{(t.CoinFlips == 1 ? "" : "s")} under 0.40";
        return $"{mood} (average confidence {F(t.AverageConfidence)}, {flips}).";
    }

    private static string Morale(ArenaTeamDebrief t) => t.PanickedUnits == 0
        ? $"Nobody broke (peak panic reading {F(t.PeakPanic)})."
        : $"{t.PanickedUnits} creature{(t.PanickedUnits == 1 ? "" : "s")} panicked at some point (peak panic {F(t.PeakPanic)}).";

    private static string MomentText(ArenaMoment m) => m.Kind switch
    {
        "surest" => $"Most confident call: {m.Unit} {m.Name} chose {Pretty(m.Action)} ({F(m.Confidence)}) at {Clock(m.Frame)}.",
        "torn" => $"Closest call: {m.Unit} {m.Name} picked {Pretty(m.Action)} over {Pretty(m.RunnerUp)} ({F(m.RunnerUpProbability)}) at {Clock(m.Frame)}.",
        "first-panic" => $"First panic: {m.Unit} {m.Name} broke (panic {F(m.Panic)}) at {Clock(m.Frame)}.",
        _ => $"{m.Unit} {m.Name} at {Clock(m.Frame)}.",
    };

    private static string Pretty(string? action) => action?.Replace('_', ' ') ?? "—";
    private static string Pct(double share) => (share * 100).ToString("0", CultureInfo.InvariantCulture);
    private static string F(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string Clock(int frame) => TimeSpan.FromSeconds(frame / 60.0).ToString(@"m\:ss", CultureInfo.InvariantCulture);
}

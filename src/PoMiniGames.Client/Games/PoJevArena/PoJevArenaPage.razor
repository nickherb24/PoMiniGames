@page "/pojevarena"
@page "/pojevarena/{ModeSegment}"
@using PoMiniGames.Shared.Games.PoJevArena

<PageTitle>Jev Arena · PoMiniGames</PageTitle>

@* The match ends on the shared end-of-game modal: the result, the MVP, and one
   button back to the hub. "Review the match" steps past it to the debrief and the Black Box,
   which are things to do with a result rather than ways out; their bar has a way back here.
   A demo has nobody to press the button, so it keeps its own loop. No GameKey: there is no
   Jev Arena board for the modal to read (the key that used to sit here 404ed once the modal
   could actually open). *@
<GameShell Title="@TitleContent" Player="@_playerName" BackTo="/" Fullscreen="true"
           GameOver="@(_phase == Phase.Replay && _result is not null && !IsDemo && !_reviewing)"
           GameSummary="@GameSummaryContent">
    @if (_phase == Phase.Intro)
    {
        <GameIntro CueScope="pojevarena"
                   Title="@TitleContent"
                   Objective="@IntroObjective"
                   Controls="@HowToPlay"
                   Mode="@IntroMode"
                   StartLabel="@(IsDemo ? "Watch" : "Start drafting")"
                   OnStart="StartAsync" />
    }
    else
    {
        <div class="jev-root" data-phase="@_phase.ToString().ToLowerInvariant()" data-stats="@(_statsOpen ? "on" : "off")">
            @* One bar for the whole page: the Jev chip (what it says follows the phase) and, while
               drafting, the one primary action. The score lives on the arena's glass HUD. *@
            <header class="jev-topbar">
                <span class="jev-status @(Configured ? "is-ok" : "is-off")" role="status">@StatusText</span>
                @if (Drafting)
                {
                    @if (DeployNote is not null)
                    {
                        <span class="jev-muted jev-small">@DeployNote</span>
                    }
                    <button type="button" class="jev-btn jev-btn--big jev-topbar__deploy" disabled="@(!CanDeploy)" title="@DeployHint" @onclick="DeployAsync">
                        @(_deploying ? "Deploying…" : "Deploy battle")
                    </button>
                }
            </header>

            @if (Banner is not null)
            {
                <div class="jev-banner" role="alert">@Banner</div>
            }

            @if (_phase == Phase.Replay && _result is not null)
            {
                @* The result, said once: headline, MVP, the debrief/Black Box switch and what to do next. *@
                <div class="jev-resultbar" role="status">
                    <div class="jev-resultbar__text">
                        <strong class="jev-resultbar__head">@ResultHeadline</strong>
                        <span class="jev-muted jev-small">@ResultDetail</span>
                        @if (MvpLine is not null)
                        {
                            <span class="jev-resultbar__mvp"><span aria-hidden="true">★</span> @MvpLine</span>
                        }
                    </div>
                    <div class="jev-resultbar__actions">
                        @if (_result.Debrief is not null)
                        {
                            <div class="jev-segmented" role="group" aria-label="Result view">
                                <button type="button" aria-pressed="@Pressed(ShowDebrief)" @onclick="() => _showDebrief = true">Jev debrief</button>
                                <button type="button" aria-pressed="@Pressed(!ShowDebrief)" @onclick="() => _showDebrief = false">Black Box</button>
                            </div>
                        }
                        @if (_result.Clip)
                        {
                            <button type="button" class="jev-btn jev-btn--ghost" @onclick="ShareClipAsync">Share final blow</button>
                        }
                        @if (!IsDemo)
                        {
                            <button type="button" class="jev-btn" @onclick="() => _reviewing = false">Back to the result</button>
                        }
                    </div>
                </div>
            }

            <div class="jev-layout" data-focus="@_mobileTeam">
                <TeamColumn Team="blue" Slots="_blue" Drafting="Drafting"
                            Hidden="@(IsTwoPlayer && Drafting && _twoPlayerStep != TwoPlayerStep.Blue)"
                            Locked="@(!CanDraftFor("blue"))"
                            LockLabel="@(IsTwoPlayer && _twoPlayerStep == TwoPlayerStep.Blue ? "Lock & pass" : null)"
                            PlayerLabel="@(IsTwoPlayer ? "Player 1" : null)"
                            OtherPoints="@(IsTwoPlayer ? null : Points(_red))"
                            Squads="_squads" Inspector="_inspectBlue"
                            OnClear='() => ClearTeam("blue")' OnLock='() => LockAsync("blue")' OnFill='() => FillAsync("blue")'
                            OnSaveSquad='name => SaveSquadAsync("blue", name)' OnLoadSquad='name => LoadSquadAsync("blue", name)' OnDeleteSquad="DeleteSquadAsync"
                            OnSlot='slot => OnSlotAsync("blue", slot)' />

                <div class="jev-center">
                    @if (Drafting)
                    {
                        <CreatureLibrary Items="VisibleLibrary" Sort="@_sort" Query="@_query" Filter="@_filter"
                                         CanBlue="@CanDraftFor("blue")" CanRed="@CanDraftFor("red")" Offline="_libraryOffline"
                                         OnPick="DraftAsync" OnEdit="Edit" OnFork="Fork" OnDelete="AskDelete"
                                         OnSort="OnSortAsync" OnQuery="OnQueryAsync" OnFilter="f => _filter = f ?? FilterAll" OnNew="NewCreature" />

                        @if (_pendingDelete is not null)
                        {
                            <div class="jev-confirm" role="alertdialog" aria-label="Confirm delete">
                                <span>Delete <strong>@_pendingDelete.Name</strong> from the public library?</span>
                                <button type="button" class="jev-btn jev-btn--danger" @onclick="ConfirmDeleteAsync">Delete</button>
                                <button type="button" class="jev-btn jev-btn--ghost" @onclick="() => _pendingDelete = null">Keep</button>
                            </div>
                        }
                    }
                    else
                    {
                        @* The canvases stay mounted while the debrief shows: the engine keeps its Black Box,
                           and the ResizeObserver re-fits it when the arena comes back. The GL canvas is the
                           optional post-processing layer (postfx.js); it stays hidden when WebGL2 is off. *@
                        <div class="jev-arena @(ShowDebrief ? "is-hidden" : null)">
                            <canvas id="@CanvasId" class="jev-arena__canvas" aria-label="Arena. Click a creature to inspect it."></canvas>
                            <canvas id="@(CanvasId + "Gl")" class="jev-arena__gl" hidden aria-hidden="true"></canvas>
                            <div class="jev-hud" data-glass hidden="@(_phase != Phase.Battle || _hud is null)">
                                <span class="jev-hud__team jev-hud__team--blue">Blue @_hud?.BlueAlive</span>
                                <span class="jev-hud__bar" role="img" aria-label="@HpShareLabel" style="--blue: @BlueSharePct%"></span>
                                <span class="jev-hud__team jev-hud__team--red">@_hud?.RedAlive Red</span>
                                <span class="jev-hud__clock">@Clock(_hud?.Time ?? 0)</span>
                                <span class="jev-hud__map jev-small">@_hud?.Arena</span>
                                <button type="button" class="jev-hud__cam" aria-pressed="@Pressed(_autoCamera)" @onclick="ToggleCameraAsync">Auto camera</button>
                            </div>
                            @if (_phase == Phase.Battle)
                            {
                                @* Hold Tab for the stat HUD; this is the same toggle for touch, where there is no Tab. *@
                                <button type="button" class="jev-statsbtn" aria-pressed="@Pressed(_statsOpen)" @onclick="() => _statsOpen = !_statsOpen"
                                        title="Hold Tab to show the stats">Stats <kbd>Tab</kbd></button>
                            }
                        </div>

                        <div class="jev-mobiletabs" role="group" aria-label="Inspector side">
                            <button type="button" aria-pressed="@Pressed(_mobileTeam == "blue")" @onclick='() => _mobileTeam = "blue"'>Blue inspector</button>
                            <button type="button" aria-pressed="@Pressed(_mobileTeam == "red")" @onclick='() => _mobileTeam = "red"'>Red inspector</button>
                        </div>

                        @if (_phase == Phase.Replay)
                        {
                            @if (ShowDebrief)
                            {
                                <JevDebrief Debrief="_result!.Debrief!" Winner="@_result.Winner" IsTwoPlayer="IsTwoPlayer" Frames="_result.Frames" OnJump="JumpToMomentAsync" />
                            }
                            else
                            {
                                <BlackBoxScrubber State="_blackBox" Kos="@(_result?.Kos ?? [])" Moments="Moments" OnCommand="OnBlackBoxCommandAsync" />
                            }
                        }
                    }
                </div>

                <TeamColumn Team="red" Slots="_red" Drafting="Drafting"
                            Locked="@(!CanDraftFor("red"))"
                            LockLabel="@(IsTwoPlayer && _twoPlayerStep == TwoPlayerStep.Red ? "Lock & deploy" : null)"
                            PlayerLabel="@(IsTwoPlayer ? "Player 2" : null)"
                            OtherPoints="@(IsTwoPlayer ? null : Points(_blue))"
                            Squads="_squads" Inspector="_inspectRed"
                            OnClear='() => ClearTeam("red")' OnLock='() => LockAsync("red")' OnFill='() => FillAsync("red")'
                            ShowCopy="@(!IsTwoPlayer)" OnCopy="CopyBlueAsync"
                            OnSaveSquad='name => SaveSquadAsync("red", name)' OnLoadSquad='name => LoadSquadAsync("red", name)' OnDeleteSquad="DeleteSquadAsync"
                            OnSlot='slot => OnSlotAsync("red", slot)' />
            </div>

            @if (_factoryOpen)
            {
                @* A drawer, not a replacement for the library: the list keeps its place behind it. *@
                <dialog open class="jev-drawer" aria-label="Creature factory" @onkeydown="OnDrawerKey">
                    <CreatureFactory Editing="_editing" Template="_template" OnSaved="OnCreatureSavedAsync" OnClose="CloseFactory" />
                </dialog>
            }
        </div>
    }
</GameShell>

@code {
    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoJevArena);

    // A <section>, not a <div>: the modal's small-print rule is written for div summaries.
    // The button is the shared one, because the modal sits outside .jev-root's palette.
    private RenderFragment GameSummaryContent => @<section class="jev-summary">
        <strong>@ResultHeadline</strong>
        <span>@ResultDetail</span>
        @if (MvpLine is not null)
        {
            <span><span aria-hidden="true">★</span> @MvpLine</span>
        }
        <button type="button" class="app-btn app-btn--secondary app-btn--sm" @onclick="() => _reviewing = true">Review the match</button>
    </section>;

    private string IntroObjective => IsDemo
        ? "Preset squads and community creatures fight while TypeSafe's Jev makes every call."
        : "Design creatures, draft two squads of ten, and watch Jev decide every move.";

    private RenderFragment HowToPlay => @<div>
        <ul>
            <li>Build creatures in the <strong>Factory</strong>: stats, one offense and one defense ability, a personality. Everyone melees.</li>
            <li>Draft ten per side from the public library with <strong>+ Blue</strong> / <strong>+ Red</strong>, then <strong>Deploy</strong>. Pillars, brush and tar change every map.</li>
            <li>The battle runs full screen: hold <kbd>Tab</kbd> for the stats. Click a creature to inspect Jev's probabilities. <kbd>[</kbd> <kbd>]</kbd> cycle Blue, <kbd>;</kbd> <kbd>'</kbd> cycle Red.</li>
            <li>After the match, scrub the <strong>Black Box</strong>: <kbd>Space</kbd> play, <kbd>←</kbd> <kbd>→</kbd> step, <kbd>Home</kbd> <kbd>End</kbd> jump.</li>
        </ul>
    </div>;
}

@using System.Globalization

@* Jev telemetry for one side's selected unit: the choice distributions, confidence and panic
   reading that governed it at this moment (live), or at the scrubbed frame (Black Box). *@
<section class="jev-inspector jev-inspector--@Team" aria-label="@($"{TeamName} Jev telemetry")" aria-live="polite">
    <header class="jev-inspector__head">
        <h2 class="jev-kicker">Jev telemetry</h2>
        @if (View is not null)
        {
            <span class="jev-chip jev-chip--@Team">@View.Unit</span>
        }
    </header>

    @if (View is null)
    {
        <p class="jev-muted">Click a @TeamName creature in the arena, or use <kbd>@(Team == "blue" ? "[" : ";")</kbd> <kbd>@(Team == "blue" ? "]" : "'")</kbd>.</p>
    }
    else
    {
        <div>
            <div class="jev-inspector__name">@View.Name</div>
            <div class="jev-muted jev-small">
                @if (View.Alive)
                {
                    <span>HP @View.Hp / @View.MaxHp</span>
                }
                else
                {
                    <span>Defeated</span>
                }
                <span> · doing <strong>@Pretty(View.Action)</strong></span>
                @if (View.Target is not null)
                {
                    <span> → @View.Target</span>
                }
            </div>
            <div class="jev-hp" aria-hidden="true"><span style="--pct: @Pct(View.Hp, View.MaxHp)%"></span></div>
            @if (View.Alive)
            {
                <div class="jev-inspector__row jev-small">
                    <span class="jev-muted">Stamina</span>
                    <span>@View.Stamina% · @StaminaWord(View.Stamina)</span>
                </div>
                <div class="jev-stamina" aria-hidden="true"><span style="--pct: @View.Stamina%"></span></div>
            }
        </div>

        @if (View.Decision is { Ok: true } d)
        {
            <Distribution Title="@($"Tactical action · confidence {F(d.ActionConfidence)}")" Values="d.ActionProbabilities" Chosen="@d.Action" />
            @if (d.FocusProbabilities is not null)
            {
                <Distribution Title="@($"Target focus · confidence {F(d.FocusConfidence)}")" Values="d.FocusProbabilities" Chosen="@d.Focus" />
            }
            <div class="jev-inspector__row">
                <span class="jev-muted">Panic (noul)</span>
                <strong class="@(d.Panic > 0.7 ? "jev-danger" : null)">@F(d.Panic) · @PanicWord(d.Panic)</strong>
            </div>
            <div class="jev-inspector__row jev-small">
                <span class="jev-muted">Decided</span>
                <span>@Ago(View.StaleSeconds) · @d.LatencyMs ms</span>
            </div>
        }
        else if (View.Decision is { Ok: false } failed)
        {
            <p class="jev-warn">Jev couldn't answer (@Failure(failed.Failure)). Holding its last order, @Ago(View.StaleSeconds).</p>
        }
        else
        {
            <p class="jev-muted">Awaiting its first orders from Jev…</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public string Team { get; set; } = "blue";
    [Parameter] public ArenaInspectorView? View { get; set; }

    private string TeamName => Team == "blue" ? "Blue" : "Red";

    private static string F(double v) => v.ToString("0.00", CultureInfo.InvariantCulture);
    private static string Pct(int hp, int max) => (max <= 0 ? 0 : 100.0 * hp / max).ToString("0", CultureInfo.InvariantCulture);
    private static string Pretty(string action) => action.Replace('_', ' ');
    private static string StaminaWord(int s) => s >= 70 ? "fresh" : s >= 35 ? "tiring" : s >= 15 ? "winded" : "exhausted";
    private static string PanicWord(double p) => p > 0.7 ? "panicking" : p > 0.4 ? "uneasy" : "calm";
    private static string Ago(double s) => s < 1.5
        ? string.Create(CultureInfo.InvariantCulture, $"{s:0.0} s ago")
        : string.Create(CultureInfo.InvariantCulture, $"stale · {s:0.0} s");

    private static string Failure(string? code) => code switch
    {
        "timeout" => "timed out",
        "http-429" or "rate-limited" => "rate limited",
        "allowance-exhausted" => "daily allowance used up",
        "match-expired" => "match expired",
        "jev-unavailable" => "Jev unavailable",
        null => "unknown error",
        _ => code,
    };
}

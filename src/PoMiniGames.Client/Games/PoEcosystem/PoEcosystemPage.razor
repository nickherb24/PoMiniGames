@page "/poecosystem"
@page "/poecosystem/{Mode}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models
@inject PlayerNameService PlayerNameService

<PageTitle>Ecosystem · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           BackTo="/"
           GameKey="poecosystem"
           RequiresWebGl="true"
           Fullscreen="true">

    @if (!_introDismissed)
    {
        <GameIntro CueScope="poecosystem"
                   Title=@TitleContent
                   Objective="A living island that runs without you — creatures born, hungry and ageing while you watch."
                   Controls=@HowToPlayContent
                   Mode="@(IsDemo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                   StartLabel="Watch"
                   OnStart="@(() => _introDismissed = true)" />
    }
    else
    {
        <PoEcosystemViewer IsDemo="@IsDemo" VisitCode="@Island" />
    }
</GameShell>

@code {
    [Parameter] public string? Mode { get; set; }

    /// <summary>A shared island's code (<c>?island=CODE</c>): the viewer sails straight to it, read-only.</summary>
    [SupplyParameterFromQuery(Name = "island")] public string? Island { get; set; }

    private string _playerName = "";
    private bool _introDismissed;

    // /poecosystem and /poecosystem/1player are YOUR island: it is kept in this browser and
    // offered back on the next visit. /poecosystem/demo is the kiosk — a fresh island every
    // time, never saved. Treating every mode as demo would make the resume prompt
    // unreachable and every visit autosave a new island over the last one.
    private bool IsDemo => GameModes.Parse(Mode) == GameMode.Demo;

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🌿</span> Ecosystem</span>;

    private RenderFragment HowToPlayContent => @<div>
        @* Word budget — the intro card is capped at 100 words. Everything the
           dashboard holds is discoverable in situ; the card teaches movement + inspection. *@
        <p><strong>You are a naturalist drifting over the island. Nothing here needs you, and nothing you do changes it.</strong></p>
        <ul>
            <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> fly · <kbd>Space</kbd>/<kbd>Ctrl</kbd> rise and sink · <kbd>Shift</kbd> hurry · <kbd>F</kbd> walk</li>
            <li><kbd>E</kbd> or click: study the creature under the crosshair · <kbd>T</kbd> follows it · <kbd>/</kbd> finds one by name</li>
            <li><kbd>L</kbd> lenses · <kbd>C</kbd> cinematic camera · <kbd>Tab</kbd> dashboard · <kbd>H</kbd> every key</li>
            <li><kbd>0</kbd>–<kbd>3</kbd>: pause, 1×, 2×, 4×</li>
        </ul>
    </div>;

    protected override void OnInitialized() => _playerName = PlayerNameService.GetPlayerName();
}

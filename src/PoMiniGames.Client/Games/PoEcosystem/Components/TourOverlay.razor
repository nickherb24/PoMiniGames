@* First-visit tour. Five steps, each ticked off by the thing it
   teaches actually happening (the viewer passes Done), so nobody reads a manual. The viewer
   holds the auto-director off while it runs — demo mode would otherwise take the camera four
   seconds in, which is the one moment a newcomer is trying to look around. *@
<aside class="poeco-tour" role="dialog" aria-label="Getting started" aria-live="polite">
    <header class="poeco-tour-head">
        <span class="poeco-tour-step">@(Step + 1) / @Steps.Length</span>
        <strong>@Steps[Step].Title</strong>
        <span class="poeco-spacer"></span>
        <button type="button" class="poeco-pill" @onclick="OnSkip" aria-label="Skip the tour">Skip</button>
    </header>
    <p>@((MarkupString)Steps[Step].Body)</p>
    <div class="poeco-tour-actions">
        @if (Done)
        {
            <span class="poeco-tour-done" aria-hidden="true">✓</span>
            <button type="button" class="poeco-btn poeco-btn--primary poeco-btn--sm" @onclick="OnNext">@(Step == Steps.Length - 1 ? "Finish" : "Next")</button>
        }
        else
        {
            <span class="poeco-note">Waiting for you to try it…</span>
            <button type="button" class="poeco-btn poeco-btn--sm" @onclick="OnNext">@(Step == Steps.Length - 1 ? "Finish" : "Next")</button>
        }
    </div>
</aside>

@code {
    public static readonly (string Signal, string Title, string Body)[] Steps =
    [
        ("look", "Look around", "Drag with the mouse, or click the world for free-look. You are an invisible observer — nothing here needs you."),
        ("move", "Drift over the island", "<kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> to move, <kbd>Space</kbd>/<kbd>Ctrl</kbd> to rise and sink, <kbd>Shift</kbd> to hurry."),
        ("inspect", "Study a creature", "Put the crosshair on an animal and press <kbd>E</kbd> (or click): its drives, personality, family and last thought."),
        ("dashboard", "Open the field station", "<kbd>Tab</kbd> opens the dashboard — the timeline, populations, the almanac and your field notes."),
        ("director", "Let it film itself", "Press <kbd>C</kbd> and the auto-director finds the drama for you. Enjoy the island."),
    ];

    [Parameter] public int Step { get; set; }
    [Parameter] public bool Done { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnSkip { get; set; }
}

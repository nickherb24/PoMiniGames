@using PoMiniGames.Shared.Games.PoEcosystem
@using System.Globalization
@* The clans on the island: each territory, its buildings and the caravans between them, over
   the island's own map. Click a camp to fly there.

   Everything drawn here is true of the island: the ground is the seed's real map (index.js
   islandThumb), and where things actually die, graze and walk is the HUD minimap's data
   layers, which read the sim. *@
<div class="poeco-minimap-card" role="region" aria-label="Clan territories">
    <div class="poeco-minimap-svg-container">
        <svg viewBox="0 0 200 200" class="poeco-minimap-svg" role="img" aria-label="@Summary">
            <rect width="200" height="200" fill="#0c4a6e" />
            @if (!string.IsNullOrEmpty(Thumb))
            {
                <image href="@Thumb" x="0" y="0" width="200" height="200" preserveAspectRatio="none" opacity="0.8" style="image-rendering: pixelated" />
            }

            @if (Tribes is not null)
            {
                @foreach (var tribe in Tribes)
                {
                    <circle cx="@N(tribe.CenterX)" cy="@N(tribe.CenterZ)" r="@N(tribe.TerritoryRadius)"
                            fill="@tribe.BannerColor" fill-opacity="0.2" stroke="@tribe.BannerColor" stroke-width="1.4" stroke-dasharray="4,2" />
                }
            }

            @if (Buildings is not null)
            {
                @foreach (var b in Buildings)
                {
                    var fill = b.Kind switch
                    {
                        BuildingKind.Watchtower => "#e74c3c",
                        BuildingKind.Granary => "#f1c40f",
                        BuildingKind.WarTotem => "#9b59b6",
                        _ => "#ecf0f1",
                    };
                    <circle cx="@N(b.X)" cy="@N(b.Z)" r="2.2" fill="@fill" stroke="#111" stroke-width="0.6" opacity="@(b.IsComplete ? "1" : "0.5")" />
                }
            }

            @if (Caravans is not null)
            {
                @foreach (var c in Caravans)
                {
                    <circle cx="@N(c.X)" cy="@N(c.Z)" r="3" fill="#f39c12" stroke="#fff" stroke-width="0.8">
                        <title>Caravan: @c.Amount @c.CargoKind</title>
                    </circle>
                }
            }

            @if (Tribes is not null)
            {
                @foreach (var tribe in Tribes)
                {
                    <g class="poeco-territory-camp" @onclick="() => OnFocusTribe.InvokeAsync(tribe.Id)">
                        <title>Fly to @tribe.Name</title>
                        <circle cx="@N(tribe.CenterX)" cy="@N(tribe.CenterZ)" r="5" fill="@tribe.BannerColor" stroke="#ffffff" stroke-width="1.8" />
                        @((MarkupString)$"<text x=\"{N(tribe.CenterX)}\" y=\"{N(tribe.CenterZ - 8)}\" class=\"poeco-territory-label\" text-anchor=\"middle\">{System.Net.WebUtility.HtmlEncode(tribe.Name)}</text>")
                    </g>
                }
            }
        </svg>
    </div>
    <div class="poeco-minimap-legend">
        <span class="poeco-minimap-key"><span class="poeco-key-dot poeco-key-dot--hut"></span>Hut</span>
        <span class="poeco-minimap-key"><span class="poeco-key-dot poeco-key-dot--granary"></span>Granary</span>
        <span class="poeco-minimap-key"><span class="poeco-key-dot poeco-key-dot--tower"></span>Tower</span>
        <span class="poeco-minimap-key"><span class="poeco-key-dot poeco-key-dot--caravan"></span>Caravan</span>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<TribeStateDto>? Tribes { get; set; }
    [Parameter] public IReadOnlyList<BuildingStateDto>? Buildings { get; set; }
    [Parameter] public IReadOnlyList<TradeCaravanDto>? Caravans { get; set; }
    /// <summary>The island's map as a data URL (drawn from its seed).</summary>
    [Parameter] public string? Thumb { get; set; }
    [Parameter] public EventCallback<int> OnFocusTribe { get; set; }

    private string Summary => Tribes is { Count: > 0 }
        ? "Clan territories: " + string.Join(", ", Tribes.Select(t => $"{t.Name}, {t.Population} people"))
        : "No clans have settled yet";

    private static string N(float v) => v.ToString("F1", CultureInfo.InvariantCulture);
}

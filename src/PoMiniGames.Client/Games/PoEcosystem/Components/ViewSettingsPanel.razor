@* Viewing settings: graphics quality and controls. All of it is about how the island is
   SEEN — the engine keeps it in its prefs (sim/persistence/prefs.js), and none of it
   reaches the simulation.

   The colour palette and reduce-motion are app settings (the sheet in the top bar's
   account menu), so there are no rows for them here: a second switch could only add to
   the app's, never turn it off. *@
@inject SettingsService AppSettings
<div class="poeco-viewsettings">
    <h3>Graphics</h3>
    <label class="poeco-field" title="Resolution also scales itself when the frame rate drops. Changing quality rebuilds the view; the island keeps running.">
        <span>Quality</span>
        <select value="@(Settings?.Quality ?? "auto")" @onchange="QualityChanged">
            <option value="auto">Auto (detect this device)</option>
            <option value="high">High — shadows, particles, birds</option>
            <option value="medium">Medium — lighter particles</option>
            <option value="low">Low — no shadows or particles</option>
        </select>
    </label>

    <h3>Accessibility</h3>
    <p class="poeco-note">
        Colour-blind safe colours, reduced motion and sound volume are app settings.
        <button type="button" class="poeco-btn poeco-btn--sm" @onclick="AppSettings.RequestOpen">App settings</button>
    </p>

    <h3>Controls</h3>
    <p class="poeco-note" title="Left stick moves, right stick looks, A inspect, B float/walk, X follow, Y dashboard, bumpers rise/sink, Start cinematic.">
        @(Settings?.Gamepad == true ? "Gamepad connected (hover for its buttons)." : "Gamepads work too: connect one and press a button.")
    </p>
    @if (Settings is { } s)
    {
        <table class="poeco-bindings">
            <tbody>
                @foreach (var action in s.Bindable)
                {
                    var codes = s.Bindings.TryGetValue(action, out var c) ? c : [];
                    <tr>
                        <th scope="row">@Label(action)</th>
                        <td>@foreach (var key in codes.Select(KeyName).Distinct()) { <kbd>@key</kbd> }</td>
                        <td>
                            <button type="button" class="poeco-btn poeco-btn--sm" disabled="@(Capturing is not null)" @onclick="() => OnRebind.InvokeAsync(action)">
                                @(Capturing == action ? "Press a key…" : "Change")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="button" class="poeco-btn poeco-btn--sm" @onclick="OnResetBindings">Reset to defaults</button>
    }
    <p class="poeco-note">Fixed: <kbd>Tab</kbd> dashboard · <kbd>Esc</kbd> close · <kbd>0</kbd>–<kbd>3</kbd> speed · <kbd>/</kbd> find · <kbd>L</kbd> lens · <kbd>H</kbd> keys</p>
</div>

@code {
    private static readonly Dictionary<string, string> Labels = new()
    {
        ["forward"] = "Forward", ["back"] = "Back", ["left"] = "Left", ["right"] = "Right", ["run"] = "Hurry",
        ["rise"] = "Rise", ["sink"] = "Sink", ["fly"] = "Float / walk", ["inspect"] = "Inspect", ["follow"] = "Follow",
        ["director"] = "Cinematic", ["pip"] = "Pop out",
    };

    [Parameter] public EcoSettings? Settings { get; set; }
    [Parameter] public string? Capturing { get; set; }
    [Parameter] public EventCallback<string> OnQuality { get; set; }
    [Parameter] public EventCallback<string> OnRebind { get; set; }
    [Parameter] public EventCallback OnResetBindings { get; set; }

    private static string Label(string action) => Labels.GetValueOrDefault(action, action);
    private Task QualityChanged(ChangeEventArgs e) => OnQuality.InvokeAsync(e.Value?.ToString() ?? "auto");

    /// <summary>KeyboardEvent.code → what is printed on the key ("KeyW" → "W", "ArrowUp" → "↑").</summary>
    internal static string KeyName(string code) => code switch
    {
        _ when code.StartsWith("Key", StringComparison.Ordinal) && code.Length == 4 => code[3..],
        _ when code.StartsWith("Digit", StringComparison.Ordinal) => code[5..],
        "ArrowUp" => "↑", "ArrowDown" => "↓", "ArrowLeft" => "←", "ArrowRight" => "→",
        "ShiftLeft" or "ShiftRight" => "Shift", "ControlLeft" or "ControlRight" => "Ctrl",
        "AltLeft" or "AltRight" => "Alt", "Space" => "Space",
        _ => code,
    };
}

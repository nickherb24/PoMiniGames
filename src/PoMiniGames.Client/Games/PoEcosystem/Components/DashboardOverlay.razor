@using PoMiniGames.Shared.Games.PoEcosystem
@* The Tab overlay. Releases pointer lock while open (the engine does that); Esc closes it.

   2026-09-30: four tabs and a gear, where there were eight tabs under a header.
     Island  the timeline (the one population chart — it used to be drawn three times, on
             Analytics, Island and Timeline), the world log, the almanac, field notes, wagers
     Life    thoughts, the watch-list and its alerts, evolution
     Tribes  the clans side by side, their territories, the ladder, diplomacy, the chronicle
     Worlds  which island this is: seed and new world (were in Settings), cloud slots and
             the gallery (were in Cloud)
     ⚙       AI thoughts, graphics, accessibility, controls
   The header row repeated the HUD chip (year, day, alive) and is gone; Close sits on the
   tab row. Speed moved to the HUD. The active tab is component state — the dashboard is
   reopened often and remembers where it was. *@
<div class="poeco-overlay" role="dialog" aria-modal="true" aria-label="Dashboard — year @(Stats?.Year ?? 0), @(Stats?.Alive ?? 0) alive" @onkeydown="OnKeyDown" tabindex="-1" @ref="_root">
    <div class="poeco-overlay-card">
        <nav class="poeco-tabs" role="tablist" aria-label="Dashboard sections">
            @foreach (var (id, label) in Tabs)
            {
                <button type="button" role="tab" class="poeco-tab @(_tab == id ? "poeco-tab--on" : "")" aria-selected="@(_tab == id ? "true" : "false")"
                        aria-label="@(id == "settings" ? "Settings" : label)" title="@(id == "settings" ? "Settings" : null)" @onclick="() => SelectTab(id)">@label</button>
            }
            <span class="poeco-spacer"></span>
            <button type="button" class="poeco-pill" @onclick="OnClose" aria-label="Close the dashboard">Close <kbd>Esc</kbd></button>
        </nav>

        @if (_tab == "island")
        {
            <div class="poeco-overlay-grid">
                <section class="poeco-panel poeco-panel--wide">
                    <TimelinePanel History="@History" Stats="@Stats" OnFly="@OnFlyToTile" Keyframes="@Keyframes" Past="@Past"
                                   OnOpenKeyframe="@OnOpenKeyframe" OnReturn="@OnReturn" OnSonify="@OnSonify" />
                </section>

                <section class="poeco-panel poeco-panel--log">
                    <h3>World log</h3>
                    <ol class="poeco-log">
                        @foreach (var ev in Events.AsEnumerable().Reverse().Take(60))
                        {
                            <li><span class="poeco-log-tick">@($"Y{Year(ev)}")</span> @ev.Text</li>
                        }
                    </ol>
                </section>

                <section class="poeco-panel poeco-panel--almanac">
                    <h3>Almanac</h3>
                    <AlmanacPanel Stats="@Stats" Cards="@Cards" OnExportTelemetry="@OnExportTelemetry" />
                </section>

                <section class="poeco-panel">
                    <h3>Wagers</h3>
                    <WagerPanel Book="@Wagers" Years="@(History?.Years ?? [])" Year="@(Stats?.Year ?? 0)" Enabled="@(!ReadOnly)" />
                    <h3>Field notes · @Milestones.Count of @EcoMilestones.All.Length</h3>
                    <MilestonesPanel Unlocked="@Milestones" />
                </section>
            </div>
        }
        else if (_tab == "life")
        {
            <div class="poeco-overlay-grid">
                <section class="poeco-panel poeco-panel--thoughts">
                    <h3>Thoughts</h3>
                    <ThoughtsFeed Thoughts="@Thoughts" OnSelect="@OnSelectThought" />
                </section>
                <section class="poeco-panel">
                    <h3>Watching</h3>
                    <WatchPanel Watched="@(Stats?.Watched ?? [])" OnSelect="@OnSelectKin" OnUnwatch="@OnUnwatch" />
                    <h3>Alerts</h3>
                    <AlertsPanel Book="@Alerts" Stats="@Stats" />
                </section>
                <section class="poeco-panel">
                    <h3>Evolution</h3>
                    <EvolutionPanel Stats="@Stats" Tint="@Tint" OnTint="@OnTint" />
                </section>
            </div>
        }
        else if (_tab == "tribe")
        {
            <TribePanel Stats="@Stats" Sagas="@Sagas" Busy="@ChronicleBusy" FromYear="@ChronicleFromYear" ReadOnly="@ReadOnly" Thumb="@CurrentThumb"
                        OnWrite="@OnWriteChronicle" OnPrint="@OnPrintJournal" OnFocusTribe="@OnFocusTribe" Legends="@Legends" />
        }
        else if (_tab == "worlds")
        {
            <WorldsPanel Stats="@Stats" Worlds="@Worlds" Gallery="@Gallery" SignedIn="@SignedIn" Busy="@CloudBusy" Message="@CloudMessage"
                         Visiting="@ReadOnly" CurrentSeed="@CurrentSeed" Seed="@Seed" SeedChanged="@SeedChanged" DailySeed="@DailySeed"
                         Thumbs="@Thumbs" MyYears="@(History?.Years ?? [])" Compare="@Compare"
                         OnNewWorld="@OnNewWorld" OnTodaysIsland="@OnTodaysIsland" OnReturn="@OnReturn"
                         OnRefresh="@OnCloudRefresh" OnSave="@OnCloudSave" OnLoad="@OnCloudLoad" OnDelete="@OnCloudDelete" OnShare="@OnCloudShare"
                         OnVisit="@OnVisit" OnCompare="@OnCompare" OnLink="@OnLink" OnNeedThumbs="@OnNeedThumbs" />
        }
        else
        {
            <div class="poeco-overlay-grid">
                <section class="poeco-panel poeco-panel--settings">
                    <h3>AI thoughts</h3>
                    @if (WebGpu)
                    {
                        <label class="poeco-switch">
                            <input type="checkbox" checked="@LlmOn" @onchange="ToggleLlm" />
                            <span>Let creatures think (@ModelLabel)</span>
                        </label>
                        <label class="poeco-field">
                            <span>Model</span>
                            <select value="@SelectedModel" @onchange="ChangeModel">
                                @foreach (var m in Models.Where(m => m.Id != "cloud"))
                                {
                                    <option value="@m.Id">@m.Label — @(m.VramMb) MB</option>
                                }
                            </select>
                        </label>
                        @if (Llm is not null && Llm.State == "loading")
                        {
                            <div class="poeco-progress"><span style="width: @($"{Llm.Progress * 100:0}%")"></span></div>
                        }
                        @if (Llm is not null && !string.IsNullOrWhiteSpace(Llm.Message))
                        {
                            <p class="poeco-note">@Llm.Message</p>
                        }
                    }
                    <label class="poeco-switch" title="Routes creatures' thoughts through the server model every twenty seconds. Works without WebGPU; spends your daily AI allowance, so it is capped per session.">
                        <input type="checkbox" checked="@CloudThoughts" @onchange="ToggleCloud" />
                        <span>Cloud thoughts (@CloudThoughtsLeft left this session)</span>
                    </label>
                    <p class="poeco-note">@ThoughtsNote</p>
                    <button type="button" class="poeco-btn poeco-btn--sm" @onclick="OnReplayTour">Show the getting-started tour again</button>
                </section>
                <section class="poeco-panel poeco-panel--chart">
                    <ViewSettingsPanel Settings="@ViewSettings" Capturing="@Capturing" OnQuality="@OnQuality"
                                       OnRebind="@OnRebind" OnResetBindings="@OnResetBindings" />
                </section>
            </div>
        }
    </div>
</div>

@code {
    private static readonly (string Id, string Label)[] Tabs =
    [
        ("island", "Island"), ("life", "Life"), ("tribe", "Tribes"), ("worlds", "Worlds"), ("settings", "⚙"),
    ];

    private ElementReference _root;
    private string _tab = "island";

    /// <summary>The tab to open on. The overlay is rebuilt every time it opens, so the viewer
    /// holds the last tab and hands it back — that is what makes "remembers where it was" true.</summary>
    [Parameter] public string InitialTab { get; set; } = "island";

    protected override void OnInitialized() => _tab = Tabs.Any(t => t.Id == InitialTab) ? InitialTab : "island";

    private string ThoughtsNote =>
        (WebGpu ? "" : "No WebGPU here, so thoughts come from instinct templates or the cloud model. ")
        + (Stats?.Llm is { } counters ? $"{counters.Applied} thoughts applied, {counters.Rejected} rejected." : "");

    [Parameter] public EcoStats? Stats { get; set; }
    [Parameter] public IReadOnlyList<EcoEvent> Events { get; set; } = [];
    [Parameter] public IReadOnlyList<EcoThought> Thoughts { get; set; } = [];
    [Parameter] public IReadOnlyList<EcoSaga> Sagas { get; set; } = [];
    [Parameter] public EcoWorldMeta[] Worlds { get; set; } = [];
    [Parameter] public EcoSharedWorld[] Gallery { get; set; } = [];
    [Parameter] public EcoLlmState? Llm { get; set; }
    [Parameter] public IReadOnlyList<EcoModel> Models { get; set; } = [];
    [Parameter] public bool WebGpu { get; set; }
    [Parameter] public bool CloudThoughts { get; set; }
    [Parameter] public int CloudThoughtsLeft { get; set; }
    [Parameter] public bool SignedIn { get; set; }
    [Parameter] public bool CloudBusy { get; set; }
    [Parameter] public string? CloudMessage { get; set; }
    [Parameter] public bool ChronicleBusy { get; set; }
    [Parameter] public int ChronicleFromYear { get; set; }
    [Parameter] public int Tint { get; set; } = -1;
    [Parameter] public string Seed { get; set; } = "";
    [Parameter] public int CurrentSeed { get; set; }
    /// <summary>A visited island or a past decade: nothing is saved, wagered or chronicled.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<string> SeedChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnFocusTribe { get; set; }
    [Parameter] public EventCallback OnExportTelemetry { get; set; }
    [Parameter] public EventCallback<int> OnSelectThought { get; set; }
    [Parameter] public EventCallback<int> OnSelectKin { get; set; }
    [Parameter] public EventCallback<int> OnUnwatch { get; set; }
    [Parameter] public EventCallback<int> OnTint { get; set; }
    [Parameter] public EventCallback<(bool Enabled, string? ModelId)> OnLlmToggle { get; set; }
    [Parameter] public EventCallback<string?> OnNewWorld { get; set; }
    [Parameter] public EventCallback OnWriteChronicle { get; set; }
    [Parameter] public EventCallback OnPrintJournal { get; set; }
    [Parameter] public EventCallback OnCloudRefresh { get; set; }
    [Parameter] public EventCallback<string> OnCloudSave { get; set; }
    [Parameter] public EventCallback<string> OnCloudLoad { get; set; }
    [Parameter] public EventCallback<string> OnCloudDelete { get; set; }
    [Parameter] public EventCallback<(string Slot, bool Public)> OnCloudShare { get; set; }
    [Parameter] public EventCallback<string> OnVisit { get; set; }
    [Parameter] public EventCallback<EcoSharedWorld> OnCompare { get; set; }
    [Parameter] public EventCallback<(string Code, string Name)> OnLink { get; set; }
    [Parameter] public EventCallback<int[]> OnNeedThumbs { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string> Thumbs { get; set; } = new Dictionary<int, string>();
    [Parameter] public (string Code, string Name, int[][] Years)? Compare { get; set; }
    [Parameter] public EcoHistory? History { get; set; }
    [Parameter] public EventCallback<int> OnFlyToTile { get; set; }
    [Parameter] public IReadOnlyList<EcoKeyframe> Keyframes { get; set; } = [];
    [Parameter] public int Past { get; set; } = -1;
    [Parameter] public EventCallback<int> OnOpenKeyframe { get; set; }
    [Parameter] public EventCallback OnReturn { get; set; }
    [Parameter] public EventCallback<(int[][] Rows, int Peak)> OnSonify { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> Milestones { get; set; } = new Dictionary<string, string>();
    [Parameter, EditorRequired] public EcoWagerBook Wagers { get; set; } = default!;
    [Parameter, EditorRequired] public EcoAlertBook Alerts { get; set; } = default!;
    [Parameter] public IReadOnlyList<EcoSpeciesCard> Cards { get; set; } = [];
    [Parameter] public IReadOnlyList<(int Year, string Epithet, string Legend)> Legends { get; set; } = [];
    [Parameter] public EcoSettings? ViewSettings { get; set; }
    [Parameter] public string? Capturing { get; set; }
    [Parameter] public string DailySeed { get; set; } = "";
    [Parameter] public EventCallback OnTodaysIsland { get; set; }
    [Parameter] public EventCallback OnReplayTour { get; set; }
    [Parameter] public EventCallback<string> OnQuality { get; set; }
    [Parameter] public EventCallback<string> OnRebind { get; set; }
    [Parameter] public EventCallback OnResetBindings { get; set; }
    /// <summary>Raised when a tab opens, so the viewer can load what that tab needs (field guide, cloud).</summary>
    [Parameter] public EventCallback<string> OnTab { get; set; }

    private string? CurrentThumb => Thumbs.TryGetValue(CurrentSeed, out var url) && url.Length > 0 ? url : null;

    private bool LlmOn => Llm is not null && Llm.State is "loading" or "ready" && Llm.ModelId != "cloud";
    private string SelectedModel => Llm?.ModelId is { } id && id != "cloud" ? id : Models.FirstOrDefault()?.Id ?? "";
    private string ModelLabel => Models.FirstOrDefault(m => m.Id == SelectedModel)?.Label ?? "in-browser model";

    // The log carries the tick; the year it fell in is derived from the sim's own clock
    // constants rather than a hardcoded ticks-per-year in the markup.
    private int Year(EcoEvent ev) => Stats is null || Stats.Tick <= 0 ? 0 : (int)((long)ev.Tick * Stats.Year / Math.Max(1, Stats.Tick));

    private Task ToggleLlm(ChangeEventArgs e) => OnLlmToggle.InvokeAsync((e.Value is true, SelectedModel));
    private Task ToggleCloud(ChangeEventArgs e) => OnLlmToggle.InvokeAsync((e.Value is true, "cloud"));
    private Task ChangeModel(ChangeEventArgs e) => OnLlmToggle.InvokeAsync((true, e.Value?.ToString()));

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" && Capturing is null ? OnClose.InvokeAsync() : Task.CompletedTask;

    private Task SelectTab(string id)
    {
        _tab = id;
        return OnTab.InvokeAsync(id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await _root.FocusAsync(); } catch { /* the overlay may already be gone */ }
        // The first tab needs what any tab needs when it opens (the field guide for Island).
        await OnTab.InvokeAsync(_tab);
    }
}

@using System.Net.Http
@inject HttpClient Http
@inject JokerSpeechService SpeechService
@inject JokerAudioService AudioService
@inject PerformanceSettings PerformanceSettings
@inject IJSRuntime JS
@implements IAsyncDisposable

<NetworkAwaiting IsVisible="@_orchestrator.ShowNetworkOverlay"
                 Message="Connection lost. Retrying."
                 StatusText="@_orchestrator.NetworkStatusText"
                 IsRetrying="@_orchestrator.IsRetrying"
                 RetryCount="@_orchestrator.RetryCount"
                 OnRetry="@_orchestrator.RetryNetworkAsync" />

<div class="jester-stage">
    <div class="stage-header">
        <h2 class="gps-phase-h">The Digital Jester</h2>
    </div>

    <PerformanceDisplay CurrentState="@_orchestrator.CurrentState"
                        CurrentJoke="@_orchestrator.CurrentJoke"
                        CurrentAnalysis="@_orchestrator.CurrentAnalysis"
                        JokesDisplayed="@_orchestrator.JokesDisplayed"
                        TopJokes="@_orchestrator.TopJokes"
                        SessionTriumphs="@_orchestrator.SessionTriumphs"
                        PunchlineRevealed="@_orchestrator.PunchlineRevealed" />

    <PerformanceControls IsRunning="@_orchestrator.IsRunning"
                         OnStart="@StartPerformance"
                         OnStop="@StopPerformance" />
</div>

@code {
    private PerformanceOrchestrator _orchestrator = null!;

    /// <summary>When true, the show starts automatically on first render (demo mode).</summary>
    [Parameter] public bool AutoStart { get; set; } = true;

    /// <summary>
    /// Unattended mode: when a show finishes, reset and run another instead of ending.
    /// A looping stage never raises <see cref="OnShowComplete"/> — there is no end to
    /// report, and the host must not put up the end-of-game modal, which nobody would
    /// be there to dismiss.
    /// </summary>
    [Parameter] public bool Loop { get; set; }

    /// <summary>Beat between shows so the last punchline lands before the next setup.</summary>
    private const int LoopGapMs = 4000;

    private bool _disposed;

    /// <summary>
    /// Raised once when the 10-joke show finishes, carrying the session's triumph
    /// count. Lets the hosting page surface the result in the shared end-of-game
    /// modal — the completion state lives in the orchestrator, which the page
    /// can't otherwise observe.
    /// </summary>
    [Parameter] public EventCallback<int> OnShowComplete { get; set; }

    // Guards against re-raising OnShowComplete on every StateChanged tick while
    // the orchestrator sits in Complete.
    private bool _completeRaised;

    protected override void OnInitialized()
    {
        _orchestrator = new PerformanceOrchestrator(Http, SpeechService, AudioService, PerformanceSettings);
        _orchestrator.StateChanged += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (AutoStart && !_orchestrator.IsRunning)
            {
                _ = StartPerformance();
            }
        }

        // Start the show on a false→true transition of AutoStart. The first-render check above covers the
        // Demo case (AutoStart=true on first paint); this covers the
        // post-intro case where the page flips AutoStart to true after the
        // player dismisses the controls card. Without it, a 1-player show
        // that waited for intro dismissal would never actually start.
        if (AutoStart && !_firstAutoStartSeen && !_orchestrator.IsRunning)
        {
            _firstAutoStartSeen = true;
            _ = StartPerformance();
        }
        _firstAutoStartSeen = _firstAutoStartSeen || AutoStart;
    }

    private bool _firstAutoStartSeen;

    private async Task StartPerformance()
    {
        // Deliberately not safeMode: the Jester is meant to be edgy, so it runs on
        // JokeAPI's Dark category with safe-mode off. JokeApiClient.BuildUrl still
        // blacklists the racist, sexist and religious flags: dark and crude can come
        // back, jokes that target a group cannot. A Dark joke can still trip the AI
        // jester's content filter; AiJesterService answers with a shrug line and
        // scores it as not-a-triumph.
        _orchestrator.SelectedCategory = "Dark";
        _orchestrator.SelectedSafeMode = false;
        _orchestrator.SelectedMoodLabel = "Random";

        // Iterative, not recursive: an attract screen can run for days, and each show
        // calling the next would grow the stack until it fell over.
        while (true)
        {
            await _orchestrator.StartAsync();

            // Only a show that ran to Complete rolls over. A manual Stop (or teardown)
            // leaves another state, and must stay stopped.
            if (!Loop || _disposed || _orchestrator.CurrentState != PerformanceState.Complete)
            {
                break;
            }

            await Task.Delay(LoopGapMs);
            if (_disposed) break;
            _orchestrator.ResetForNewShow();
        }
    }

    private async Task StopPerformance()
    {
        await _orchestrator.StopAsync();
    }

    private void OnStateChanged()
    {
        // A looping stage has no "show over" to report — see the Loop parameter.
        if (!Loop && !_completeRaised && _orchestrator.CurrentState == PerformanceState.Complete)
        {
            _completeRaised = true;
            InvokeAsync(() => OnShowComplete.InvokeAsync(_orchestrator.SessionTriumphs));
        }
        // Dev introspection: publish a live snapshot of the orchestrator's state
        // so browser-side tests can verify the audio/UI sync directly instead of
        // inferring it from DOM mutation timing. A Try/catch around the JS
        // interop keeps teardown paths (where the runtime may already be gone)
        // from throwing on cleanup.
        try
        {
            var state = _orchestrator.CurrentState.ToString();
            var punchline = _orchestrator.PunchlineRevealed ? "true" : "false";
            _ = JS.InvokeVoidAsync("eval",
                $"window.__poJokerDebug = {{ state:'{state}', punchlineRevealed:{punchline} }};");
        }
        catch { /* JS interop may be unavailable during teardown */ }
        InvokeAsync(StateHasChanged);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        // Breaks the loop above: navigating away must not leave a show restarting forever.
        _disposed = true;
        if (_orchestrator != null)
        {
            _orchestrator.StateChanged -= OnStateChanged;
            await _orchestrator.DisposeAsync();
        }
    }
}

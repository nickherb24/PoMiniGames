@* PoJoker — network-loss overlay shown while the courier finds a path to the server. *@

<div class="network-awaiting @(IsVisible ? "visible" : "")" role="dialog" aria-modal="false" aria-live="polite">
    <div class="network-content">
        <p class="network-message">@Message</p>
        <p class="status-text">@StatusText</p>
        @if (IsRetrying)
        {
            <p class="retry-count">Attempting to reconnect... (@RetryCount)</p>
        }
        @* Retry affordance: when a 401/403/etc. surfaces, the overlay covers the
           whole viewport, so the underlying "Begin comedy show" button cannot be
           re-clicked. The modal exposes a manual retry (calls OnRetry.InvokeAsync)
           so the user can re-attempt the network call without a page reload. *@
        @if (OnRetry.HasDelegate)
        {
            <button class="network-retry" @onclick="OnRetryClick"
                    disabled="@IsRetrying" aria-label="Retry network connection">
                @if (IsRetrying)
                {
                    <span class="network-retry-spinner" aria-hidden="true"></span>
                    <span>Retrying…</span>
                }
                else
                {
                    <span>🔄 Retry now</span>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Message { get; set; } = "The royal messenger has lost their way. Please wait while we dispatch another courier.";
    [Parameter] public string StatusText { get; set; } = "Searching for a path to the server...";
    [Parameter] public bool IsRetrying { get; set; }
    [Parameter] public int RetryCount { get; set; }
    /// <summary>Optional callback fired when the operator clicks "Retry now".
    /// When supplied, the button renders; when null, the overlay is purely informational.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }

    private async Task OnRetryClick()
    {
        if (IsRetrying) return;
        await OnRetry.InvokeAsync();
    }
}

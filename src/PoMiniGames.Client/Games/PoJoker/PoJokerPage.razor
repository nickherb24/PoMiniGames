@page "/pojoker"
@page "/pojoker/1player"
@page "/pojoker/demo"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Games.PoJoker.Components
@inject NavigationManager Navigation
@inject GameStatsService GameStats
@inject PoMiniGamesClient.Services.Play.KioskCoordinator Kiosk

<PageTitle>Joker · PoMiniGames</PageTitle>

@* JesterStage reports the finish (OnShowComplete) and the show ends on the same
   centered modal as every other game, with a way back to the menu. *@
<GameShell Title="@TitleContent"
           BackTo="/"
           GameOver="@_showComplete"
           GameKey="pojoker"
           Stats="@_statItems"
           GameSummary="@GameSummaryContent">
    @if (!_introDone)
    {
        <GameIntro CueScope="pojoker"
                   Title="@TitleContent"
                   Objective="The digital Jester performs a 10-joke set — see how many land."
                   Controls="@HowToPlayContent"
                   Mode="@(_isDemo ? GameIntro.IntroMode.Demo : GameIntro.IntroMode.OnePlayer)"
                   OnStart="DismissIntro" />
    }
    <div class="pojoker-root">
        @* The show waits for the intro card to be dismissed. Demo mode starts at once:
           the kiosk has nobody to dismiss anything. *@
        <JesterStage AutoStart="@(_isDemo || _introDone)" Loop="@_isDemo" OnShowComplete="HandleShowComplete" />
    </div>
</GameShell>

@code {
    private static RenderFragment TitleContent => GameCatalog.TitleFor(GameKeys.PoJoker);

    /// <summary>Every show is a fixed 10 jokes (PerformanceOrchestrator's show length).</summary>
    private const int JokesPerShow = 10;

    /// <summary>
    /// True on the /pojoker/demo route — the unattended, watch-only variant. It runs shows
    /// back to back and never raises the end-of-game modal, whose OK button nobody would be
    /// there to press. /pojoker still ends on the modal like every other game.
    /// </summary>
    private bool _isDemo;

    private bool _showComplete;
    private int _triumphs;
    private List<StatItem>? _statItems;

    // Intro/welcome gate. /pojoker/demo gets the 2s auto-clearing flash (nobody
    // is there to press OK); /pojoker gets the same OK-gated controls card as the
    // other nine games. The mode must not be hard-coded to Demo, or a player who
    // chose Joker from the home page would have the card yanked away after two
    // seconds before they could read it.
    private bool _introDone;
    private void DismissIntro()
    {
        _introDone = true;
        // Re-render so the now-changed AutoStart flag re-evaluates inside
        // JesterStage. Without this, AutoStart was already consumed as
        // `false` on first render (intro up) and the show would not start
        // even after dismissal.
        StateHasChanged();
    }

    protected override void OnInitialized() =>
        // Both routes render this page; only /pojoker/demo is the unattended one.
        _isDemo = Navigation.Uri.Contains("/pojoker/demo", StringComparison.OrdinalIgnoreCase);

    protected override void OnAfterRender(bool firstRender)
    {
        // Joker has no win condition and no score, so a session count is the only
        // stat the profile can report for it truthfully. Demo is excluded: the kiosk
        // auto-cycles through every demo game, and counting those would report
        // sessions the player never chose to start.
        //
        // First render rather than OnInitialized: the counter goes through
        // localStorage, and JS interop is only guaranteed available once the
        // component has rendered.
        if (!firstRender || _isDemo) return;
        GameStats.RecordPlay("pojoker");
    }

    private RenderFragment HowToPlayContent => @<div>
        <ul>
            <li>No controls — each joke either lands or bombs with the audience</li>
            <li>Track how many of the 10 jokes triumph</li>
        </ul>
    </div>;

    private RenderFragment GameSummaryContent => @<div>
        <div>Show complete</div>
        <div>The Jester landed @_triumphs of @JokesPerShow.</div>
    </div>;

    private void HandleShowComplete(int triumphs)
    {
        _triumphs = triumphs;
        _statItems =
        [
            new StatItem { Value = triumphs.ToString(), Label = "Triumphs" },
            new StatItem { Value = $"{Math.Round(triumphs * 100.0 / JokesPerShow)}%", Label = "Rate" },
        ];
        _showComplete = true;
        // End-of-set signal for the kiosk reel. Only fired in demo mode — on
        // /pojoker the player is still here and the OK button on GameOverModal
        // owns the next action. Without this the reel waits the full 32s dwell
        // on a finished set.
        if (_isDemo) Kiosk.MarkFinished();
    }
}

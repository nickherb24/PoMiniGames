@page "/posports/multi"
@using PoMiniGames.Shared.Games
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Games.PoSports.Services
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject ApiService Api
@inject ToastService ToastService
@inject PoSportsHubService Hub
@implements IAsyncDisposable

<PageTitle>Sports — Lobby · PoMiniGames</PageTitle>

@* 2026-09-30: the lobby used to sit behind an intro card whose only job was to be
   dismissed — one extra click before the connection even started, and a second,
   hand-typed copy of the controls. The page now connects on arrival and the
   how-to is a fold-out above the roster, rendered from the same PoSportsHowTo the
   race page uses. *@
<GameShell Title="@TitleContent" BackTo="/">
    <div class="ps-lobby">
        <details class="ps-lobby-howto">
            <summary>How to play · up to 4 runners, the host fires the gun</summary>
            <PoSportsHowTo Lead="Two-leg meet: 100m sprint, then 110m hurdles — lowest combined time wins."
                           Players="@HowToKeys" />
        </details>

        @if (CanWatch)
        {
            @* The room refuses seats while a meet is running (and when it is full), so
               an arrival then is a spectator: offer the race instead of a dead lobby. *@
            <p class="ps-lobby-watch">
                No seat free right now — the room is full or a meet is running.
                <a class="sp-btn-secondary" href="@($"/posports/race/{Hub.Lobby.State!.GameCode}?watch=1")">👀 Watch the meet</a>
            </p>
        }

        <LobbyPanel TPlayer="PoSportsLobbyMember"
                    State="@Hub.Lobby.State"
                    LocalConnectionId="@Hub.LobbyConnectionId"
                    ConnectionState="@Hub.Lobby.ConnectionState"
                    MaxPlayersHint="4"
                    StartLabel="Start the Meet"
                    CanStart="@CanStart"
                    CanReady="@IHavePicked"
                    WaitingHint="Waiting for everyone to pick a runner and mark Ready…"
                    PickerTitle="Your runner"
                    OnReady="Hub.ToggleReadyAsync"
                    OnStart="Hub.StartGameAsync"
                    OnLeave="LeaveAsync">
            <PlayerLabel Context="m">
                <span aria-hidden="true">@PoSportsRoster.Emoji(m.Character)</span> @m.DisplayName
            </PlayerLabel>
            <PlayerBadges Context="m">
                @if (string.IsNullOrEmpty(m.Character))
                {
                    <span class="lobby-pill lobby-pill--warn">picking…</span>
                }
            </PlayerBadges>
            <Picker>
                <PoSportsRunnerPicker Selected="@(Hub.Lobby.Me?.Character ?? "")"
                                      TakenBy="TakenBy"
                                      Disabled="@(Hub.Lobby.Me is null)"
                                      OnPick="k => Hub.PickCharacterAsync(k)" />
            </Picker>
        </LobbyPanel>
    </div>
</GameShell>

@code {
    private bool _connected;
    /// <summary>Set by Leave — dispose must not leave twice.</summary>
    private bool _leaving;
    /// <summary>Set when navigating to the race page — that navigation must KEEP our lobby seat.</summary>
    private bool _starting;

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🏃</span> Sports · Multiplayer</span>;

    /// <summary>Online races run on layout 1 — the same labels the race page teaches.</summary>
    private static readonly IReadOnlyList<PoSportsHowTo.Keys> HowToKeys =
        [new("Type", PoSportsLayouts.For(1).Sequence, PoSportsLayouts.For(1).Jump)];

    private bool IHavePicked => !string.IsNullOrEmpty(Hub.Lobby.Me?.Character);

    /// <summary>Connected, the room answered, and we hold no seat in it.</summary>
    private bool CanWatch => _connected && Hub.Lobby.State is not null && Hub.Lobby.Me is null;

    private bool CanStart =>
        Hub.Lobby.State is { } s
        && s.Players.Count > 0
        && s.Players.All(m => !string.IsNullOrEmpty(m.Character))
        && s.Players.All(m => m.ConnectionId == s.HostConnectionId || m.IsReady);

    /// <summary>Who holds a runner, for the picker's "taken" state (null = free, or it is ours).</summary>
    private string? TakenBy(string character)
    {
        var holder = Hub.Lobby.State?.Players.FirstOrDefault(m => m.Character == character);
        return holder is null || holder.ConnectionId == Hub.LobbyConnectionId ? null : holder.DisplayName;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await Api.IsAvailableAsync())
        {
            ToastService.Show("Server unavailable. Try Single Player mode.", ToastType.Error);
            return;
        }
        Hub.Lobby.StateChanged += OnLobbyChanged;
        Hub.Lobby.ConnectionChanged += OnConnectionChanged;
        Hub.Lobby.EventReceived += OnLobbyEvent;
        Hub.Lobby.GameStarted += OnGameStarted;
        await Hub.ConnectLobbyAsync(AuthState.User?.DisplayName ?? "Player", !AuthState.IsAuthenticated);
        _connected = true;
    }

    private void OnLobbyChanged(LobbyState<PoSportsLobbyMember> _) => InvokeAsync(StateHasChanged);
    private void OnConnectionChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState _) => InvokeAsync(StateHasChanged);

    private void OnLobbyEvent(LobbyEvent ev) => ToastService.Show(ev.Message, ev.Kind switch
    {
        "left" => ToastType.Warning,
        "pick-denied" => ToastType.Error,
        _ => ToastType.Info,
    });

    private void OnGameStarted(string code)
    {
        _starting = true;
        Nav.NavigateTo($"/posports/race/{code}");
    }

    private async Task LeaveAsync()
    {
        _leaving = true;
        await Hub.LeaveLobbyAsync();
        Nav.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        Hub.Lobby.StateChanged -= OnLobbyChanged;
        Hub.Lobby.ConnectionChanged -= OnConnectionChanged;
        Hub.Lobby.EventReceived -= OnLobbyEvent;
        Hub.Lobby.GameStarted -= OnGameStarted;
        // The hub service is scoped to the session — the race page reuses it — so nothing
        // here closes the connection and the server never sees a disconnect. Leaving any
        // other way (browser back, a link) must therefore tell the lobby explicitly, or the
        // member lingers holding its character lock. _leaving covers the Leave button, which
        // already left; _starting covers the hop to the race page, where we must STAY seated.
        if (!_leaving && !_starting && _connected)
        {
            await Hub.LeaveLobbyAsync();
        }
    }
}

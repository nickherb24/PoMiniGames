@*
    PoCabinetPaintShop — 4 liveries × 4 colors = 16 swatches, persisted to
    localStorage via Blazored.LocalStorage (the framework's preference per
    Program.cs). Selection flows via two-way binding so the parent page can
    submit the chosen livery alongside the race result.
*@

@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage

<div class="pocabinet-paintshop" aria-label="Customize your car">
    <div class="pocabinet-paintshop__grid" role="radiogroup" aria-label="Pick a paint job">
        @foreach (var (name, hex) in COLORS)
        {
            @foreach (var livery in LIVERIES)
            {
                var isSelected = livery == _selectedLivery && name == _selectedColor;
                var swatchBg = hex;
                // Stripe livery lays the colour over a contrasting base so the
                // pattern reads as a paint job, not a flat swatch.
                var stripeColor = name == "Gold" ? "#fff" : "#fff8";
                var previewBg = livery == "Solid" ? swatchBg
                    : livery == "Stripe" ? $"repeating-linear-gradient(45deg, {swatchBg} 0 6px, {stripeColor} 6px 12px)"
                    : livery == "Block"  ? $"linear-gradient(135deg, {swatchBg} 0 50%, #ffffff22 50% 100%)"
                    /* Split */            : $"linear-gradient(90deg, {swatchBg} 0 50%, #ffffff22 50% 100%)";
                <button type="button"
                        class="pocabinet-swatch @(isSelected ? "pocabinet-swatch--selected" : null)"
                        role="radio"
                        aria-checked="@(isSelected ? "true" : "false")"
                        aria-label="@livery @name"
                        style="--swatch: @previewBg;"
                        @onclick="() => Select(livery, name)">
                </button>
            }
        }
    </div>
</div>

@code {
    private const string StorageKey = "pocabinet.paintshop.v1";

    private static readonly string[] LIVERIES = { "Stripe", "Block", "Split", "Solid" };

    private static readonly (string Name, string Hex)[] COLORS =
    {
        ("Indigo",   "#3470d8"),
        ("Crimson",  "#c0392b"),
        ("Forest",   "#2e7d4f"),
        ("Gold",     "#d4af37"),
    };

    /// <summary>Hex for a paint name — what the car mesh, minimap and the server grid use.</summary>
    public static string HexFor(string? name)
    {
        foreach (var (n, hex) in COLORS)
        {
            if (string.Equals(n, name, StringComparison.OrdinalIgnoreCase)) return hex;
        }
        return COLORS[0].Hex;
    }

    private string _selectedLivery = "Stripe";
    private string _selectedColor = "Indigo";

    /// <summary>The current selection, surfaced so the parent page can submit it with the result.</summary>
    [Parameter] public string? SelectedLivery { get; set; }
    [Parameter] public string? SelectedColor { get; set; }
    [Parameter] public EventCallback<(string Livery, string Color)> SelectionChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await LocalStorage.GetItemAsStringAsync(StorageKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                // Stored value is "<livery>|<color>".
                var parts = saved.Split('|', 2);
                if (parts.Length == 2)
                {
                    _selectedLivery = parts[0];
                    _selectedColor = parts[1];
                }
            }
        }
        catch
        {
            // localStorage unavailable — fall back to defaults.
        }
        SelectedLivery = _selectedLivery;
        SelectedColor = _selectedColor;
    }

    private async Task Select(string livery, string color)
    {
        _selectedLivery = livery;
        _selectedColor = color;
        SelectedLivery = livery;
        SelectedColor = color;
        await PersistAsync();
        await SelectionChanged.InvokeAsync((livery, color));
    }

    private async Task PersistAsync()
    {
        try
        {
            await LocalStorage.SetItemAsStringAsync(StorageKey, $"{_selectedLivery}|{_selectedColor}");
        }
        catch
        {
            // ignore — in-memory fallback for the rest of the session
        }
    }
}
@* PoCabinetSettingsPanel — audio / accessibility / environment prefs and driver aids.
   Bound two-way via Value + ValueChanged; persistence and JS-side application
   (Web Audio gains, aids, racing line) are the page's job — this component only
   edits the view model and raises the change. Native Blazor + design tokens,
   no Radzen. Render quality and FOV are gone (2026-09-29): scene.js picks the
   quality tier from the measured frame rate.

   Compact (the pause overlay): the three audio rows up front, everything else
   folded under "More settings", so pausing doesn't open a 15-row form. *@

<div class="pocabinet-settings" role="group" aria-label="Cabinet settings">
    <div class="pocabinet-settings__row">
        <label for="pocabinet-vol">Master volume</label>
        <input id="pocabinet-vol" type="range" min="0" max="1" step="0.05"
               value="@Format(Value.MasterVolume)" @oninput="OnVolumeChanged" />
        <span class="pocabinet-settings__value">@($"{Value.MasterVolume:0%}")</span>
    </div>

    <div class="pocabinet-settings__row">
        <label for="pocabinet-mute">Mute all audio</label>
        <input id="pocabinet-mute" type="checkbox" checked="@Value.Muted" @onchange="OnMuteChanged" />
    </div>

    <div class="pocabinet-settings__row">
        <label for="pocabinet-music">Race music</label>
        <input id="pocabinet-music" type="checkbox" checked="@Value.Music" @onchange="OnMusicChanged" />
    </div>

    @if (Compact)
    {
        <details class="pocabinet-settings__more">
            <summary>More settings</summary>
            @Rest
        </details>
    }
    else
    {
        @Rest
    }
</div>

@code {
    [Parameter] public PoCabinetUiSettings Value { get; set; } = new();
    [Parameter] public EventCallback<PoCabinetUiSettings> ValueChanged { get; set; }
    /// <summary>Pause overlay: audio rows only, the rest behind "More settings".</summary>
    [Parameter] public bool Compact { get; set; }

    private RenderFragment Rest => @<div class="pocabinet-settings__rest">
        <div class="pocabinet-settings__row">
            <label for="pocabinet-hud">HUD size</label>
            <select id="pocabinet-hud" value="@Format(Value.HudScale)" @onchange="OnHudScaleChanged">
                <option value="0.85">Small</option>
                <option value="1">Normal</option>
                <option value="1.15">Large</option>
            </select>
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-weather">Weather</label>
            <select id="pocabinet-weather" value="@Value.Weather" @onchange="OnWeatherChanged">
                <option value="clear">Clear</option>
                <option value="rain">Rain (slippery, solo)</option>
                <option value="auto">Live (Washington D.C.)</option>
            </select>
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-motion">Reduced motion (confetti, rain density)</label>
            <input id="pocabinet-motion" type="checkbox" checked="@Value.ReducedMotion" @onchange="OnReducedMotionChanged" />
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-colorsafe">Colorblind-safe minimap palette</label>
            <input id="pocabinet-colorsafe" type="checkbox" checked="@Value.ColorSafe" @onchange="OnColorSafeChanged" />
        </div>

        <h3 class="pocabinet-settings__group">Controls &amp; driver aids</h3>
        <p class="pocabinet-settings__hint">Keyboard: W A S D or arrows, C changes camera, Esc pauses. Gamepads work too: left stick steers, the triggers are gas and brake.</p>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-touch">On-screen touch controls</label>
            <select id="pocabinet-touch" value="@Value.TouchControls" @onchange="OnTouchChanged">
                <option value="auto">Auto (touch screens)</option>
                <option value="on">Always show</option>
                <option value="off">Hide</option>
            </select>
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-steermode">Touch steering</label>
            <select id="pocabinet-steermode" value="@Value.SteerMode" @onchange="OnSteerModeChanged">
                <option value="pad">Steer pad</option>
                <option value="tilt">Tilt the device</option>
            </select>
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-sens">Steering sensitivity</label>
            <input id="pocabinet-sens" type="range" min="0.5" max="1.5" step="0.05"
                   value="@Format(Value.SteerSensitivity)" @oninput="OnSensitivityChanged" />
            <span class="pocabinet-settings__value">@($"{Value.SteerSensitivity:0.00}×")</span>
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-assist">Steering assist</label>
            <select id="pocabinet-assist" value="@Value.SteeringAssist" @onchange="OnAssistChanged">
                <option value="off">Off</option>
                <option value="light">Light</option>
                <option value="strong">Strong</option>
            </select>
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-autobrake">Auto-brake for corners</label>
            <input id="pocabinet-autobrake" type="checkbox" checked="@Value.AutoBrake" @onchange="OnAutoBrakeChanged" />
        </div>

        <div class="pocabinet-settings__row">
            <label for="pocabinet-line">Show racing line (green = flat out, red = brake)</label>
            <input id="pocabinet-line" type="checkbox" checked="@Value.RacingLine" @onchange="OnRacingLineChanged" />
        </div>
    </div>;

    private static string Format(double d) =>
        d.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private async Task RaiseAsync(Action<PoCabinetUiSettings> mutate)
    {
        mutate(Value);
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
    }

    private Task OnVolumeChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.MasterVolume = ParseDouble(e.Value?.ToString(), s.MasterVolume));

    private Task OnMuteChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.Muted = e.Value is bool b && b);

    private Task OnMusicChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.Music = e.Value is bool b && b);

    private Task OnHudScaleChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.HudScale = ParseDouble(e.Value?.ToString(), s.HudScale));

    private Task OnWeatherChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.Weather = e.Value?.ToString() ?? s.Weather);

    private Task OnReducedMotionChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.ReducedMotion = e.Value is bool b && b);

    private Task OnColorSafeChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.ColorSafe = e.Value is bool b && b);

    private Task OnTouchChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.TouchControls = e.Value?.ToString() ?? s.TouchControls);

    private Task OnSteerModeChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.SteerMode = e.Value?.ToString() ?? s.SteerMode);

    private Task OnSensitivityChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.SteerSensitivity = ParseDouble(e.Value?.ToString(), s.SteerSensitivity));

    private Task OnAssistChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.SteeringAssist = e.Value?.ToString() ?? s.SteeringAssist);

    private Task OnAutoBrakeChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.AutoBrake = e.Value is bool b && b);

    private Task OnRacingLineChanged(ChangeEventArgs e) =>
        RaiseAsync(s => s.RacingLine = e.Value is bool b && b);

    private static double ParseDouble(string? raw, double fallback) =>
        double.TryParse(raw, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : fallback;
}

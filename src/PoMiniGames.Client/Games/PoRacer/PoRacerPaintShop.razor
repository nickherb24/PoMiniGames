@using PoMiniGames.Shared.Games
@inject IJSRuntime JS

@* One row: the car, six swatches, four liveries. The preview is drawn by the race renderer's own
   car painter (PoRacer.preview), so a livery looks here exactly as it will on track; it used to
   be a second, hand-kept SVG copy of the same four patterns. *@
<div class="racer-paintshop" role="group" aria-label="Car paint">
    <canvas id="racerPaintPreview" class="paint-preview" width="144" height="96" role="img"
            aria-label="Car preview: @CurrentColorName, @CurrentLiveryName"></canvas>
    <div class="paint-swatches" role="radiogroup" aria-label="Body color">
        @foreach (var color in Swatches)
        {
            <label class="paint-swatch @(Customization.ColorHex == color.Hex ? "selected" : "")" title="@color.Name" style="--swatch: @color.Hex">
                <input type="radio" name="poracer-color" aria-label="@color.Name" checked="@(Customization.ColorHex == color.Hex)" @onchange="() => SaveAsync(Customization with { ColorHex = color.Hex })" />
            </label>
        }
    </div>
    <div class="racer-chips" role="radiogroup" aria-label="Livery">
        @foreach (var livery in Liveries)
        {
            <label><input type="radio" name="poracer-livery" checked="@(Customization.LiveryPattern == livery.Key)" @onchange="() => SaveAsync(Customization with { LiveryPattern = livery.Key })" />@livery.Name</label>
        }
    </div>
</div>
@code {
    [Parameter] public PoRacerCarCustomization Customization { get; set; } = PoRacerCarCustomization.Default;
    [Parameter] public EventCallback<PoRacerCarCustomization> CustomizationChanged { get; set; }
    /// <summary>The preview is drawn by the engine module, so there is nothing to draw until it has loaded.</summary>
    [Parameter] public bool EngineReady { get; set; }

    private record Swatch(string Name, string Hex);
    private static readonly Swatch[] Swatches = [new("Cyan", "#00f0ff"), new("Pink", "#ff007f"), new("Green", "#00ff66"), new("Gold", "#ffaa00"), new("Red", "#ff3333"), new("Purple", "#aa00ff")];
    private record LiveryOption(string Key, string Name);
    private static readonly LiveryOption[] Liveries = [new("stripe", "Classic"), new("dual", "Twin GT"), new("carbon", "Carbon"), new("neon", "Neon")];
    private string CurrentColorName => Swatches.FirstOrDefault(s => s.Hex == Customization.ColorHex)?.Name ?? "Custom";
    private string CurrentLiveryName => Liveries.FirstOrDefault(l => l.Key == Customization.LiveryPattern)?.Name ?? "Classic";
    private PoRacerCarCustomization? _drawn;

    private Task SaveAsync(PoRacerCarCustomization customization)
    {
        PoRacerPreferences.SaveCustomization(customization);
        return CustomizationChanged.InvokeAsync(customization);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!EngineReady || _drawn == Customization) return;
        _drawn = Customization;
        // The nose half is shaded with the body colour at 35%, the same rule the server uses for
        // every car's ColorDark.
        var hex = Customization.ColorHex;
        var dark = "#" + string.Concat(new[] { 1, 3, 5 }.Select(i => ((int)(Convert.ToInt32(hex.Substring(i, 2), 16) * 0.35)).ToString("X2")));
        try { await JS.InvokeVoidAsync("PoRacer.preview", "racerPaintPreview", hex, dark, Customization.LiveryPattern); }
        catch (JSException) { _drawn = null; }
    }
}

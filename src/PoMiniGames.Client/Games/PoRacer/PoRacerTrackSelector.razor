@using System.Globalization
@using PoMiniGames.Shared.Games
<fieldset class="track-picker" disabled="@Disabled">
    <legend>Track</legend>
    @foreach (var track in PoRacerCatalog.Tracks)
    {
        var best = Bests.GetValueOrDefault(track.Id);
        <label class="track-card @(SelectedTrackId == track.Id ? "selected" : "")" title="@track.Description">
            <input type="radio" name="poracer-track" value="@track.Id" checked="@(SelectedTrackId == track.Id)"
                   @onchange="() => SelectedTrackIdChanged.InvokeAsync(track.Id)" />
            <svg class="track-outline" viewBox="0 0 100 60" aria-hidden="true"><path d="@Outline(track)" /></svg>
            <span class="track-text">
                <strong>@track.Name</strong>
                <small>@track.Description</small>
                <span class="track-best">
                    @if (best > 0)
                    {
                        <span>Your best <b>@PoRacerFormatting.Time(best)</b> @PoRacerFormatting.MedalLabel(track.Medal(best))</span>
                    }
                    <span class="track-medals" title="Best-lap targets, in seconds">🥇 @Seconds(track.Gold) · 🥈 @Seconds(track.Silver) · 🥉 @Seconds(track.Bronze)</span>
                </span>
            </span>
        </label>
    }
</fieldset>
@code {
    [Parameter] public string SelectedTrackId { get; set; } = PoRacerCatalog.DefaultTrackId;
    [Parameter] public EventCallback<string> SelectedTrackIdChanged { get; set; }
    /// <summary>Personal best lap per track id (seconds); a track with no lap yet is simply absent.</summary>
    [Parameter] public IReadOnlyDictionary<string, double> Bests { get; set; } = new Dictionary<string, double>();
    /// <summary>Shown but not changeable: the Online tab for everyone except the host.</summary>
    [Parameter] public bool Disabled { get; set; }

    private static readonly Dictionary<string, string> Outlines = [];
    private static string Seconds(double lap) => lap.ToString("0.0", CultureInfo.InvariantCulture);

    /// <summary>
    /// The track's shape as an SVG path, from the same spline knots the server builds the
    /// circuit from (Catmull-Rom through the knots, written as the equivalent cubic Béziers),
    /// fitted to the 100 x 60 view box.
    /// </summary>
    private static string Outline(PoRacerTrackInfo track)
    {
        if (Outlines.TryGetValue(track.Id, out var cached)) return cached;
        var k = track.Knots;
        double minX = k.Min(p => p.X), maxX = k.Max(p => p.X), minY = k.Min(p => p.Y), maxY = k.Max(p => p.Y);
        var scale = Math.Min(88 / (maxX - minX), 48 / (maxY - minY));
        double ox = 50 - (minX + maxX) / 2 * scale, oy = 30 - (minY + maxY) / 2 * scale;
        string P(double x, double y) => FormattableString.Invariant($"{x * scale + ox:0.#} {y * scale + oy:0.#}");
        var path = new System.Text.StringBuilder("M" + P(k[0].X, k[0].Y));
        for (var i = 0; i < k.Count; i++)
        {
            var p0 = k[(i - 1 + k.Count) % k.Count]; var p1 = k[i];
            var p2 = k[(i + 1) % k.Count]; var p3 = k[(i + 2) % k.Count];
            path.Append(" C").Append(P(p1.X + (p2.X - p0.X) / 6, p1.Y + (p2.Y - p0.Y) / 6))
                .Append(',').Append(P(p2.X - (p3.X - p1.X) / 6, p2.Y - (p3.Y - p1.Y) / 6))
                .Append(',').Append(P(p2.X, p2.Y));
        }
        return Outlines[track.Id] = path.Append('Z').ToString();
    }
}

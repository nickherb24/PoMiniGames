@page "/couplequiz/game"
@using PoMiniGamesClient.Games.PoCoupleQuiz.Services
@using PoMiniGamesClient.Components
@inject CoupleQuizHubService Hub
@inject PlayerNameService PlayerNameService
@inject MatchHistoryService MatchHistory
@inject GameResultService GameResults
@implements IAsyncDisposable

@* The match ends on the shared end-of-game modal every other game uses, with the
   match's final scores as the summary and the game's all-time top 3 underneath.

   There is no host-driven "Next round" button and no client-side tally of who has
   answered: the server knows when a round is complete and scores and advances on its
   own the moment everyone has answered, or when the round clock expires. Non-hosts
   never wait on the host, and a host who closes their tab mid-match cannot strand the
   rest of the lobby. *@
<PageTitle>Couple Quiz — Online · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent Player="@_playerName" BackTo="/"
           GameOver="@(_phase == Phase.GameOver)"
           GameKey="pocouplequiz"
           Announcement="@_announcement"
           GameSummary="@GameSummaryContent">
    @if (_game is null)
    {
        @* If the player landed on /game without ever joining a lobby (deep-link,
           refresh mid-game, or wrong navigation), the page would spin forever on
           "Waiting for the round to start…". After a short grace period, route
           them back to the lobby so they understand what happened. *@
        @if (_showLobbyHint)
        {
            <div class="cq-gameover">
                <h2 class="gps-phase-h">You haven't joined a game yet</h2>
                <p>This page is only useful mid-round. Join the lobby and the match starts once everyone is ready.</p>
                <a class="app-btn app-btn--primary" href="/couplequiz">Go to the lobby →</a>
            </div>
        }
        else
        {
            <p>Waiting for the round to start…</p>
        }
    }
    else
    {
        <div class="cq-game">
            <h2 class="gps-phase-h">Round @(_roundIndex + 1) of @_maxRounds</h2>

            @if (_isKing)
            {
                <p class="cq-king">👑 You are the King this round. Type your secret answer — the others try to match it.</p>
            }
            else
            {
                <p class="cq-king">👑 <strong>@_kingName</strong> is the King. Guess the answer they typed.</p>
            }

            <p class="cq-question">@_question</p>

            @if (_phase == Phase.Answering)
            {
                <input @bind="_myAnswer"
                       @bind:event="oninput"
                       placeholder="@(_isKing ? "Your secret answer (1-2 words)" : "Your guess")"
                       maxlength="60"
                       disabled="@_submitted" />
                <div class="cq-actions">
                    <button class="app-btn app-btn--primary"
                            @onclick="Submit"
                            disabled="@(_submitted || string.IsNullOrWhiteSpace(_myAnswer))">
                        @(_submitted ? "Submitted ✓" : "Submit")
                    </button>
                </div>
                @if (_submitted)
                {
                    <p class="cq-hint">Waiting for the others… the round scores itself when everyone is in.</p>
                }
            }

            @if (_phase == Phase.Results && _lastResult is not null)
            {
                <div class="cq-results">
                    <h3>Round result</h3>
                    <p>King's answer: <strong>@_lastResult.KingAnswer</strong></p>
                    <p>
                        @(_lastResult.MatchedPlayers.Count > 0
                            ? $"Matched: {string.Join(", ", _lastResult.MatchedPlayers)}"
                            : "Nobody matched this round.")
                    </p>
                    <h4>Scores</h4>
                    <ul>
                        @foreach (var kv in _lastResult.Scores.OrderByDescending(x => x.Value))
                        {
                            <li>@kv.Key — @kv.Value</li>
                        }
                    </ul>
                    <p class="cq-hint">Next question coming up…</p>
                </div>
            }
        </div>
    }
</GameShell>

@code {
    private enum Phase { Answering, Results, GameOver }

    private RenderFragment TitleContent => @<span><span aria-hidden="true">💕</span> Couple Quiz</span>;

    // This match's final scores, highest first. The all-time top 3 is rendered
    // separately by GameShell from GameKey.
    private RenderFragment GameSummaryContent => @<div>
        <div>Final scores</div>
        @foreach (var kv in (_gameOver?.FinalScores ?? new Dictionary<string, int>()).OrderByDescending(x => x.Value))
        {
            <div>@kv.Key — <strong>@kv.Value</strong></div>
        }
    </div>;

    private string _playerName = string.Empty;
    private string _myAnswer = string.Empty;
    private bool _isKing;
    private bool _submitted;
    private string _kingName = string.Empty;
    private Phase _phase = Phase.Answering;
    private string _question = string.Empty;
    private int _roundIndex;
    private int _maxRounds;
    private string? _announcement;
    private CoupleQuizGameStartedPayload? _game;
    private CoupleQuizRoundResultPayload? _lastResult;
    private CoupleQuizGameOverPayload? _gameOver;

    // If no game starts within 4s of landing here, show
    // the lobby redirect hint instead of an infinite spinner.
    private bool _showLobbyHint;
    private CancellationTokenSource? _lobbyHintCts;

    protected override async Task OnInitializedAsync()
    {
        _playerName = PlayerNameService.GetPlayerName();
        Hub.OnGameStarted += HandleGameStarted;
        Hub.OnRoundStarted += HandleRoundStarted;
        Hub.OnRoundResult += HandleRoundResult;
        Hub.OnGameOver += HandleGameOver;
        Hub.OnGameError += HandleGameError;
        try
        {
            await Hub.ConnectAsync();
        }
        catch
        {
            // If the hub isn't connected we just sit at "waiting for round to start".
        }

        // GameStarted fired while the lobby was still mounted (it drove the navigation
        // here), so we won't see it as a live event. Hydrate from the buffered payload.
        if (Hub.LastGameStarted is not null)
        {
            HandleGameStarted(Hub.LastGameStarted);
        }

        _lobbyHintCts = new CancellationTokenSource();
        _ = WatchForLobbyHintAsync(_lobbyHintCts.Token);
    }

    private async Task WatchForLobbyHintAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), ct);
            if (_game is null && !ct.IsCancellationRequested)
            {
                _showLobbyHint = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { /* expected when the game starts */ }
    }

    // SignalR `.On` callbacks run outside Blazor's render loop, so each handler marshals
    // a StateHasChanged onto the renderer's context to repaint. (HandleGameStarted is also
    // invoked synchronously from OnInitializedAsync for the buffered payload — harmless there.)
    private void HandleGameStarted(CoupleQuizGameStartedPayload p)
    {
        _game = p;
        _maxRounds = p.MaxRounds;
        BeginRound(p.RoundIndex, p.KingPlayerName, p.QuestionText);
    }

    private void HandleRoundStarted(CoupleQuizRoundStartedPayload p)
    {
        _maxRounds = p.MaxRounds;
        _lastResult = null; // clear the previous round's result
        BeginRound(p.RoundIndex, p.KingPlayerName, p.QuestionText);
    }

    private void BeginRound(int roundIndex, string kingName, string question)
    {
        _roundIndex = roundIndex;
        _kingName = kingName;
        // The King seat rotates every round, so this is re-evaluated each time rather
        // than fixed at game start.
        _isKing = string.Equals(_playerName, kingName, StringComparison.Ordinal);
        _question = question;
        _phase = Phase.Answering;
        _myAnswer = string.Empty;
        _submitted = false;
        _announcement = _isKing
            ? $"Round {roundIndex + 1}. You are the King. {question}"
            : $"Round {roundIndex + 1}. {kingName} is the King. {question}";
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleRoundResult(CoupleQuizRoundResultPayload p)
    {
        _lastResult = p;
        _phase = Phase.Results;
        _announcement = p.MatchedPlayers.Contains(_playerName)
            ? $"You matched. The answer was {p.KingAnswer}."
            : $"No match. The answer was {p.KingAnswer}.";
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleGameOver(CoupleQuizGameOverPayload p)
    {
        _gameOver = p;
        _phase = Phase.GameOver;
        _announcement = "The match is over.";
        _ = InvokeAsync(StateHasChanged);
        _ = RecordOutcomesAsync(p);
    }

    private void HandleGameError(string message)
    {
        _announcement = message;
        Console.Error.WriteLine($"[PoCoupleQuiz] {message}");
        _ = InvokeAsync(StateHasChanged);
    }

    // Record a head-to-head result against every other player, scored by final points.
    private async Task RecordOutcomesAsync(CoupleQuizGameOverPayload p)
    {
        _lobbyHintCts?.Cancel();
        _lobbyHintCts?.Dispose();
        _lobbyHintCts = null;

        // Every player is on the scoreboard now. This used to bail here for the King,
        // who was excluded from FinalScores entirely and so finished every match with no
        // match-history row and no profile result.
        if (!p.FinalScores.TryGetValue(_playerName, out var myScore)) return;

        foreach (var (name, score) in p.FinalScores)
        {
            if (name == _playerName) continue;
            var outcome = myScore > score ? MatchOutcome.Win
                        : myScore < score ? MatchOutcome.Loss
                        : MatchOutcome.Draw;
            await MatchHistory.RecordAsync("pocouplequiz", MatchMode.Multiplayer, name, outcome);
        }

        // The head-to-head rows above are per-opponent; the profile's W/L record is
        // per-game. Record exactly one outcome for the match as a whole, or a 4-player
        // game would post three results and treble this game's weight on the profile.
        // Placement against the whole field: top score wins, tied-for-top draws.
        var best = p.FinalScores.Values.Max();
        var overall = myScore < best ? GameResult.Loss
                    : p.FinalScores.Count(kv => kv.Value == best) > 1 ? GameResult.Draw
                    : GameResult.Win;

        // RecordAndSyncStatsAsync, not RecordAsync: the local-only write left the server's
        // PoCoupleQuiz board with nothing in it, which is why that leaderboard showed
        // placeholder rows forever. Difficulty.Medium is the single stats bucket this
        // game uses — it has no difficulty setting, only a round count.
        await GameResults.RecordAndSyncStatsAsync("pocouplequiz", _playerName, Difficulty.Medium, overall);
    }

    private async Task Submit()
    {
        if (_game is null || _submitted || string.IsNullOrWhiteSpace(_myAnswer)) return;
        _submitted = true;
        await Hub.SubmitAnswerAsync(_myAnswer.Trim());
    }

    // Detach handlers only — the scoped hub service (shared with the lobby) owns the
    // SignalR connection; disposing it here would kill it for any later navigation.
    public ValueTask DisposeAsync()
    {
        _lobbyHintCts?.Cancel();
        _lobbyHintCts?.Dispose();
        _lobbyHintCts = null;
        Hub.OnGameStarted -= HandleGameStarted;
        Hub.OnRoundStarted -= HandleRoundStarted;
        Hub.OnRoundResult -= HandleRoundResult;
        Hub.OnGameOver -= HandleGameOver;
        Hub.OnGameError -= HandleGameError;
        return ValueTask.CompletedTask;
    }
}

@page "/pobrawl"
@page "/pobrawl/{Mode}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@* Aliases, not namespace imports: PoMiniGamesClient.Models mirrors Domain types by
   name (PlayerStats), so importing either namespace wholesale makes them ambiguous.
   Same convention as ApiService.cs. *@
@using PoBrawlFighter = PoMiniGames.Domain.Primitives.PoBrawlFighter
@using PoBrawlRoster = PoMiniGames.Domain.Primitives.PoBrawlRoster
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameService
@inject ApiService ApiService
@inject GameResultService GameResults
@inject IJSRuntime JSRuntime
@inject KioskCoordinator Kiosk
@inject SettingsService Settings
@inject AuthStateService Auth
@inject ApiEndpoints Endpoints
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Brawl · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           Elo="@(_mode == "1p" ? _rating.Elo : (int?)null)"
           BackTo="@(_mode == "online" ? LobbyUrl : "/")"
           Stats="@_statItems"
           GameOver="@(_phase == "result" && !_demo)"
           GameKey="@(_mode == "1p" ? "pobrawlko" : null)"
           Outcome="@OutcomeForCue"
           RequiresWebGl="true"
           GameSummary="@GameSummaryContent"
           PlayAgain="@PlayAgainCallback"
           Announcement="@_announcement">
    @if (!_introDone)
    {
        <GameIntro CueScope="pobrawl"
                   Title="@TitleContent"
                   Objective="@IntroObjective"
                   Controls="@IntroControlsContent"
                   Mode="@_introMode"
                   Options="@IntroOptions"
                   StartEnabled="true"
                   StartHint="@null"
                   DialogLabel="@IntroDialogLabel"
                   CaptureKeys="false"
                   OnKey="OnIntroKey"
                   OnStart="OnIntroStartAsync" />
    }
    <div class="pb-wrap">
        @* Labelled host — see the note on PoSports (browser audit #6): the engine
           appends its <canvas> here, so this is the only node this component can
           attach an accessible name to. *@
        <div id="pobrawl-container" class="pb-canvas-host"
             role="img" aria-label="Brawl arena — the fight renders here"></div>

        @* Two-bar HUD, fed by the JS engine's OnHud callback: health, then energy.
           The third bar (violet super meter) was removed 2026-08-11 — signature
           moves still fire, they just fire themselves now. See _autoSuperReady in
           game.js and the note on SuperBar's removal below. *@
        @if (_phase == "fighting" || _demo)
        {
            <div class="pb-hud">
                @* GFX/SOUND #1 (2026-09-23): the ghost is the damage chip — a pale bar under the
                   fill that holds the old value for a beat and then drains to meet it, so every
                   hit shows how much it took. Pure CSS (a delayed width transition on the same
                   --hp); the 4×/sec OnHud pump needs no extra data. InDanger cracks the plate. *@
                <div class="pb-hp-side @(InDanger(_p1Hp) ? "pb-hp-side--danger" : "")">
                    <span class="pb-hp-name">@HudName(1)</span>
                    @* Review #5: the tracks are real meters now — a screen reader can
                       query either bar on demand (role=meter carries the value range)
                       without waiting for the sparse live-region milestones. *@
                    <div class="pb-hp-track" role="meter" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@_p1Hp" aria-label="@CharName(_p1Char) — health">
                        <div class="pb-hp-ghost" style="--hp: @(_p1Hp)%;"></div><div class="pb-hp-fill pb-hp-p1" style="--hp: @(_p1Hp)%;"></div>
                    </div>
                    <div class="pb-en-track" role="meter" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@_p1Energy" aria-label="@CharName(_p1Char) — energy" title="@EnergyTip">
                        <div class="pb-en-fill @EnergyClass(_p1Energy)" style="--en: @(_p1Energy)%;"></div>
                    </div>
                </div>
                @BodyDiagram(_p1Regions)
                <div class="pb-centre">
                    @* Counts DOWN from the 60 s limit (game.js TIME_LIMIT). The
                       best-of-three pip scoreboard that used to sit under it went
                       with the rounds themselves — every mode is one round now. *@
                    <div class="pb-clock" title="@(InTraining ? "Training — no clock" : "Seconds remaining — the round ends at 0")">@(InTraining ? "∞" : _elapsed.ToString("0"))</div>
                </div>
                @BodyDiagram(_p2Regions)
                <div class="pb-hp-side pb-hp-right @(InDanger(_p2Hp) ? "pb-hp-side--danger" : "")">
                    <span class="pb-hp-name">@HudName(2)</span>
                    <div class="pb-hp-track" role="meter" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@_p2Hp" aria-label="@CharName(_p2Char) — health">
                        <div class="pb-hp-ghost" style="--hp: @(_p2Hp)%;"></div><div class="pb-hp-fill pb-hp-p2" style="--hp: @(_p2Hp)%;"></div>
                    </div>
                    <div class="pb-en-track" role="meter" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@_p2Energy" aria-label="@CharName(_p2Char) — energy" title="@EnergyTip">
                        <div class="pb-en-fill @EnergyClass(_p2Energy)" style="--en: @(_p2Energy)%;"></div>
                    </div>
                </div>
            </div>

            @* 1-player ladder rail. The rung is persisted in localStorage and was
               otherwise invisible until the end-of-run modal, so a player mid-gauntlet
               had no way to see how far through the fifteen presidents they were —
               the pre-fight ladder card that used to carry it was removed in 2026-07.
               Rendered outside .pb-hud so it can sit under the bars without competing
               with them for the same flex row. *@
            @if (_mode == "1p" && !_training)
            {
                <div class="pb-ladder" role="img"
                     aria-label="Ladder progress: @_ladder of @Roster.Length presidents beaten. Now fighting @CharName(_p2Char).">
                    <span class="pb-ladder-count">@_ladder/@Roster.Length</span>
                    <span class="pb-ladder-rail">
                        @for (var i = 0; i < Roster.Length; i++)
                        {
                            <span class="pb-rung @(i < _ladder ? "pb-rung--done" : i == _ladder ? "pb-rung--now" : "")"
                                  title="@Roster[i].Name"></span>
                        }
                    </span>
                    <span class="pb-ladder-now">@CharName(_p2Char)</span>
                </div>
            }
        }

        @if (_demo)
        {
            <div class="pb-demo-badge">@(_drill ? "🥋 Demo — training drill" : "🎮 Demo — CPU vs CPU")</div>
        }

        @* Online: the room, your corner, and anything the network is doing to the fight. *@
        @if (_mode == "online")
        {
            @if (_netMissing)
            {
                <div class="pb-net-missing" role="status">
                    <h2>No fight in room @_code</h2>
                    <p>It already ended, or it never started. The lobby has the room.</p>
                    <a class="pb-net-btn" href="@LobbyUrl">Back to the lobby</a>
                </div>
            }
            else if (_net?.Snapshot is { } snap)
            {
                <div class="pb-net-status" role="status">
                    <span class="pb-net-pill">Room @_code</span>
                    <span class="pb-net-pill @(snap.IsSpectator ? "pb-net-pill--watch" : "")">
                        @(snap.IsSpectator ? "👀 Spectating" : $"You: {(snap.LocalSide == PoMiniGames.Shared.Games.PoBrawlSide.Player1 ? "left" : "right")} corner")
                    </span>
                    @if (NetNotice is { } notice)
                    {
                        <span class="pb-net-pill pb-net-pill--warn">@notice</span>
                    }
                </div>
            }
            else
            {
                <div class="pb-net-status" role="status"><span class="pb-net-pill">Joining room @_code…</span></div>
            }
        }

        @* Training (1P). The OPTION lives on the intro card ("Training first",
           checked before Start); once the room is up this bar carries the dummy
           mode, the wireframes, infinite energy, the reset — and the exit back
           to the ladder. mousedown:preventDefault keeps a clicked control from
           taking focus — the fight reads keys off window, and a focused button
           would turn the next Space or Enter into a second click. *@
        @if (_training)
        {
            <div class="pb-trainbar" role="group" aria-label="Training dummy" @onmousedown:preventDefault="true">
                <span class="pb-trainbar-label">Dummy</span>
                @foreach (var (id, label, tip) in DummyModes)
                {
                    <button type="button" class="pb-seg @(id == _dummy ? "pb-seg--on" : "")" aria-pressed="@(id == _dummy ? "true" : "false")"
                            title="@tip" @onclick="() => SetDummyAsync(id)">@label</button>
                }
                <label class="pb-trainbar-toggle">
                    <input type="checkbox" checked="@_hitboxes" @onchange="e => TrainingToggleAsync(HitboxesKey, e)" /> Hitboxes
                </label>
                <label class="pb-trainbar-toggle">
                    <input type="checkbox" checked="@_infiniteEnergy" @onchange="e => TrainingToggleAsync(InfiniteEnergyKey, e)" /> ∞ Energy
                </label>
                <button type="button" class="pb-seg" title="Put both fighters back on their marks"
                        @onclick="ResetTrainingAsync">↺ Reset</button>
                <button type="button" class="pb-seg pb-seg--ladder"
                        title="@($"Leave training and fight {CharName(_p2Char)} for the rung")"
                        @onclick="LeaveTrainingAsync">⬅ Back to the ladder</button>
            </div>
        }
        @* 2026-07-16: the pre-fight overlay (presidential ladder card in 1P,
           fighter picker in 2P, both gated behind a "FIGHT" button) was removed.
           It sat between the home page and the game and configured what the page
           can decide itself: 1P always fights the player's current ladder rung,
           and 2P now gets two random fighters the way demo mode already did.
           The "Fastest KO" / "Ladder Legends" boards it hosted are superseded by
           the top 3 in the shared end-of-game modal. *@
    </div>

</GameShell>

@code {
    /// <summary>Route mode segment. Parsed by <see cref="GameModes.Parse"/>, which
    /// owns every accepted spelling and legacy form — see GameMode.cs.</summary>
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; }
    /// <summary>Online: the room code of the fight (from the lobby, a shared link, or a refresh).</summary>
    [SupplyParameterFromQuery(Name = "code")] public string? CodeQuery { get; set; }

    // 1-player ladder: PoBrawlRoster.Fighters in ladder order — most recent president first,
    // marching back in time to FDR. Rung index doubles as the CPU difficulty level (index + 1
    // → 1-15, the full range ai.js LEVELS/MAX_RUNG defines); the ladder walks every fighter.
    //
    // Projected from the Domain roster rather than restated here. The same fifteen names used
    // to live in this file AND in PoBrawlRoster, so a rename could leave the HUD and the Elo
    // board labelling the same fighter two different ways on one screen. fighters.js
    // CHARACTERS is now the only copy left to keep in step by hand.
    private static readonly PoBrawlFighter[] Roster = [.. PoBrawlRoster.Fighters];

    private static readonly PoBrawlFighter Bob = PoBrawlRoster.Bob;

    // 2-player select can pick anyone, BOB included — he is deliberately not on the rateable
    // roster (see PoBrawlRoster), which is why he is prepended rather than sorted in.
    private static readonly PoBrawlFighter[] PickableRoster = [Bob, .. Roster];

    // Fixed rating per ladder rung for the ELO math: rung 1 (Trump) is a
    // pushover at 800; rung 15 (FDR) tops out near 2660. Beating an easy rung
    // when your rating is high earns almost nothing; losing to it costs a lot.
    private static int PresidentElo(int rung) => 800 + rung * 133;

    private string _playerName = "";
    private bool _demo;
    private string _mode = "1p";

    // Outcome for the end-of-game cue. _winner is 1 for the local player and 2
    // for the opponent; only the 1P ladder has a "you" to win, so 2-player and
    // demo stay Unknown (see GameOverModal.Outcome).
    private GameResult OutcomeForCue => _mode == "online"
        ? _netResult?.Outcome switch
        {
            PoMiniGames.Shared.Games.PoBrawlOutcome.Win => GameResult.Win,
            PoMiniGames.Shared.Games.PoBrawlOutcome.Loss => GameResult.Loss,
            PoMiniGames.Shared.Games.PoBrawlOutcome.Draw => GameResult.Draw,
            _ => GameResult.InProgress,
        }
        : _mode != "1p"
        ? GameResult.InProgress
        : _winner == 1 ? GameResult.Win
        : _winner == 2 ? GameResult.Loss
        : GameResult.InProgress;


    // ── Intro/welcome gate ──
    // The fight does not start until the intro card is dismissed: OK in 1P, a 2s
    // flash in demo, and in 2P once both players lock in their fighter with their
    // own keyboard halves (P1: A/D + F, P2: ←/→ + K — mirroring the in-game keys).
    private bool _introDone;
    private int _p1Sel;       // cursor into PickableRoster for player 1
    private int _p2Sel = 1;   // player 2 starts one down so they don't overlap P1
    private bool _p1Locked;
    private bool _p2Locked;
    private bool _twoPlayerReady => _p1Locked && _p2Locked;
    private GameIntro.IntroMode _introMode => _demo
        ? GameIntro.IntroMode.Demo
        : _mode == "2p" ? GameIntro.IntroMode.TwoPlayer : GameIntro.IntroMode.OnePlayer;
    // The 1P line's second sentence ("Charge attacks, block on their wind-up") was the third
    // statement of the same instruction on one card — the controls bullets directly beneath
    // carry both halves, with the keys attached. Objective now states the goal only.
    // The 60-second limit belongs in the objective, not the controls list: it is
    // the shape of the whole match, and a player who does not know the clock is
    // a deadline reads a decision loss as the game ending arbitrarily.
    private string IntroObjective => _mode == "2p"
        ? "Two fighters enter — one round, 60 seconds. Each player picks below."
        : _mode == "demo"
            // 2026-09-11 UI sweep: the demo objective previously read as an
            // instruction to the (nonexistent) player — a spectated exhibition
            // should say what it is, not what you must do.
            ? "Two CPU presidents go 60 seconds. Sit back — the fight runs itself."
            : "KO inside 60 seconds — closest health at the bell is a draw.";
    // "fighting" | "result". There is no longer a "select" phase — every route
    // drops straight into the fight (see OnInitialized).
    private string _phase = "fighting";
    private string _p1Char = "trump";
    private string _p2Char = "biden";
    private int _p1Hp = 100;
    private int _p2Hp = 100;
    // Energy meters (0-100) fed by the JS engine. The bar is strike power AND
    // stamina: winding up drains it into the swing, every swing costs a flat
    // toll on top, blocking refills it fast and standing refills it slowly.
    // Starts at game.js ENERGY_DEFAULT (1.0) — keep these two in step with it.
    private int _p1Energy = 100;
    private int _p2Energy = 100;

    // Mirrors game.js ENERGY_RECOVER_TO (0.40). Below it a fighter is gassed and
    // the engine refuses to start any punch or kick, so the bar is styled to say
    // so; see .pb-en-spent. This is a display threshold only — the engine owns
    // the real gate (and its hysteresis), and duplicating the number here is the
    // lesser evil against widening the seven-argument OnHud arity contract just
    // to carry one bool. It only has to be close enough to read correctly.
    private const int EnergySpentPct = 40;
    private const int EnergyHotPct = 50;

    // _elapsed is the time LEFT (game.js _pushHud computes TIME_LIMIT - clock),
    // but it only becomes true once the engine boots — until then it held 0,
    // which read as "the round already ended" under a card telling the player
    // there are 60 seconds (review #6). Seed it at the limit; ResetRoundHud
    // keeps the two paths in step.

    private const string EnergyTip =
        "Energy — strike power and stamina. Attacking drains it; blocking refills it, and a block timed on their wind-up refills it fastest. Too low and you cannot punch or kick.";

    // Mirrors game.js DANGER_HP (0.25): the plate cracks at the same moment the
    // engine starts the heartbeat. Display only — the engine owns the effect.
    private const int DangerHpPct = 25;
    private static bool InDanger(int hp) => hp > 0 && hp <= DangerHpPct;

    private static string EnergyClass(int pct) =>
        pct < EnergySpentPct ? "pb-en-spent"
        : pct > EnergyHotPct ? "pb-en-hot"
        : "";
    // The super meter/armed fields that used to sit here are gone (2026-08-11).
    // The engine still runs the meter — it is what gates each president's
    // signature move — but it is no longer pushed over OnHud or drawn, so the
    // page holds no copy of it. Two bars, two numbers.
    private double _elapsed = 60;
    private int _winner;
    private double _lastKo;
    private double _bestKo;
    private bool _newRecord;

    // Review #5: the shell's polite live region. Sparse milestones only — round
    // start, the first reading of each fighter in the red, training toggles and
    // the result — never the 4×/sec HUD pump. Demo stays silent: a kiosk has
    // nobody listening.
    private string _announcement = "";
    private bool _p1DangerAnnounced;
    private bool _p2DangerAnnounced;

    // Per-region damage (0-100) fed by the JS engine: [head, torso, arms, legs].
    private int[] _p1Regions = new int[4];
    private int[] _p2Regions = new int[4];
    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private DotNetObjectReference<PoBrawlPage>? _ref;

    // ── 1P presidents ladder + adaptive ELO (same system as ConnectFive) ──
    private int _ladder;                 // 0-based rung; Roster[_ladder] is the opponent
    private bool _champion;              // set for one select-screen after clearing rung 10
    private AdaptiveRating _rating = new();
    private int _lastEloDelta;
    private string LadderKey => $"pobrawl_ladder_{_playerName}";
    // When the rung was last written here, so a newer server copy (another device) can win.
    private string LadderAtKey => $"pobrawl_ladder_at_{_playerName}";
    // The fastest KO used to live only in _bestKo, which reset on every page load — so "Best KO"
    // in the stats panel read 0s on every visit and every KO counted as a new record.
    private string BestKoKey => $"pobrawl_bestko_{_playerName}";
    private string ClearsKey => $"pobrawl_clears_{_playerName}";
    private int _clears;                 // full ladder clears, all time

    // ── 2-player: one round ───────────────────────────────────────────────
    // Best-of-three is gone (2026-08-11, by request): every mode is now a single
    // round of 60 seconds (game.js TIME_LIMIT), won by KO or by the health
    // decision at TIME — and drawn outright when the bars finish within
    // game.js DRAW_HP_BAND of each other.
    //
    // The RoundsToWin/MaxRounds/_round/_p1Rounds/_p2Rounds state that lived here
    // drove the pip scoreboard and the PoBrawl.next rematch loop; both are gone.
    // Note what this restores: a 2P fight is once again decided in one round, so
    // a fighter's comeback super and HP-gated triggers get one chance to matter
    // rather than three. That was the original argument FOR best-of-three, and
    // the 60-second limit is now what bounds the fight instead.

    // ── Fight recap ───────────────────────────────────────────────────────
    // Accumulated across every round of the match (a 2P best-of-three) and every
    // rung of a 1P run, because the modal is only shown once at the end of both.
    // Null until the first OnMatchEnd carries a payload.
    private PoBrawlMatchRecap? _recap;
    // The most recent round alone — what the press conference talks about. _recap is the
    // whole 1P run, which is the wrong number for one president's line about one fight.
    private PoBrawlMatchRecap? _lastRecap;

    // ── Training room (1P) and demo drills (2026-09-23, training.js) ──────
    private bool _training;            // 1P: the engine is running the training room
    // Set by the intro card's "Training first" checkbox (1P only); read once by
    // OnIntroStartAsync to boot the engine straight into the room.
    private bool _trainFromIntro;
    private bool _drill;               // demo: this match is a drill (the engine rolls it)
    private bool InTraining => _training || _drill;
    private string _dummy = "stand";
    // PoBrawl.training keys (training.js setTrainingOption). Constants because the markup
    // passes them inside a quoted attribute, where a string literal would end the attribute.
    private const string HitboxesKey = "hitboxes";
    private const string InfiniteEnergyKey = "infiniteEnergy";
    private bool _hitboxes; // opt-in only — the wireframe is not for players by default
    private bool _infiniteEnergy;
    private static readonly (string Id, string Label, string Tip)[] DummyModes =
    [
        ("stand", "Stand", "Does nothing — free hits, to learn ranges and the hitboxes"),
        ("guard", "Guard", "Holds guard all the time — find what beats a turtle"),
        ("punisher", "Punisher", "Guards your wind-up and jabs back into every blocked or whiffed swing"),
        ("cpu", "Spar", "The real CPU at this rung's level — no clock, no KO, no ladder"),
    ];

    // ── Tale of the tape (PoBrawlTape.cs + wwwroot/js/pobrawlTape.js) ──────
    private PoBrawlTapeWiki? _tapeWiki;
    private IJSObjectReference? _tapeModule;

    // ── KO clip (GFX/SOUND #10, wwwroot/js/pobrawl/clip.js) ───────────────
    private bool _clipReady;

    // How long a 1P win holds on the result before rolling into the next rung, so the
    // Breaking News lower third (news.js) is on screen long enough to be read. It was
    // effectively zero: the next president's splash went up as soon as the score POSTs
    // returned.
    private const int LadderResultHoldMs = 2600;

    // ── Post-fight press conference (POST /api/pobrawl/presser) ───────────
    private PoMiniGames.Shared.Games.PoBrawlPresserReply? _presser;
    private bool _presserLoading;
    private int _presserGeneration;

    // ── Ring introduction (POST /api/pobrawl/intro) ──────────────────────
    // The one model line a local fight gets: the PA introduces the pair under the VS splash.
    // Fetched early (the 1P intro card is up for a while) and handed to the engine, which
    // speaks and captions it and holds the splash for it.
    private Task<string?>? _introLine;
    private string? _introLineFor;

    // ── Online (PoBrawlNetSession; the arena is a puppet of the server's fight) ──
    private PoBrawlNetSession? _net;
    private string _code = "";
    private string? _engineMatchId;   // the fight the running engine is showing
    private bool _netMissing;         // JoinMatch answered null: no fight on this code
    private PoMiniGames.Shared.Games.PoBrawlMatchResult? _netResult;
    private string? _netSubmittedFor; // match id whose result already went to the Elo board
    private bool _rematchRequested;
    private int _rematchVotes;
    private string? _netNoticeShown;
    private string _p1Player = "";
    private string _p2Player = "";

    private string LobbyUrl => string.IsNullOrEmpty(_code) ? "/pobrawl/multi" : $"/pobrawl/multi?code={Uri.EscapeDataString(_code)}";
    private bool IsSpectator => _net?.Snapshot?.IsSpectator == true;

    /// <summary>What the network is doing to the fight, or null when nothing worth saying.</summary>
    private string? NetNotice
    {
        get
        {
            if (_net is null) return null;
            if (_net.ConnectionState == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting) return "Reconnecting…";
            if (_net.ConnectionState == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected) return "Disconnected";
            if (_net.State is { Finished: false, ForfeitInSeconds: { } left } s)
            {
                var who = !s.Player1Connected ? _p1Player : _p2Player;
                return $"{who} dropped — forfeit in {Math.Ceiling(left):0}s";
            }
            return null;
        }
    }

    // Play Again: a fresh 1P run from the current rung, the same 2P pairing, or an online rematch
    // vote. A spectator has nothing to replay, so the modal shows its plain "Back" instead.
    private EventCallback PlayAgainCallback =>
        _demo || IsSpectator || _netMissing ? default : EventCallback.Factory.Create(this, PlayAgainAsync);

    /// <summary>
    /// Per-round scorecard reported by the engine alongside the result.
    /// </summary>
    /// <remarks>
    /// Bound from the JS object literal in <c>game.js _reportResult</c> — Blazor's interop
    /// serializer is camelCase, so <c>p1Hits</c> lands on <see cref="P1Hits"/>. Passing this
    /// as an object rather than eight more positional arguments is deliberate: interop fails
    /// silently on an arity mismatch (see the remarks on <see cref="OnHud"/>), whereas an
    /// unknown JSON property is simply ignored.
    /// </remarks>
    public sealed record PoBrawlMatchRecap(
        int P1Hits, int P2Hits,
        int P1Blocks, int P2Blocks,
        int P1BestCombo, int P2BestCombo,
        int P1BiggestHit, int P2BiggestHit);

    // Totals for counts, best-of for peaks — a "biggest hit" summed across rounds
    // would be a number that never happened.
    private static PoBrawlMatchRecap Accumulate(PoBrawlMatchRecap? a, PoBrawlMatchRecap b) =>
        a is null ? b : new PoBrawlMatchRecap(
            a.P1Hits + b.P1Hits, a.P2Hits + b.P2Hits,
            a.P1Blocks + b.P1Blocks, a.P2Blocks + b.P2Blocks,
            Math.Max(a.P1BestCombo, b.P1BestCombo), Math.Max(a.P2BestCombo, b.P2BestCombo),
            Math.Max(a.P1BiggestHit, b.P1BiggestHit), Math.Max(a.P2BiggestHit, b.P2BiggestHit));


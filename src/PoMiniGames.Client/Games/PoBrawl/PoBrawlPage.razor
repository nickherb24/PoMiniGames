@page "/pobrawl"
@page "/pobrawl/{Mode}"
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@* Aliases, not namespace imports: PoMiniGamesClient.Models mirrors Domain types by
   name (PlayerStats), so importing either namespace wholesale makes them ambiguous.
   Same convention as ApiService.cs. *@
@using PoBrawlFighter = PoMiniGames.Domain.Primitives.PoBrawlFighter
@using PoBrawlRoster = PoMiniGames.Domain.Primitives.PoBrawlRoster
@implements IAsyncDisposable
@inject PlayerNameService PlayerNameService
@inject ApiService ApiService
@inject GameResultService GameResults
@inject IJSRuntime JSRuntime
@inject KioskCoordinator Kiosk
@inject SettingsService Settings
@inject AuthStateService Auth
@inject ApiEndpoints Endpoints
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Brawl · PoMiniGames</PageTitle>

<GameShell Title=@TitleContent
           Player="@_playerName"
           Elo="@(_mode == "1p" ? _rating.Elo : (int?)null)"
           BackTo="@(_mode == "online" ? LobbyUrl : "/")"
           Stats="@_statItems"
           GameOver="@(_phase == "result" && !_demo)"
           GameOverDelayMs="@LadderResultHoldMs"
           Fullscreen="true"
           GameKey="@(_mode == "1p" ? "pobrawlko" : null)"
           Outcome="@OutcomeForCue"
           RequiresWebGl="true"
           GameSummary="@GameSummaryContent"
           PlayAgain="@PlayAgainCallback"
           Announcement="@_announcement">
    @if (!_introDone)
    {
        @* .pb-intro is display:contents — it exists so this page's scoped CSS can reach the
           shared card (::deep) and give Brawl's long 1P card its wide two-column layout. *@
        <div class="pb-intro">
            <GameIntro CueScope="pobrawl"
                       Title="@TitleContent"
                       Objective="@IntroObjective"
                       Controls="@IntroControlsContent"
                       Mode="@_introMode"
                       Options="@IntroOptions"
                       StartEnabled="true"
                       ShowStart="@(_mode != "2p")"
                       StartHint="@null"
                       DialogLabel="@IntroDialogLabel"
                       CaptureKeys="false"
                       OnKey="OnIntroKey"
                       OnStart="OnIntroStartAsync" />
        </div>
    }
    <div class="pb-wrap">
        @* The engine appends its <canvas> here, so this is the only node this component
           can attach an accessible name to. *@
        <div id="pobrawl-container" class="pb-canvas-host"
             role="img" aria-label="Brawl arena — the fight renders here"></div>

        @* Top of the arena, one flow column (HUD → ladder rail → online pills), so a taller
           HUD pushes the rail down instead of overlapping it. *@
        <div class="pb-top">
            @if (_phase == "fighting" || _demo)
            {
                @* Its own component, so the engine's 4×/sec pump re-renders it alone. *@
                <PoBrawlHud @ref="_hud"
                            P1Name="@HudName(1)" P2Name="@HudName(2)"
                            P1Fighter="@CharName(_p1Char)" P2Fighter="@CharName(_p2Char)"
                            Training="_training" />

                @* 1-player ladder rail: how far through the fifteen presidents this run is. *@
                @if (_mode == "1p" && !_training)
                {
                    <div class="pb-ladder" role="img"
                         aria-label="Ladder progress: @_ladder of @Roster.Length presidents beaten. Now fighting @CharName(_p2Char).">
                        <span class="pb-ladder-count">@_ladder/@Roster.Length</span>
                        <span class="pb-ladder-rail">
                            @for (var i = 0; i < Roster.Length; i++)
                            {
                                <span class="pb-rung @(i < _ladder ? "pb-rung--done" : i == _ladder ? "pb-rung--now" : "")"
                                      title="@Roster[i].Name"></span>
                            }
                        </span>
                        <span class="pb-ladder-now">@CharName(_p2Char)</span>
                    </div>
                }
            }

            @* Online: the room, your corner, and anything the network is doing to the fight. *@
            @if (_mode == "online" && !_netMissing)
            {
                @if (_everJoined)
                {
                    <div class="pb-net-status" role="status">
                        <span class="pb-net-pill">Room @_code</span>
                        <span class="pb-net-pill @(_isSpectator ? "pb-net-pill--watch" : "")">
                            @(_isSpectator ? "👀 Spectating" : $"You: {(_localSide == PoMiniGames.Shared.Games.PoBrawlSide.Player1 ? "left" : "right")} corner")
                        </span>
                        @if (NetNotice is { } notice)
                        {
                            <span class="pb-net-pill pb-net-pill--warn">@notice</span>
                        }
                    </div>
                }
                else
                {
                    <div class="pb-net-status" role="status"><span class="pb-net-pill">Joining room @_code…</span></div>
                }
            }
        </div>

        @if (_demo)
        {
            <div class="pb-demo-badge">🎮 Demo — CPU vs CPU</div>
        }

        @if (_mode == "online" && _netMissing)
        {
            <div class="pb-net-missing" role="status">
                <h2>No fight in room @_code</h2>
                <p>It already ended, or it never started. The lobby has the room.</p>
                <a class="pb-net-btn" href="@LobbyUrl">Back to the lobby</a>
            </div>
        }

        @* Training (1P, entered from the intro card's "Training first"). mousedown:preventDefault
           keeps a clicked button from taking focus — the fight reads keys off window, and a
           focused button would turn the next Space or Enter into a second click. *@
        @if (_training)
        {
            <div class="pb-trainbar" role="group" aria-label="Training" @onmousedown:preventDefault="true">
                <button type="button" class="pb-seg" title="Put both fighters back on their marks"
                        @onclick="ResetTrainingAsync">↺ Reset</button>
                <button type="button" class="pb-seg pb-seg--ladder"
                        title="@($"Leave training and fight {CharName(_p2Char)} for the rung")"
                        @onclick="LeaveTrainingAsync">⬅ Back to the ladder</button>
            </div>
        }
    </div>

</GameShell>

@code {
    /// <summary>Route mode segment. Parsed by <see cref="GameModes.Parse"/>, which
    /// owns every accepted spelling and legacy form — see GameMode.cs.</summary>
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "demo")] public int DemoQuery { get; set; }
    /// <summary>Online: the room code of the fight (from the lobby, a shared link, or a refresh).</summary>
    [SupplyParameterFromQuery(Name = "code")] public string? CodeQuery { get; set; }

    // 1-player ladder: PoBrawlRoster.Fighters in ladder order — most recent president first,
    // marching back in time to FDR. Rung index doubles as the CPU difficulty level (index + 1
    // → 1-15, the full range ai.js LEVELS/MAX_RUNG defines). fighters.js CHARACTERS is the
    // one copy of these names kept in step by hand.
    private static readonly PoBrawlFighter[] Roster = [.. PoBrawlRoster.Fighters];

    private static readonly PoBrawlFighter Bob = PoBrawlRoster.Bob;

    // 2-player select can pick anyone, BOB included — he is deliberately not on the rateable
    // roster (see PoBrawlRoster), which is why he is prepended rather than sorted in.
    private static readonly PoBrawlFighter[] PickableRoster = [Bob, .. Roster];

    // Fixed rating per ladder rung for the ELO math: rung 1 (Trump) is a
    // pushover at 800; rung 15 (FDR) tops out near 2660. Beating an easy rung
    // when your rating is high earns almost nothing; losing to it costs a lot.
    private static int PresidentElo(int rung) => 800 + rung * 133;

    private string _playerName = "";
    private string _mode = "1p";
    private bool _demo => _mode == "demo";

    // Outcome for the end-of-game cue. _winner is 1 for the local player and 2
    // for the opponent; only the 1P ladder has a "you" to win, so 2-player and
    // demo stay Unknown (see GameOverModal.Outcome).
    private GameResult OutcomeForCue => _mode == "online"
        ? _netResult?.Outcome switch
        {
            PoMiniGames.Shared.Games.PoBrawlOutcome.Win => GameResult.Win,
            PoMiniGames.Shared.Games.PoBrawlOutcome.Loss => GameResult.Loss,
            PoMiniGames.Shared.Games.PoBrawlOutcome.Draw => GameResult.Draw,
            _ => GameResult.InProgress,
        }
        : _mode != "1p"
        ? GameResult.InProgress
        : _winner == 1 ? GameResult.Win
        : _winner == 2 ? GameResult.Loss
        : GameResult.InProgress;


    // ── Intro/welcome gate ──
    // The fight does not start until the intro card is dismissed: OK in 1P, a 2s
    // flash in demo, and in 2P once both players lock in their fighter with their
    // own keyboard halves (P1: A/D + F, P2: ←/→ + K — mirroring the in-game keys).
    private bool _introDone;
    private int _p1Sel;       // cursor into PickableRoster for player 1
    private int _p2Sel = 1;   // player 2 starts one down so they don't overlap P1
    private bool _p1Locked;
    private bool _p2Locked;
    private bool BothLocked => _p1Locked && _p2Locked;
    private GameIntro.IntroMode _introMode => _demo
        ? GameIntro.IntroMode.Demo
        : _mode == "2p" ? GameIntro.IntroMode.TwoPlayer : GameIntro.IntroMode.OnePlayer;
    // The 60-second limit belongs in the objective: a player who does not know the clock is
    // a deadline reads a decision loss as the game ending arbitrarily.
    private string IntroObjective => _mode == "2p"
        ? "Two fighters enter — one round, 60 seconds. Each player picks below."
        : _mode == "demo"
            ? "Two CPU presidents go 60 seconds. Sit back — the fight runs itself."
            : "KO inside 60 seconds — closest health at the bell is a draw.";
    // "fighting" | "result".
    private string _phase = "fighting";
    private string _p1Char = "trump";
    private string _p2Char = "biden";
    // The page only forwards the engine's pump to the HUD (OnHud) and keeps the danger
    // milestones for the live region.
    private PoBrawlHud? _hud;
    private int _winner;
    private double _lastKo;
    private double _bestKo;
    private bool _newRecord;

    // The shell's polite live region. Sparse milestones only — round start, the first
    // reading of each fighter in the red, training and the result — never the 4×/sec HUD
    // pump. Demo stays silent: a kiosk has nobody listening.
    private string _announcement = "";
    private bool _p1DangerAnnounced;
    private bool _p2DangerAnnounced;

    private List<StatItem> _statItems = new();
    private PlayerStats _stats = new();
    private readonly GameStatsService _gameStats = new();
    private DotNetObjectReference<PoBrawlPage>? _ref;

    // ── 1P presidents ladder + adaptive ELO (same system as ConnectFive) ──
    private int _ladder;                 // 0-based rung; Roster[_ladder] is the opponent
    private bool _champion;              // the last rung just fell: the result modal shows the ending card
    private AdaptiveRating _rating = new();
    private int _lastEloDelta;
    private string LadderKey => $"pobrawl_ladder_{_playerName}";
    // When the rung was last written here, so a newer server copy (another device) can win.
    private string LadderAtKey => $"pobrawl_ladder_at_{_playerName}";
    private string BestKoKey => $"pobrawl_bestko_{_playerName}";
    private string ClearsKey => $"pobrawl_clears_{_playerName}";
    private int _clears;                 // full ladder clears, all time

    // ── Fight recap ───────────────────────────────────────────────────────
    // Accumulated across every rung of a 1P run (2P and online are one fight), because
    // the modal is only shown once, at the end of the run. Null until the first
    // OnMatchEnd carries a payload.
    private PoBrawlMatchRecap? _recap;
    // The most recent round alone — what the press conference talks about.
    private PoBrawlMatchRecap? _lastRecap;

    // 1P: the engine is running the training room. Bound straight to the intro card's
    // "Training first" box.
    private bool _training;

    // KO clip (wwwroot/js/pobrawl/clip.js).
    private bool _clipReady;

    // How long a 1P win holds on the result before rolling into the next rung, so the
    // Breaking News lower third (news.js) is on screen long enough to be read.
    private const int LadderResultHoldMs = 2600;

    // ── Post-fight press conference (POST /api/pobrawl/presser) ───────────
    private PoMiniGames.Shared.Games.PoBrawlPresserReply? _presser;
    private bool _presserLoading;
    private int _presserGeneration;

    // ── Ring introduction (POST /api/pobrawl/intro) ──────────────────────
    // The one model line a local fight gets: the PA introduces the pair under the VS splash.
    // Fetched early (the 1P intro card is up for a while) and handed to the engine, which
    // speaks and captions it and holds the splash for it.
    private Task<string?>? _introLine;
    private string? _introLineFor;

    // ── Online (PoBrawlNetSession; the arena is a puppet of the server's fight) ──
    private PoBrawlNetSession? _net;
    private string _code = "";
    private string? _engineMatchId;   // the fight the running engine is showing
    private bool _netMissing;         // JoinMatch answered null: no fight on this code
    // Corner state, cached at join. The live Snapshot can turn null underneath an open result
    // screen (a reconnect that answers null once the swept room is gone), so name/side
    // readouts must not dereference it.
    private PoMiniGames.Shared.Games.PoBrawlSide? _localSide;
    private bool _isSpectator;
    private bool _everJoined;
    private PoMiniGames.Shared.Games.PoBrawlMatchResult? _netResult;
    private string? _netSubmittedFor; // match id whose result already went to the Elo board
    private bool _rematchRequested;
    private int _rematchVotes;
    private string? _netNoticeShown;
    private string _p1Player = "";
    private string _p2Player = "";

    private string LobbyUrl => string.IsNullOrEmpty(_code) ? "/pobrawl/multi" : $"/pobrawl/multi?code={Uri.EscapeDataString(_code)}";

    /// <summary>What the network is doing to the fight, or null when nothing worth saying.</summary>
    private string? NetNotice
    {
        get
        {
            if (_net is null) return null;
            if (_net.ConnectionState == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting) return "Reconnecting…";
            if (_net.ConnectionState == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected) return "Disconnected";
            if (_net.State is { Finished: false, ForfeitInSeconds: { } left } s)
            {
                var who = !s.Player1Connected ? _p1Player : _p2Player;
                return $"{who} dropped — forfeit in {Math.Ceiling(left):0}s";
            }
            return null;
        }
    }

    // Play Again: a fresh 1P run from the current rung, the same 2P pairing, or an online rematch
    // vote. A spectator has nothing to replay, so the modal shows its plain "Back" instead.
    private EventCallback PlayAgainCallback =>
        _demo || _isSpectator || _netMissing ? default : EventCallback.Factory.Create(this, PlayAgainAsync);

    /// <summary>
    /// Per-round scorecard reported by the engine alongside the result.
    /// </summary>
    /// <remarks>
    /// Bound from the JS object literal in <c>game.js _reportResult</c> — Blazor's interop
    /// serializer is camelCase, so <c>p1Hits</c> lands on <see cref="P1Hits"/>. Passing this
    /// as an object rather than eight more positional arguments is deliberate: interop fails
    /// silently on an arity mismatch (see the remarks on <see cref="OnHud"/>), whereas an
    /// unknown JSON property is simply ignored.
    /// </remarks>
    public sealed record PoBrawlMatchRecap(
        int P1Hits, int P2Hits,
        int P1Blocks, int P2Blocks,
        int P1BestCombo, int P2BestCombo,
        int P1BiggestHit, int P2BiggestHit);

    // Totals for counts, best-of for peaks — a "biggest hit" summed across rounds
    // would be a number that never happened.
    private static PoBrawlMatchRecap Accumulate(PoBrawlMatchRecap? a, PoBrawlMatchRecap b) =>
        a is null ? b : new PoBrawlMatchRecap(
            a.P1Hits + b.P1Hits, a.P2Hits + b.P2Hits,
            a.P1Blocks + b.P1Blocks, a.P2Blocks + b.P2Blocks,
            Math.Max(a.P1BestCombo, b.P1BestCombo), Math.Max(a.P2BestCombo, b.P2BestCombo),
            Math.Max(a.P1BiggestHit, b.P1BiggestHit), Math.Max(a.P2BiggestHit, b.P2BiggestHit));

    private RenderFragment TitleContent => @<span><span aria-hidden="true">🥊</span> Brawl</span>;

    private string IntroDialogLabel => _mode switch
    {
        "2p" => "Brawl two-player setup",
        "demo" => "Brawl demo intro",
        _ => "Brawl intro",
    };

    // Whose pick a tap on the grid makes: player 1 until they lock, then player 2.
    private string SelectPrompt =>
        !_p1Locked ? "Player 1 — tap your fighter (or A / D, then F)"
        : !_p2Locked ? "Player 2 — tap your fighter (or ← / →, then K)"
        : "Both locked in — fight!";

    private RenderFragment IntroControlsContent => _mode switch
    {
        "2p" => TwoPlayerQuickControls,
        "demo" => DemoQuickControls,
        _ => HowToPlayContent,
    };

    private RenderFragment DemoQuickControls => @<div>
        <p>Two CPU presidents fight a 60-second exhibition — sit back and watch.</p>
        <ul>
            <li>No controls — both corners are driven by the CPU</li>
            <li>⚡ Energy still rules the exchanges — swings drain it, blocking refills it</li>
        </ul>
    </div>;

    private RenderFragment TwoPlayerQuickControls => @<div>
        <p>One round, 60 seconds. Pick fighters, lock in, then fight.</p>
        <ul>
            <li>Player 1: <kbd>A</kbd>/<kbd>D</kbd> choose, <kbd>F</kbd> lock · <kbd>W</kbd>/<kbd>S</kbd> circle, <kbd>R</kbd> block</li>
            <li>Player 2: <kbd>←</kbd>/<kbd>→</kbd> choose, <kbd>K</kbd> lock · <kbd>↑</kbd>/<kbd>↓</kbd> circle, <kbd>;</kbd> block</li>
            <li>Attacks: P1 <kbd>F</kbd>/<kbd>G</kbd>, P2 <kbd>K</kbd>/<kbd>L</kbd> (hold to charge)</li>
            <li>Guard as they wind up, not before — a PERFECT guard freezes them and arms your counter</li>
            <li>Take enough punishment and your president's signature move fires itself</li>
            <li class="pb-touch-keys">On a phone the touch pad drives Player 1 — Player 2 needs the keyboard or a gamepad</li>
        </ul>
    </div>;

    // The guard bullet is last so it is the line in view when the card closes: the PERFECT
    // guard window (game.js PERFECT_GUARD_WINDOW) is invisible on the HUD, so only this card
    // teaches it. The energy line matters because the bar is a hard gate on attacking.
    private RenderFragment HowToPlayContent => @<div>
        <ul>
            @* The first two lines are keyboard-only; a touch screen gets the pad's own
               glyphs instead (CSS swaps them on a coarse pointer — see .pb-keys). *@
            <li class="pb-keys"><kbd>A</kbd>/<kbd>D</kbd> move · <kbd>W</kbd>/<kbd>S</kbd> circle · <b>hold</b> <kbd>R</kbd> to block</li>
            <li class="pb-keys"><kbd>F</kbd> punch · <kbd>G</kbd> kick — hold to charge, release to strike</li>
            <li class="pb-touch-keys">◀ ▶ move · ↺ ↻ circle · <b>hold</b> 🛡 to block · 👊 punch · 🦵 kick — hold to charge, release to strike</li>
            <li>👊 Punch is <b>speed</b>: fast, cheap, small damage. 🦵 Kick is the <b>power</b> hit — slower, and it costs twice the energy</li>
            <li>⚡ Energy is hit power <b>and</b> stamina — every swing spends it. Run it dry and you cannot strike at all</li>
            <li>🛡 Guard <b>as they wind up</b>, not before — that's a PERFECT guard: big energy back, they freeze, your answer hits harder</li>
        </ul>
    </div>;

    // 2P gets the fighter select, 1P the training choice and its rung; demo gets neither.
    private RenderFragment? IntroOptions => _mode switch
    {
        "2p" => SelectContent,
        "1p" => ScoutingContent,
        _ => null,
    };

    // 1P: the start-mode choice and who the rung is.
    private RenderFragment ScoutingContent => @<div class="pb-scout">
        <label class="pb-intro-train">
            <input type="checkbox" @bind="_training" />
            <span><b>🥋 Training first</b> — no clock, no KO; the room's bar has the exit.</span>
        </label>
        <div class="pb-scout-head">
            <span class="pb-scout-rung">Rung @(_ladder + 1) of @Roster.Length</span>
            <span class="pb-scout-name">@CharName(_p2Char)</span>
        </div>
    </div>;

    // Two-player fighter select: one shared 4×4 grid with a cursor per player. Each player
    // drives their cursor with their in-game keys (see OnIntroKey) or a tap; the side cards
    // are the lock toggles, and locking in both sides starts the fight.
    private RenderFragment SelectContent => @<div class="pb-select">
        <div class="pb-select-sides">
            @SideCard(1)
            <span class="pb-select-vs" aria-hidden="true">VS</span>
            @SideCard(2)
        </div>
        <p class="pb-select-prompt">@SelectPrompt</p>
        <ul class="pb-select-grid" aria-label="Fighters">
            @for (int i = 0; i < PickableRoster.Length; i++)
            {
                var idx = i;
                var f = PickableRoster[idx];
                <li>
                    <button type="button"
                            class="pb-select-tile @(idx == _p1Sel ? "pb-select-tile--p1" : "") @(idx == _p2Sel ? "pb-select-tile--p2" : "")"
                            aria-label="@TileLabel(idx)"
                            @onclick="() => TapFighter(idx)">
                        <span class="pb-select-name">@f.Name</span>
                        @if (idx == _p1Sel) { <span class="pb-select-mark pb-select-mark--p1" aria-hidden="true">P1</span> }
                        @if (idx == _p2Sel) { <span class="pb-select-mark pb-select-mark--p2" aria-hidden="true">P2</span> }
                    </button>
                </li>
            }
        </ul>
    </div>;

    private string TileLabel(int idx) =>
        PickableRoster[idx].Name + (idx == _p1Sel ? ", Player 1" : "") + (idx == _p2Sel ? ", Player 2" : "");

    private RenderFragment SideCard(int side)
    {
        var locked = side == 1 ? _p1Locked : _p2Locked;
        var pick = PickableRoster[side == 1 ? _p1Sel : _p2Sel].Name;
        return @<button type="button" class="pb-select-side pb-select-side--p@(side) @(locked ? "pb-select-side--locked" : "")"
                        aria-pressed="@(locked ? "true" : "false")"
                        aria-label="Player @side: @pick, @(locked ? "locked in — press to change" : "press to lock in")"
                        @onclick="() => ToggleLock(side)">
            <span class="pb-select-who">Player @side</span>
            <span class="pb-select-pick">@pick</span>
            <span class="pb-select-state">@(locked ? "✓ Ready" : "Lock in")</span>
        </button>;
    }

    private RenderFragment GameSummaryContent => @<div>
        <div>@ResultLine()</div>
        @if (_winner != 0 && _mode == "1p" && _winner == 1)
        {
            <div>KO in @_lastKo.ToString("0.00")s@(_newRecord ? " — 🏆 New record!" : "")</div>
        }
        @if (_mode == "online" && !_isSpectator)
        {
            @* Both corners have to ask; the server starts the next fight on the same code with the
               same fighters the moment the second one does. *@
            @if (_rematchRequested || _rematchVotes > 0)
            {
                <div class="pb-rematch">🔁 Rematch @_rematchVotes/2 — @(_rematchRequested ? $"waiting for {OpponentPlayer}…" : $"{OpponentPlayer} wants a rematch! Press Play again.")</div>
            }
            else
            {
                <div>Play again asks @OpponentPlayer for a rematch — same fighters, same room.</div>
            }
        }
        @if (_mode == "1p")
        {
            <div>Elo @_rating.Elo (@(_lastEloDelta >= 0 ? "+" : "")@_lastEloDelta) vs @CharName(_p2Char) @PresidentElo(LadderRungOf(_p2Char))</div>
            @if (_champion)
            {
                @EndingCard
            }
            else
            {
                <div>Next: BOB vs @Roster[_ladder].Name (match @(_ladder + 1) of @Roster.Length)</div>
            }
        }

        @* The engine records the fight on a rolling buffer and reports OnClipReady once the
           result's clip is closed; nothing is kept or sent unless the player presses this. *@
        @if (_clipReady)
        {
            <button type="button" class="pb-clip-btn" @onclick="SaveClipAsync">🎬 Save the KO clip</button>
        }

        @if (_recap is { } r)
        {
            <table class="pb-recap">
                <caption>Fight recap</caption>
                <thead>
                    <tr>
                        <th scope="col" class="pb-recap-stat">Stat</th>
                        <th scope="col">@HudName(1)</th>
                        @* In 1P the run walks several presidents, so the right-hand
                           column is every opponent it faced, not the last one. *@
                        <th scope="col">@(_mode == "1p" ? "Presidents" : HudName(2))</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Hits landed</th><td>@r.P1Hits</td><td>@r.P2Hits</td></tr>
                    <tr><th scope="row">Blocks</th><td>@r.P1Blocks</td><td>@r.P2Blocks</td></tr>
                    <tr><th scope="row">Best combo</th><td>@r.P1BestCombo</td><td>@r.P2BestCombo</td></tr>
                    <tr><th scope="row">Biggest hit</th><td>@r.P1BiggestHit</td><td>@r.P2BiggestHit</td></tr>
                </tbody>
            </table>
        }

        @* One line from the podium, read out by the PA. Flavour only — the result above is
           already final, so a failed fetch simply shows nothing. *@
        @if (_presserLoading || _presser is not null)
        {
            <figure class="pb-presser">
                <figcaption class="pb-presser-head"><span aria-hidden="true">🎤</span> Post-fight press conference</figcaption>
                @if (_presser is { } p)
                {
                    <blockquote class="pb-presser-line">“@p.Text”</blockquote>
                    <div class="pb-presser-who">— @p.Speaker</div>
                }
                else
                {
                    <p class="pb-presser-wait">The podium mic squeals…</p>
                }
            </figure>
        }

        @* No board markup here on purpose: GameOverModal already renders one from the shell's
           GameKey (1P: "pobrawlko", top 3 by fastest KO). *@
    </div>;

    // The ladder ending (full clear): the roll of fifteen KOs, the run's numbers, and the belt
    // going back on the line at rung 1.
    private RenderFragment EndingCard => @<section class="pb-ending" aria-label="Ladder complete">
        <div class="pb-ending-seal" aria-hidden="true">🏆</div>
        <h3 class="pb-ending-title">Commander-in-Chief of the Ring</h3>
        <p class="pb-ending-line">Fifteen presidents, fifteen trips to the canvas. BOB loosens his tie, clocks back in at the office, and never mentions it again.</p>
        <ol class="pb-ending-roll">
            @foreach (var f in Roster)
            {
                <li><span class="pb-ending-ko">KO</span> @f.Name</li>
            }
        </ol>
        <dl class="pb-ending-stats">
            <div><dt>Elo</dt><dd>@_rating.Elo</dd></div>
            <div><dt>Fastest KO</dt><dd>@(_bestKo > 0 ? $"{_bestKo:0.00}s" : "—")</dd></div>
            <div><dt>Ladder clears</dt><dd>@_clears</dd></div>
            @if (_recap is { } run)
            {
                <div><dt>Hits this run</dt><dd>@run.P1Hits</dd></div>
            }
        </dl>
        <p class="pb-ending-next">The belt goes back on the line — @Roster[0].Name is waiting at rung 1.</p>
    </section>;

    protected override void OnInitialized()
    {
        var routeMode = GameModes.Parse(Mode, ModeQuery, DemoQuery);
        _mode = routeMode == GameMode.Demo ? "demo"
              : routeMode == GameMode.TwoPlayer ? "2p"
              : "1p";
        // /pobrawl/online?code=… — the lobby's fight. Not a GameModes slug: it is not a way to
        // START a game (that is /pobrawl/multi), only where a started one is played or watched.
        // The lobby already showed the intro card, so there is none here.
        if (string.Equals(Mode, "online", StringComparison.OrdinalIgnoreCase))
        {
            _mode = "online";
            _introDone = true;
            _code = (CodeQuery ?? "").Trim().ToUpperInvariant();
        }
        LoadLocalProgress();
        // The name can still be settling (localStorage read, then the signed-in display name) —
        // and everything above is keyed by it. See OnPlayerNameChanged.
        PlayerNameService.StateChanged += OnPlayerNameChanged;
        // Same for the identity itself: under ?autoGuest=1 the guest session is still being
        // minted on first render, so the cloud-progress fetch below 403s. OnAuthSettled
        // re-runs the merge the moment auth flips to signed-in. See MergeRemoteProgressAsync.
        Auth.StateChanged += OnAuthSettled;

        if (_mode == "2p")
        {
            // Seed the HUD from the select cursors so the nameplates behind the
            // intro card match what the two columns are pointing at.
            _p1Char = PickableRoster[_p1Sel].Id;
            _p2Char = PickableRoster[_p2Sel].Id;
        }
        UpdateStats();

        if (_demo) Kiosk.SetCurrent("pobrawl-demo");
    }

    // One remote-progress merge per page life: first render when already signed in, otherwise
    // the moment the auto-guest identity settles (see OnAuthSettled).
    private bool _progressFetched;

    /// <summary>
    /// 1P: pick up ladder progress saved from another device (GET /api/pobrawl/progress). The
    /// newer of the two copies wins the rung; the fastest KO and the clear count take the best.
    /// Never blocks the page — offline or signed out, the local copy simply stands.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (_mode != "1p") return;
        if (!Auth.IsAuthenticated) return; // OnAuthSettled picks this up.
        _progressFetched = true;
        await MergeRemoteProgressAsync();
    }

    private void OnAuthSettled()
    {
        if (_mode != "1p" || _progressFetched || _introDone || !Auth.IsAuthenticated) return;
        _progressFetched = true;
        _ = InvokeAsync(async () =>
        {
            await MergeRemoteProgressAsync();
            StateHasChanged();
        });
    }

    private async Task MergeRemoteProgressAsync()
    {
        var remote = await ApiService.GetPoBrawlProgressAsync();
        if (remote is null) return;
        var localAt = long.TryParse(LocalStorageService.GetItem<string>(LadderAtKey), out var at) ? at : 0;
        if (remote.UpdatedAtUnixMs > localAt && !_introDone)
        {
            _ladder = Math.Clamp(remote.Rung, 0, Roster.Length - 1);
            _p2Char = Roster[_ladder].Id;
            LocalStorageService.SetItem(LadderKey, _ladder.ToString());
            LocalStorageService.SetItem(LadderAtKey, remote.UpdatedAtUnixMs.ToString());
            PrefetchIntro();
        }
        if (remote.BestKoSeconds > 0 && (_bestKo == 0 || remote.BestKoSeconds < _bestKo)) SaveBestKo(remote.BestKoSeconds);
        _clears = Math.Max(_clears, remote.Clears);
        UpdateStats();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // The engine boots only once the intro is dismissed (see OnIntroStartAsync)
        // so the fight never runs behind the welcome card. Just create the interop
        // handle here — InitEngine needs it.
        _ref = DotNetObjectReference.Create(this);
        if (_mode == "online")
        {
            await StartOnlineAsync();
            return;
        }
        // 1P only: 2P fetches its introduction once both players have picked.
        if (_mode == "1p") PrefetchIntro();
    }

    /// <summary>Everything this page keeps per player name: stats, Elo, the rung, the fastest KO, the clears.</summary>
    private void LoadLocalProgress()
    {
        _playerName = PlayerNameService.GetPlayerName();
        _stats = _gameStats.GetStats("pobrawl", _playerName);
        _bestKo = double.TryParse(LocalStorageService.GetItem<string>(BestKoKey), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var ko) ? ko : 0;
        _clears = int.TryParse(LocalStorageService.GetItem<string>(ClearsKey), out var c) ? c : 0;
        if (_mode != "1p") return;
        _rating = _gameStats.GetAdaptiveRating("pobrawl", _playerName);
        _ladder = LoadLadder();
        _p1Char = Bob.Id;
        _p2Char = Roster[_ladder].Id;
    }

    /// <summary>
    /// The player name settled after OnInitialized read it. On a reload the page can initialise
    /// before the stored name (and then the signed-in display name) arrives, so the rung would be
    /// read under the wrong key. Re-read it — until the fight starts; after that the running
    /// match owns the numbers.
    /// </summary>
    private void OnPlayerNameChanged()
    {
        if (_introDone || _demo || PlayerNameService.GetPlayerName() == _playerName) return;
        _ = InvokeAsync(() =>
        {
            LoadLocalProgress();
            UpdateStats();
            if (_mode == "1p") PrefetchIntro();
            StateHasChanged();
        });
    }

    // Routes the intro's key events to each player's selection column. Physical
    // key codes (KeyA, ArrowLeft…) so the mapping is layout-independent and
    // matches each player's in-game half of the keyboard.
    private void OnIntroKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (_mode != "2p" || _introDone) return;
        var n = PickableRoster.Length;
        // The grid is SelectColumns wide: across is ±1, down is ±SelectColumns (the in-game
        // circle keys, W/S and ↑/↓), all wrapping.
        switch (e.Code)
        {
            case "KeyA":      if (!_p1Locked) _p1Sel = (_p1Sel - 1 + n) % n; break;
            case "KeyD":      if (!_p1Locked) _p1Sel = (_p1Sel + 1) % n; break;
            case "KeyW":      if (!_p1Locked) _p1Sel = (_p1Sel - SelectColumns + n) % n; break;
            case "KeyS":      if (!_p1Locked) _p1Sel = (_p1Sel + SelectColumns) % n; break;
            case "KeyF":      _p1Locked = !_p1Locked; break;
            case "ArrowLeft":  if (!_p2Locked) _p2Sel = (_p2Sel - 1 + n) % n; break;
            case "ArrowRight": if (!_p2Locked) _p2Sel = (_p2Sel + 1) % n; break;
            case "ArrowUp":    if (!_p2Locked) _p2Sel = (_p2Sel - SelectColumns + n) % n; break;
            case "ArrowDown":  if (!_p2Locked) _p2Sel = (_p2Sel + SelectColumns) % n; break;
            case "KeyK":      _p2Locked = !_p2Locked; break;
            default: return;
        }
        // Both locked → straight into the fight (no reaching for the mouse).
        if (BothLocked) { _ = OnIntroStartAsync(); return; }
        StateHasChanged();
    }

    // Columns of the 2P select grid — the CSS (.pb-select-grid) draws the same four.
    private const int SelectColumns = 4;

    /// <summary>
    /// A tap on the grid picks AND locks for whoever is still choosing — player 1, then
    /// player 2 — so a pointer pair gets through in two taps. A player who wants another
    /// fighter unlocks from their side card and taps again.
    /// </summary>
    private void TapFighter(int idx)
    {
        if (_introDone) return;
        if (!_p1Locked) { _p1Sel = idx; _p1Locked = true; }
        else if (!_p2Locked) { _p2Sel = idx; _p2Locked = true; }
        if (BothLocked) _ = OnIntroStartAsync();
    }

    /// <summary>Pointer equivalent of the F and K lock-in keys.</summary>
    private void ToggleLock(int side)
    {
        if (_introDone) return;
        if (side == 1) _p1Locked = !_p1Locked; else _p2Locked = !_p2Locked;
        // Match the keyboard path: both sides ready starts the fight.
        if (BothLocked) _ = OnIntroStartAsync();
    }

    // Dismisses the intro and boots the engine. Idempotent: the FIGHT button and
    // the both-players-locked path can both fire, but the fight starts once.
    private async Task OnIntroStartAsync()
    {
        if (_introDone) return;
        _introDone = true;

        if (_demo)
        {
            // Attract mode: two random fighters, CPU vs CPU.
            var picks = Roster.OrderBy(_ => Guid.NewGuid()).Take(2).ToArray();
            _p1Char = picks[0].Id;
            _p2Char = picks[1].Id;
        }
        else if (_mode == "2p")
        {
            // The two intro columns decided these (per-half keys, or tap). The
            // cursors start one apart (Bob vs Trump), so Start without locking
            // still starts a legal, mirror-free fight.
            _p1Char = PickableRoster[_p1Sel].Id;
            _p2Char = PickableRoster[_p2Sel].Id;
            PrefetchIntro();
        }
        // 1P keeps the ladder matchup chosen in OnInitialized (BOB vs the rung).
        if (_mode == "1p" && _training)
        {
            _announcement = $"Training room on — no clock, no KO. Fight {CharName(_p2Char)} when ready.";
        }

        StateHasChanged();
        await InitEngine();
    }

    /// <summary>Returns every HUD readout to its round-start value (engine boot and the next rung).</summary>
    private void ResetRoundHud()
    {
        _hud?.Reset();
        _clipReady = false;
    }

    private async Task InitEngine()
    {
        ResetRoundHud();
        // 1P difficulty is the ladder rung (1 = pushover Trump … 15 = brutal
        // FDR); demo keeps the balanced mid-tier CPU-vs-CPU fight.
        object difficulty = _mode == "1p" ? _ladder + 1 : "medium";
        // Online: which corner is ours (0 = watching). The engine drives both as puppets of the
        // server's snapshots and only reads the local keys for corner `localSide`.
        var localSide = _net?.Snapshot is { IsSpectator: false } snap
            ? (snap.LocalSide == PoMiniGames.Shared.Games.PoBrawlSide.Player1 ? 1 : 2)
            : 0;
        var introLine = await TakeIntroAsync();
        try
        {
            // Route-gated engine load (wwwroot/js/engineLoader.js): it has to be pulled in
            // before the first interop call. Idempotent after the first await.
            if (!await JSRuntime.InvokeAsync<bool>("loadEngine", "pobrawl"))
            {
                Console.Error.WriteLine("[pobrawl] engine failed to load");
                return;
            }

            await JSRuntime.InvokeVoidAsync("PoBrawl.init", "pobrawl-container", _ref,
                new
                {
                    mode = _mode,
                    p1Character = _p1Char,
                    p2Character = _p2Char,
                    difficulty,
                    training = _training,
                    localSide,
                    introLine,
                });
            // Honour the global ⚙️ master-mute setting on every engine boot.
            if (Settings.Muted)
            {
                await JSRuntime.InvokeVoidAsync("PoBrawl.setMuted", true);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[PoBrawl] JS init failed: {ex.Message}");
        }
    }

    /// <summary>
    /// The result modal's Play again. 1P starts a fresh run from the current rung (a loss never
    /// costs a rung, it only ends the run); 2P re-runs the same pairing; online asks the other
    /// corner for a rematch, and the fight restarts when they ask too.
    /// </summary>
    private async Task PlayAgainAsync()
    {
        if (_mode == "online")
        {
            if (_net is null || _rematchRequested) return;
            _rematchRequested = true;
            _rematchVotes = Math.Max(_rematchVotes, 1);
            StateHasChanged();
            try { await _net.RequestRematchAsync(); }
            catch (Exception ex)
            {
                // The hub refuses a rematch on a swept room (FinishedLinger elapsed, or a
                // rematch already replaced it) with a HubException — surface its message and
                // reset the vote instead of showing "waiting for a rematch" forever.
                _rematchRequested = false;
                _rematchVotes = 0;
                StateHasChanged();
                Toasts.Show(PoBrawlNetSession.HubMessage(ex, "Couldn't reach the room — try again."), ToastType.Warning);
            }
            return;
        }
        ++_presserGeneration; // a press line still in flight belongs to the fight that just ended
        _presser = null;
        _presserLoading = false;
        _recap = null;
        _lastRecap = null;
        _champion = false;
        _newRecord = false;
        _winner = 0;
        if (_mode == "1p") _p2Char = Roster[_ladder].Id;
        _phase = "fighting";
        _announcement = $"Rematch — {CharName(_p1Char)} versus {CharName(_p2Char)}.";
        PrefetchIntro();
        StateHasChanged();
        await InitEngine();
    }

    // ── Online ───────────────────────────────────────────────────────────
    private async Task StartOnlineAsync()
    {
        if (string.IsNullOrEmpty(_code))
        {
            Nav.NavigateTo("/pobrawl/multi");
            return;
        }
        _net = new PoBrawlNetSession(Endpoints);
        _net.Joined += snap => InvokeAsync(() => OnNetJoinedAsync(snap));
        _net.StateReceived += OnNetState;
        _net.Finished += r => InvokeAsync(() => OnNetFinishedAsync(r));
        _net.RematchStarted += () => InvokeAsync(async () =>
        {
            try { if (_net is not null) await _net.JoinAsync(); } catch { /* the Joined handler never fires; the modal stays */ }
        });
        _net.ConnectionChanged += _ => InvokeAsync(StateHasChanged);
        try
        {
            await _net.ConnectAsync(_code);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[PoBrawl] online connect failed: {ex.Message}");
            _netMissing = true;
            StateHasChanged();
        }
    }

    /// <summary>
    /// A (re-)join answered. A new fight (the first join, or a rematch) boots the arena on its
    /// fighters; a reconnect to the fight already on screen just carries on.
    /// </summary>
    private async Task OnNetJoinedAsync(PoMiniGames.Shared.Games.PoBrawlMatchSnapshot? snap)
    {
        if (snap is null)
        {
            // A reconnect after the fight was swept is not "missing" — the result is already up.
            if (_engineMatchId is null) _netMissing = true;
            StateHasChanged();
            return;
        }
        _netMissing = false;
        _everJoined = true;
        _isSpectator = snap.IsSpectator;
        _localSide = snap.LocalSide;
        _p1Player = snap.Player1.DisplayName;
        _p2Player = snap.Player2.DisplayName;
        if (snap.MatchId == _engineMatchId) { StateHasChanged(); return; }

        _engineMatchId = snap.MatchId;
        _p1Char = snap.Player1.FighterId;
        _p2Char = snap.Player2.FighterId;
        _netResult = null;
        _rematchRequested = false;
        _rematchVotes = 0;
        _recap = null;
        _lastRecap = null;
        _presser = null;
        _presserLoading = false;
        ++_presserGeneration;
        _winner = 0;
        _phase = "fighting";
        _announcement = snap.IsSpectator
            ? $"Watching {_p1Player} versus {_p2Player}."
            : $"Online fight — you are the {(snap.LocalSide == PoMiniGames.Shared.Games.PoBrawlSide.Player1 ? "left" : "right")} corner against {OpponentPlayer}.";
        StateHasChanged();
        await InitEngine();
    }

    /// <summary>Every server tick: straight to the arena, off the render path.</summary>
    private void OnNetState(PoMiniGames.Shared.Games.PoBrawlMatchState s)
    {
        _ = JSRuntime.InvokeVoidAsync("PoBrawl.net", s).AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
        // Re-render only when something the page shows changed: the network notice, the votes.
        var notice = NetNotice;
        if (notice != _netNoticeShown || s.RematchVotes != _rematchVotes)
        {
            _netNoticeShown = notice;
            _rematchVotes = Math.Max(s.RematchVotes, _rematchRequested ? 1 : 0);
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>The server's result for our corner: the outcome the modal names, and the Elo write (once per fight).</summary>
    private async Task OnNetFinishedAsync(PoMiniGames.Shared.Games.PoBrawlMatchResult r)
    {
        _netResult = r;
        StateHasChanged();
        if (_netSubmittedFor == r.MatchId || _isSpectator || _net?.Snapshot is null) return;
        _netSubmittedFor = r.MatchId;
        if (!await ApiService.SubmitPoBrawlOnlineMatchAsync(new PoMiniGames.Shared.Games.PoBrawlMatchResultDto { MatchId = r.MatchId }))
        {
            Toasts.Show("Couldn't record the match — Elo didn't update.", ToastType.Warning);
        }
    }

    /// <summary>netplay.js → the local corner's held keys changed ('left' | 'right' | 'block' | 'idle').</summary>
    [JSInvokable]
    public Task OnNetHeld(string state) => _net?.SendHeldAsync(state) ?? Task.CompletedTask;

    /// <summary>netplay.js → an attack key ('punch' | 'kick' | 'special').</summary>
    [JSInvokable]
    public Task OnNetPress(string attack) => _net?.SendPressAsync(attack) ?? Task.CompletedTask;

    // The LOCAL side is cached at join (see the field note on _localSide): the Snapshot can
    // be gone while the result screen is still up, and "who is my opponent" must survive it.
    private string OpponentPlayer => _localSide == PoMiniGames.Shared.Games.PoBrawlSide.Player2 ? _p1Player : _p2Player;

    /// <summary>The HUD nameplate: the president, and online the person driving them too.</summary>
    private string HudName(int side)
    {
        var fighter = CharName(side == 1 ? _p1Char : _p2Char);
        if (_mode != "online") return fighter;
        var player = side == 1 ? _p1Player : _p2Player;
        return string.IsNullOrEmpty(player) ? fighter : $"{player} · {fighter}";
    }

    // ── Ring introduction ────────────────────────────────────────────────
    private void PrefetchIntro()
    {
        if (_demo || _mode == "online" || !Auth.IsAuthenticated) return;
        var key = $"{_p1Char}|{_p2Char}";
        if (_introLineFor == key && _introLine is not null) return;
        _introLineFor = key;
        _introLine = FetchIntroAsync(_p1Char, _p2Char);
    }

    private async Task<string?> FetchIntroAsync(string p1, string p2) =>
        (await ApiService.GetPoBrawlIntroAsync(new PoMiniGames.Shared.Games.PoBrawlIntroRequest(p1, p2)))?.Text;

    /// <summary>
    /// The introduction for the fight about to start, if it is ready within a beat. Consumed —
    /// the next fight fetches its own. A slow model costs the fight its introduction, never its start.
    /// </summary>
    private async Task<string?> TakeIntroAsync()
    {
        if (_training || _demo || _mode == "online") return null;
        PrefetchIntro();
        if (_introLine is not { } task) return null;
        _introLine = null;
        _introLineFor = null;
        var done = await Task.WhenAny(task, Task.Delay(1200));
        return done == task ? await task : null;
    }

    // ── Training room (1P) ───────────────────────────────────────────────
    // Entered from the intro card; left by the bar's "Back to the ladder". Either direction
    // re-inits the engine (PoBrawl.init disposes the running game), so whatever was in
    // progress is abandoned: no result, no ladder change.
    private async Task LeaveTrainingAsync()
    {
        _training = false;
        _phase = "fighting";
        ++_presserGeneration; // a line still in flight belongs to a fight that is gone
        // The room-to-fight flip is invisible in the arena itself — say it.
        _announcement = $"Back to the ladder — fighting {CharName(_p2Char)} for the rung.";
        await InitEngine();
    }

    private async Task ResetTrainingAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("PoBrawl.training", "reset"); } catch { }
    }

    // ── Post-fight press conference ──────────────────────────────────────
    // Only called on the paths that SHOW the result modal, so a 1P win rolling into the next
    // rung asks for nothing and a kiosk left running in demo spends no tokens.
    private async Task StartPresserAsync()
    {
        var generation = ++_presserGeneration;
        _presser = null;
        _presserLoading = false;
        if (!Auth.IsAuthenticated || _lastRecap is not { } r) return;

        // 1P: the president at the podium (winner or loser, it is their press conference).
        // 2P: the winner, or player 1 on a draw.
        var speakerIsP2 = _mode == "1p" || _winner == 2;
        var speakerWon = _winner != 0 && (_winner == 2) == speakerIsP2;
        var outcome = _winner == 0 ? PoMiniGames.Shared.Games.PoBrawlOutcome.Draw
            : speakerWon ? PoMiniGames.Shared.Games.PoBrawlOutcome.Win
            : PoMiniGames.Shared.Games.PoBrawlOutcome.Loss;
        var request = new PoMiniGames.Shared.Games.PoBrawlPresserRequest(
            SpeakerId: speakerIsP2 ? _p2Char : _p1Char,
            OpponentId: speakerIsP2 ? _p1Char : _p2Char,
            Outcome: outcome,
            // The engine only reports a result before the 60 s bell on a knockout.
            Knockout: _winner != 0 && _lastKo < 59.9,
            Hits: speakerIsP2 ? r.P2Hits : r.P1Hits,
            OpponentHits: speakerIsP2 ? r.P1Hits : r.P2Hits,
            Blocks: speakerIsP2 ? r.P2Blocks : r.P1Blocks,
            BestCombo: speakerIsP2 ? r.P2BestCombo : r.P1BestCombo,
            BiggestHit: speakerIsP2 ? r.P2BiggestHit : r.P1BiggestHit,
            Seconds: (int)Math.Round(_lastKo));

        _presserLoading = true;
        await InvokeAsync(StateHasChanged);
        var reply = await ApiService.GetPoBrawlPresserAsync(request);
        // A newer match (or leaving training) superseded this request while it was in flight.
        if (generation != _presserGeneration) return;
        _presserLoading = false;
        _presser = reply;
        // The shell's live region reads it.
        if (reply is not null) _announcement = $"Press conference — {reply.Speaker}: {reply.Text}";
        await InvokeAsync(StateHasChanged);
        if (reply is not null && !Settings.Muted)
        {
            try { await JSRuntime.InvokeVoidAsync("PoBrawl.say", $"{reply.Speaker}: {reply.Text}"); } catch { }
        }
    }

    /// <summary>
    /// HUD pump from the JS engine (<c>game.js _pushHud</c>, ~4×/sec).
    /// </summary>
    /// <remarks>
    /// <b>The parameter list is an exact arity contract with the engine — keep them in
    /// step.</b> <c>invokeMethodAsync</c> fails outright when the argument count does not
    /// match, and the engine's call is wrapped in <c>.catch(() =&gt; {})</c>, so a mismatch
    /// is silent: no console error, just a HUD that never updates. Changing this list means
    /// editing <c>game.js _pushHud</c> in the same commit.
    /// </remarks>
    [JSInvokable]
    public void OnHud(int p1Hp, int p2Hp, double elapsed, int[]? p1Regions, int[]? p2Regions,
        int p1Energy, int p2Energy)
    {
        // The pump re-renders the HUD component only (it skips identical pumps itself); the
        // page re-renders just for a new danger milestone, which is live-region text.
        _hud?.Update(p1Hp, p2Hp, elapsed, p1Regions, p2Regions, p1Energy, p2Energy);
        if (UpdateDangerAnnouncements(p1Hp, p2Hp)) InvokeAsync(StateHasChanged);
    }

    // The first reading of a fighter in the red is a milestone the shared live region
    // speaks; leaving the red re-arms it. Returns true when something new was said.
    private bool UpdateDangerAnnouncements(int p1Hp, int p2Hp)
    {
        var said = false;
        if (PoBrawlHud.InDanger(p1Hp))
        {
            if (!_p1DangerAnnounced)
            {
                _p1DangerAnnounced = true;
                if (!_demo) { _announcement = $"{CharName(_p1Char)} is in the red — health critical."; said = true; }
            }
        }
        else
        {
            _p1DangerAnnounced = false;
        }

        if (PoBrawlHud.InDanger(p2Hp))
        {
            if (!_p2DangerAnnounced)
            {
                _p2DangerAnnounced = true;
                if (!_demo) { _announcement = $"{CharName(_p2Char)} is in the red — health critical."; said = true; }
            }
        }
        else
        {
            _p2DangerAnnounced = false;
        }

        return said;
    }

    /// <summary>
    /// Engine → page on every spawn: whether this match is a training session (1P) — its own
    /// method, not an OnMatchStart argument, for the arity reason on OnHud.
    /// </summary>
    [JSInvokable]
    public void OnTrainingState(bool active)
    {
        _training = active;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Engine → page: the KO clip for the result on screen is ready to save.</summary>
    [JSInvokable]
    public void OnClipReady()
    {
        _clipReady = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task SaveClipAsync()
    {
        try { await JSRuntime.InvokeAsync<bool>("PoBrawl.saveClip"); } catch { }
    }

    /// <summary>Engine → page on every spawn. Demo reshuffles its roster in JS, so the resolved
    /// ids keep the HUD names on the fighters underneath them.</summary>
    [JSInvokable]
    public void OnMatchStart(string p1Char, string p2Char)
    {
        if (!string.IsNullOrEmpty(p1Char)) _p1Char = p1Char;
        if (!string.IsNullOrEmpty(p2Char)) _p2Char = p2Char;
        // Every respawn would otherwise be silent to a screen reader.
        _announcement = $"New fight — {CharName(_p1Char)} versus {CharName(_p2Char)}.";
        InvokeAsync(StateHasChanged);
    }

    /// <param name="winner">1 = left fighter, 2 = right fighter, 0 = draw.</param>
    /// <param name="elapsedSeconds">Round clock at the finish.</param>
    /// <param name="recap">
    /// This round's scorecard. Optional so a stale cached engine cannot break the call:
    /// unlike the positional arguments, a missing object binds to null instead of failing
    /// the whole invocation and silently swallowing the match result.
    /// </param>
    [JSInvokable]
    public async Task OnMatchEnd(int winner, double elapsedSeconds, PoBrawlMatchRecap? recap = null)
    {
        _winner = winner;
        _lastKo = elapsedSeconds;
        if (recap is not null) _recap = Accumulate(_recap, recap);
        _lastRecap = recap;

        if (_demo)
        {
            _phase = "result";
            _announcement = winner == 0
                ? "Exhibition over — a draw."
                : $"Exhibition over — {CharName(winner == 1 ? _p1Char : _p2Char)} wins.";
            // Demo is CPU vs CPU, so the result rates the two fighters against each other
            // rather than any player. 2P is excluded: those fighters are human-picked and
            // human-driven, which measures the players, not the roster.
            await RecordDemoFighterEloAsync(winner);
            await InvokeAsync(StateHasChanged);
            // Tell the kiosk reel the post-game phase is up so it can rotate now.
            Kiosk.MarkFinished();
            return;
        }

        // Online: the engine only presents the server's result (netplay.js ends the fight when
        // the server does). The outcome that counts — and the Elo write — arrive separately as
        // matchFinished (OnNetFinishedAsync).
        if (_mode == "online")
        {
            _phase = "result";
            _announcement = winner == 0
                ? "The bell — a draw."
                : $"{(winner == 1 ? _p1Player : _p2Player)} takes it with {CharName(winner == 1 ? _p1Char : _p2Char)}.";
            await InvokeAsync(StateHasChanged);
            if (!_isSpectator) _ = StartPresserAsync();
            return;
        }

        if (_mode == "2p")
        {
            _phase = "result";
            // Name the winner: the modal headline means nothing on a shared keyboard.
            _announcement = winner == 0
                ? "Round over — a draw at the bell."
                : $"Round over — {CharName(winner == 1 ? _p1Char : _p2Char)} takes it.";
            await InvokeAsync(StateHasChanged);
            _ = StartPresserAsync();
            return;
        }

        _gameStats.SaveLastPlayedGame("pobrawl");

        // A new fastest KO is submitted to the global board (session-debounced by _bestKo).
        PoBrawlHighScore? best = null;
        _newRecord = false;
        var won = winner == 1;
        // A KO, not a decision at the bell: a time-up win is not a "KO in 60.00s" record.
        if (won && elapsedSeconds > 0 && elapsedSeconds < 59.9 && (_bestKo == 0 || elapsedSeconds < _bestKo))
        {
            SaveBestKo(elapsedSeconds);
            _newRecord = true;
            best = new PoBrawlHighScore
            {
                // One identity across boards: full display name, not initials.
                PlayerInitials = _playerName,
                KoTimeSeconds = Math.Round(elapsedSeconds, 2),
                Character = _p1Char,
            };
        }

        var result = winner == 0 ? GameResult.Draw : (won ? GameResult.Win : GameResult.Loss);

        // Adaptive ELO (same system as ConnectFive): scored against the
        // beaten/losing president's fixed ladder rating, so early rungs are
        // worth little and Nixon is worth a lot.
        var before = _rating.Elo;
        _rating = _gameStats.RecordAdaptiveResult("pobrawl", _playerName, PresidentElo(_ladder), result);
        _lastEloDelta = _rating.Elo - before;

        // Ladder: a win with presidents still in line rolls straight into the
        // next fight — no modal. The shared end-of-game modal is reserved for
        // the run's *end*: a loss/draw (gauntlet over) or the full-ladder clear.
        var advanceToNext = false;
        if (won)
        {
            if (_ladder >= Roster.Length - 1)
            {
                _champion = true;   // cleared the last rung → triumphant end, show the modal
                _ladder = 0;
                _clears++;
                LocalStorageService.SetItem(ClearsKey, _clears.ToString());
            }
            else
            {
                _ladder++;
                advanceToNext = true;   // another CPU is queued → skip the modal
            }
            SaveLadder();

            // Global ladder board: presidents beaten this run (Roster.Length on a full clear —
            // _ladder has already wrapped to 0). The server keeps each player's best.
            _ = await ApiService.SubmitPoBrawlLadderAsync(new PoBrawlLadderEntry
            {
                PlayerName = _playerName,
                PresidentsBeaten = _champion ? Roster.Length : _ladder,
                Elo = _rating.Elo,
            });
        }

        _stats = await GameResults.RecordAndSubmitPoBrawlAsync(_playerName, result, best);
        UpdateStats();

        // The live region says the 1P result — including the roll-into-the-next-rung path,
        // which shows no modal at all.
        _announcement = won
            ? _champion
                ? $"You beat {CharName(_p2Char)} — the whole ladder is down. Champion!"
                : $"You beat {CharName(_p2Char)}. Next up: {Roster[_ladder].Name}."
            : winner == 0
                ? $"Draw at the bell against {CharName(_p2Char)} — the rung holds."
                : $"Knocked out by {CharName(_p2Char)} — {_ladder} of {Roster.Length} rungs beaten.";

        if (advanceToNext)
        {
            // Hold on the result first (see LadderResultHoldMs). Leaving for training or
            // navigating away inside the hold supersedes this roll.
            var generation = _presserGeneration;
            // The next president's ring introduction is fetched under the hold.
            var nextP2 = Roster[_ladder].Id;
            _p2Char = nextP2;
            PrefetchIntro();
            // The KO cinematic runs on the RENDER clock — frozen in a backgrounded tab — while
            // the hold below is wall-clock. Wait the 'ko' phase out (capped) so the roll never
            // cuts the ragdoll/replay the player was owed; accessor lives in index.js.
            for (var waits = 0; waits < 40; waits++)
            {
                string? enginePhase;
                try { enginePhase = await JSRuntime.InvokeAsync<string?>("PoBrawl.phase"); }
                catch { break; } // engine gone, or an older cached build without the accessor
                if (enginePhase is null || enginePhase != "ko") break;
                await Task.Delay(250);
            }
            await Task.Delay(LadderResultHoldMs);
            if (generation != _presserGeneration || _training) return;

            // Stay in the fight: reset the HUD and roll the engine into the next president.
            // GameOver stays false, so no modal is shown.
            _p2Char = nextP2;
            _phase = "fighting";
            ResetRoundHud();
            await InvokeAsync(StateHasChanged);
            var introLine = await TakeIntroAsync();
            try { await JSRuntime.InvokeVoidAsync("PoBrawl.next", _p2Char, _ladder + 1, introLine); }
            catch (Exception ex) { Console.Error.WriteLine($"[PoBrawl] next-match failed: {ex.Message}"); }
            return;
        }

        _phase = "result";
        await InvokeAsync(StateHasChanged);
        _ = StartPresserAsync();
    }

    /// <summary>Reports one finished demo match to the fighter-Elo board.</summary>
    /// <param name="winner">1 = the left fighter, 2 = the right fighter, 0 = a draw.</param>
    private async Task RecordDemoFighterEloAsync(int winner)
    {
        // AuthGate normally signs the visitor in first; if not, watch silently rather than
        // firing a 401 after every match for as long as the kiosk is left running.
        if (!Auth.IsAuthenticated) return;

        // The engine reshuffles its own roster on restart and reports the pairing through
        // OnMatchStart. A degenerate self-pairing would be rejected server-side, so skip it
        // here instead of spending the request.
        if (string.IsNullOrEmpty(_p1Char) || string.IsNullOrEmpty(_p2Char) || _p1Char == _p2Char) return;

        // Only the left fighter takes the winner slot unless the right one actually won. On a
        // draw the order is arbitrary — IsDraw is what scores the match.
        var leftWon = winner != 2;
        var request = new PoBrawlDemoResultRequest(
            WinnerFighterId: leftWon ? _p1Char : _p2Char,
            LoserFighterId: leftWon ? _p2Char : _p1Char,
            IsDraw: winner == 0);

        // The POST answers with the re-ranked board, which nothing here renders; the write is
        // what feeds the "Brawl Demo" board on /leaderboards.
        await ApiService.SubmitPoBrawlDemoResultAsync(request);
    }

    private void UpdateStats()
    {
        var bucket = _gameStats.GetDifficultyBucket(_stats, Difficulty.Medium);
        _statItems = _mode == "1p"
            ? GameStatsPanel.Build(bucket, includeDraws: false, includeElo: false,
                ("Elo", _rating.Elo.ToString()),
                ("Best KO", _bestKo > 0 ? $"{_bestKo:0.00}s" : "0s"))
            : GameStatsPanel.Build(bucket, includeDraws: false, includeElo: true,
                ("Best KO", _bestKo > 0 ? $"{_bestKo:0.00}s" : "0s"));
    }

    private string ResultLine()
    {
        if (_mode == "online")
        {
            var how = _netResult?.Forfeit == true ? " by forfeit"
                : _net?.State?.LastEvent == "ko" ? " by knockout"
                : " on the cards";
            if (_netResult is { } r && !_isSpectator)
            {
                return r.Outcome switch
                {
                    PoMiniGames.Shared.Games.PoBrawlOutcome.Win => $"🏆 You beat {OpponentPlayer}{how}!",
                    PoMiniGames.Shared.Games.PoBrawlOutcome.Loss => $"💀 {OpponentPlayer} beat you{how}.",
                    _ => "🤝 Dead even at the bell — a draw.",
                };
            }
            if (_winner == 0) return "🤝 Dead even at the bell — a draw.";
            return $"🏆 {(_winner == 1 ? _p1Player : _p2Player)} wins{how} with {CharName(_winner == 1 ? _p1Char : _p2Char)}!";
        }

        if (_mode == "2p")
        {
            if (_winner == 0) return "🤝 Too close to call — draw!";
            return $"🏆 {CharName(_winner == 1 ? _p1Char : _p2Char)} wins — Player {_winner}!";
        }

        // A 1P draw ends the run without advancing the ladder: the rung is not cleared.
        if (_winner == 0) return $"🤝 Too close to call — {CharName(_p2Char)} holds the rung.";
        return _winner == 1
            ? $"🏆 BOB knocked out {CharName(_p2Char)}!"
            : $"💀 {CharName(_p2Char)} beat BOB — rematch!";
    }

    private static string CharName(string id) =>
        PickableRoster.FirstOrDefault(r => r.Id == id)?.Name ?? id;

    private static int LadderRungOf(string presidentId)
    {
        var idx = Array.FindIndex(Roster, r => r.Id == presidentId);
        return idx < 0 ? 0 : idx;
    }

    private int LoadLadder()
    {
        var raw = LocalStorageService.GetItem<string>(LadderKey);
        return int.TryParse(raw, out var i) ? Math.Clamp(i, 0, Roster.Length - 1) : 0;
    }

    /// <summary>
    /// Persist the rung here and, signed in, on the server (PUT /api/pobrawl/progress) so the run
    /// follows the player to another device. The timestamp is what lets the newer copy win on load.
    /// </summary>
    private void SaveLadder()
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        LocalStorageService.SetItem(LadderKey, _ladder.ToString());
        LocalStorageService.SetItem(LadderAtKey, now.ToString());
        if (!Auth.IsAuthenticated) return;
        _ = ApiService.SavePoBrawlProgressAsync(new PoMiniGames.Shared.Games.PoBrawlProgressDto
        {
            Rung = _ladder,
            BestKoSeconds = _bestKo,
            Clears = _clears,
            UpdatedAtUnixMs = now,
        });
    }

    private void SaveBestKo(double seconds)
    {
        _bestKo = Math.Round(seconds, 2);
        LocalStorageService.SetItem(BestKoKey, _bestKo.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    public async ValueTask DisposeAsync()
    {
        PlayerNameService.StateChanged -= OnPlayerNameChanged;
        Auth.StateChanged -= OnAuthSettled;
        try { await JSRuntime.InvokeVoidAsync("PoBrawl.destroy"); } catch { }
        // Leaving the page mid-fight is a drop: the server's reconnect grace starts now.
        if (_net is not null) await _net.DisposeAsync();
        _ref?.Dispose();
    }
}

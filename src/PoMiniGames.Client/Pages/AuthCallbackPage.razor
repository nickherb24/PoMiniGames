@page "/auth/callback"
@page "/auth/login/microsoft"
@using PoMiniGamesClient.Services
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

@* §2026-07-13: Microsoft OAuth redirect-flow landing page.
   MSAL.js redirected the browser here with the auth code in the URL fragment
   after the user signed in on login.microsoftonline.com (used when the popup
   flow is blocked by the host browser). AuthState's handshake already ran
   during initialisation; here we call poAuth.handleRedirect() to consume the
   auth code, then bounce back to "/". If MSAL never produced a result (the
   user closed the Microsoft tab mid-flow) we surface a clear message. *@

<PageTitle>Signing you in… · PoMiniGames</PageTitle>

<div class="auth-callback-page">
    @if (_error is null && !_finished)
    {
        <p>Completing sign-in...</p>
    }
    else if (_error is not null)
    {
        <h1>Sign-in couldn't be completed</h1>
        <p>@_error</p>
        <button class="app-btn app-btn--primary" @onclick="GoHome">Back to home</button>
    }
</div>

@code {
    private string? _error;
    private bool _finished;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Re-run the handshake + handleRedirect flow. On a redirect callback
            // landing, this drains the MSAL auth code from the URL hash and
            // applies the session.
            await AuthState.InitializeAsync();
            _finished = true;
            // Give the user a brief flash of "Completing sign-in..." then bounce home.
            await Task.Delay(200);
            NavigationManager.NavigateTo("/", replace: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void GoHome() => NavigationManager.NavigateTo("/", replace: true);

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}

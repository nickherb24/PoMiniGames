@page "/login"
@layout PoMiniGamesClient.Layout.BareLayout
@using PoMiniGamesClient.Components
@using PoMiniGamesClient.Services
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject ToastService ToastService

@* ─────────────────────────────────────────────────────────────────────────
   Addressable sign-in page.

   The gate itself lives in AuthGate, which renders <LoginScreen /> in place of
   any route until a session exists — so in normal use a visitor never has to
   navigate here; they simply cannot get past the front door without signing in.
   This route exists so the login screen also has a URL worth linking to: a
   "sign in" link in an email, a bookmark, or a redirect target.

   It uses BareLayout, not MainLayout or EmptyLayout: both of those render the
   top bar, which offers a "Sign out" button to a visitor who has no session and
   a brand link back into the gate they are standing at. LoginScreen paints its
   own full-page surface, so it needs no layout chrome at all.

   Reached while already signed in — a stale bookmark, or a back-button press
   after signing in — it bounces to the home page rather than showing a signed-in
   user a sign-in form.
   ───────────────────────────────────────────────────────────────────────── *@

<PageTitle>Sign in · PoMiniGames</PageTitle>

@if (!AuthState.IsLoading && AuthState.IsAuthenticated)
{
    @* Nothing: OnAfterRender has already redirected. Rendering LoginScreen here
       would flash a sign-in form at a signed-in user for one frame. *@
}
else
{
    <LoginScreen />
}

@code {
    private bool _alreadySignedInToastShown;

    protected override void OnAfterRender(bool firstRender)
    {
        // Redirect on afterRender rather than OnInitialized: during the initial
        // handshake IsAuthenticated is false and IsLoading is true, so deciding
        // any earlier would bounce a signed-in user straight back to /login in a
        // loop. `replace: true` keeps /login out of the back-button history.
        //
        // A silent redirect would mislead any visitor who clicked "Sign in" from
        // an article link, an email, or a bookmark while already signed in: with
        // no acknowledgement they assume the link was broken. Toast once
        // (guarded by a flag so the OnAfterRender re-render after the redirect
        // navigation doesn't fire a second time).
        if (!AuthState.IsLoading && AuthState.IsAuthenticated)
        {
            if (!_alreadySignedInToastShown)
            {
                _alreadySignedInToastShown = true;
                ToastService.Show("You're already signed in.", ToastType.Info);
            }
            Navigation.NavigateTo("/", replace: true);
        }
    }
}

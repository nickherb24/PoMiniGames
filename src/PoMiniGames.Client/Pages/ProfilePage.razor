@page "/profile"
@using Microsoft.AspNetCore.Components
@using PoMiniGamesClient.Models
@using PoMiniGamesClient.Services
@inject PlayerNameService PlayerNameService
@inject GameStatsService GameStatsService
@inject ApiService ApiService
@inject MatchHistoryService MatchHistory
@inject NavigationManager NavigationManager
@inject AuthStateService AuthState
@inject ToastService Toasts
@inject IJSRuntime JS
@inject InviteService Invites
@implements IDisposable

<PageTitle>My Stats · PoMiniGames</PageTitle>

<div class="prf-page">
@if (_loading)
{
    @* role="status" is required, not decorative: `aria-label` is prohibited on a
       plain <div> with no role (axe: aria-prohibited-attr), so the label was
       being dropped and the loading state announced as nothing at all. "status"
       is the right role for a transient progress message and gives the label
       somewhere to live. 2026-09-11 UI audit. *@
    <div class="profile-skel" role="status" aria-busy="true" aria-label="Loading profile">
        <div class="profile-skel__header">
            <div class="profile-skel__avatar"></div>
            <div class="profile-skel__lines">
                <div class="profile-skel__line profile-skel__line--w70"></div>
                <div class="profile-skel__line profile-skel__line--w40"></div>
                <div class="profile-skel__line profile-skel__line--w55"></div>
            </div>
        </div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
        <div class="profile-skel__row"></div>
    </div>
}
else
{
    @* One page, no tabs (2026-10-01). The five tabs (Overview, Gamer Card, High Scores,
       Head-to-Head, Games & Data) each showed a slice of the same record: win rate
       three times, W/L/D three times, streak and rating twice. They were also
       unreachable on a phone, where the tab strip ran 300px past the screen edge.

       The Gamer Card is the hero. Under it, one strip of headline numbers, one card
       per game the player has touched (its best score, its record and its ratings in
       the same card), the head-to-head tables, and the two charts folded away.
       "Your data" moved to the settings sheet, with the other account controls. *@
    <header class="prf-head">
        @* The display name is not repeated here: it is the headline of the card below. *@
        <h1 class="prf-name">My Stats</h1>
    </header>

    <PlayerCard PlayerName="@_playerName" />

    @* "Saved matches" counts FINISHED, PERSISTED matches (the W/L record). Sessions
       that carry no outcome (a Joker set, a guest's unsynced plays) ride beside it
       so "0" is not the whole story (browser audit #6, 2026-08-10). A stat the
       player has not earned yet is a dash with its how-to in the tooltip; the
       sentences that used to sit under each chip made the hero 361px on a phone.

       With nothing recorded at all the row is left out: it was four boxes reading
       0 and three dashes, under a card that already says "No ranked games yet". *@
    @if (_totalGames > 0 || _unsyncedSessions > 0)
    {
    <div class="prf-chips">
        <div class="prf-chip" title="@(_unsyncedSessions > 0
                ? (IsGuestUser()
                    ? "Guest plays are kept on this device. Sign in to save them to your leaderboard."
                    : "This visit's plays are counted locally and join Saved Matches on the next sync.")
                : null)">
            <span class="prf-chip-val">@(_unsyncedSessions > 0 ? $"{_totalGames} +{_unsyncedSessions}" : _totalGames.ToString())</span>
            <span class="prf-chip-lbl">Saved Matches</span>
        </div>
        <div class="prf-chip" title="@(_totalGames > 0 ? $"{_totalWins} wins, {_totalDraws} draws, {_totalLosses} losses" : "Play a 1-player match to start a record")">
            <span class="prf-chip-val">@(_totalGames > 0 ? $"{_totalWins * 100 / _totalGames}%" : "—")</span>
            <span class="prf-chip-lbl">Win Rate</span>
        </div>
        @if (_totalGames > 0)
        {
            <div class="prf-chip">
                <span class="prf-chip-val">@_totalWins–@_totalDraws–@_totalLosses</span>
                <span class="prf-chip-lbl">W–D–L</span>
            </div>
        }
        <div class="prf-chip" title="@(_bestStreak > 0 ? null : "Win 2 or more in a row on a 1-player CPU game to set your first streak")">
            <span class="prf-chip-val">@(_bestStreak > 0 ? _bestStreak.ToString() : "—")</span>
            <span class="prf-chip-lbl">Best Streak</span>
        </div>
        @* AdaptiveRating.StartingElo is 1200 (GameModels.cs): at or below it, nothing has been won. *@
        <div class="prf-chip" title="@(_topElo > 1200 ? null : "Win a 1-player match to climb past the 1200 starting rating")">
            <span class="prf-chip-val">@(_topElo > 1200 ? _topElo.ToString() : "—")</span>
            <span class="prf-chip-lbl">Top ELO</span>
        </div>
        @if (_bestEntry != null)
        {
            <div class="prf-chip prf-chip--best" title="@($"{_bestEntry.WinRate:P0} win rate over {_bestEntry.TotalGames} played")">
                <span class="prf-chip-val">🏆 @_bestEntry.Label</span>
                <span class="prf-chip-lbl">Best Game</span>
            </div>
        }
        @if (_nemesisEntry != null)
        {
            <div class="prf-chip prf-chip--nemesis" title="@($"{_nemesisEntry.WinRate:P0} win rate over {_nemesisEntry.TotalGames} played")">
                <span class="prf-chip-val">💀 @_nemesisEntry.Label</span>
                <span class="prf-chip-lbl">Nemesis</span>
            </div>
        }
    </div>
    }

    <!-- ── Games: one card per game played, the rest on one line ── -->
    var best = _highScoresByKey;
    var played = _entries.Where(g => HasActivity(g, best)).ToList();
    var unplayed = _entries.Where(g => !HasActivity(g, best)).ToList();

    <section class="prf-section">
        <h2 class="prf-section-title">Games</h2>
        @if (_highScoreLoadFailed)
        {
            <ErrorState Icon="⚠️"
                        Title="Couldn't load saved high scores"
                        OnRetry="() => LoadHighScoresAsync()">
                The leaderboard endpoints didn't respond. The records below are
                still accurate; only the cross-device best scores are missing.
            </ErrorState>
        }
        @if (played.Count > 0)
        {
            <div class="prf-game-grid">
                @foreach (var g in played)
                {
                    <div class="prf-game-card">
                        <div class="prf-game-header">
                            <span class="prf-game-icon">@g.Icon</span>
                            <span class="prf-game-name">@g.Label</span>
                            @* The server board's number (a score, a time), for the games that
                               have one. The AI games' "best" is their ELO, which the rating
                               rows below already carry. *@
                            @if (ScoreOf(g, best) is { } score)
                            {
                                <span class="prf-game-best" title="Your best on the leaderboard">@score</span>
                            }
                            @if (g.TotalGames > 0)
                            {
                                <span class="prf-game-wr">@g.WinRate.ToString("P0")</span>
                            }
                        </div>
                        @if (g.TotalGames > 0)
                        {
                            <div class="prf-bar" title="Win / Draw / Loss" style="--win-pct:@((int)g.WinPercent)%;--draw-pct:@((int)g.DrawPercent)%;--loss-pct:@((int)g.LossPercent)%">
                                <div class="prf-bar-win"></div>
                                <div class="prf-bar-draw"></div>
                                <div class="prf-bar-loss"></div>
                            </div>
                            <div class="prf-diffs">
                                @foreach (var d in g.Difficulties.Where(x => x.TotalGames > 0))
                                {
                                    <div class="prf-diff-row">
                                        <span class="prf-diff-name prf-diff-@d.Name.ToLowerInvariant()">@d.Name</span>
                                        <span class="prf-diff-wld">@d.Wins W · @d.Losses L · @d.Draws D</span>
                                        @if (d.EloRating != 1000)
                                        {
                                            <span class="prf-diff-elo">ELO @d.EloRating</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (g.Kind == RatingKind.PlayCountOnly)
                        {
                            <p class="prf-game-plays">
                                <span class="prf-game-plays-val">@g.PlayCount</span>
                                <span class="prf-game-plays-lbl">@(g.PlayCount == 1 ? "session" : "sessions")</span>
                                <a class="prf-game-link" href="@DemoUrl(g.Key)">Watch again →</a>
                            </p>
                        }
                    </div>
                }
            </div>
        }
        @if (unplayed.Count > 0)
        {
            @* Every game still has a named entry here (a profile that listed three of
               ten games is the bug ProfileCoverageUiTests pins), but an unplayed one is
               a chip that starts the game, not a card saying "Not played yet". *@
            <div class="prf-unplayed">
                <span class="prf-unplayed-label">@(played.Count == 0 ? "Nothing played yet. Pick one:" : "Not played yet")</span>
                @foreach (var g in unplayed)
                {
                    <a class="prf-unplayed-chip" href="@PlayUrl(g.Key)">
                        <span class="prf-game-icon" aria-hidden="true">@g.Icon</span>
                        <span class="prf-game-name">@g.Label</span>
                    </a>
                }
            </div>
        }
    </section>

    <!-- ── Head-to-Head ── -->
    @if (_matchesLoading || _localOpponents.Count > 0 || _onlineOpponents.Count > 0)
    {
        <section class="prf-section">
            <div class="prf-section-head">
                <h2 class="prf-section-title">Head-to-Head · People You Played</h2>
                <span class="prf-h2h-legend" aria-label="Badge legend">
                    <span class="prf-h2h-badge prf-h2h-badge--guest" aria-hidden="true">G</span>
                    <span class="prf-h2h-legend-lbl">Guest</span>
                    <span class="prf-h2h-badge prf-h2h-badge--microsoft" aria-hidden="true">MS</span>
                    <span class="prf-h2h-legend-lbl">Microsoft</span>
                </span>
            </div>
            @if (_matchesLoading)
            {
                <p class="prf-h2h-note">Loading match history…</p>
            }
            else
            {
                <div class="prf-h2h-cols">
                    @if (_localOpponents.Count > 0)
                    {
                        <div class="prf-h2h-col">
                            <h3 class="prf-h2h-mode">👥 2-Player (local)</h3>
                            @RenderOpponentTable(_localOpponents, false)
                        </div>
                    }
                    @if (_onlineOpponents.Count > 0)
                    {
                        <div class="prf-h2h-col">
                            <h3 class="prf-h2h-mode">🌐 Online Multiplayer</h3>
                            @RenderOpponentTable(_onlineOpponents, true)
                        </div>
                    }
                </div>
            }
        </section>
    }

    <!-- ── Charts: the same record, drawn. Folded, because the cards above say it. ── -->
    @if (_totalGames > 0)
    {
        <details class="prf-fold">
            <summary class="prf-section-title">Charts</summary>
            <div class="prf-charts">
                <div class="prf-chart-card">
                    <h3 class="prf-chart-title">Win Rate by Game</h3>
                    @((MarkupString)BuildRadarSvg())
                </div>
                <div class="prf-chart-card">
                    <h3 class="prf-chart-title">Overall Record</h3>
                    @((MarkupString)BuildDonutSvg())
                    <div class="prf-donut-legend">
                        <span class="prf-legend-dot prf-legend-win"></span><span>Wins&nbsp;@_totalWins</span>
                        <span class="prf-legend-dot prf-legend-draw"></span><span>Draws&nbsp;@_totalDraws</span>
                        <span class="prf-legend-dot prf-legend-loss"></span><span>Losses&nbsp;@_totalLosses</span>
                    </div>
                </div>
            </div>
        </details>
    }
}
</div>

@code {
    // Only the markup-bearing member lives here. Everything else moved to
    // ProfilePage.razor.cs on 2026-09-11 — see that file for why.
    //
    // This one cannot move: a RenderFragment written as inline Razor markup is
    // compiled by the Razor generator, not by csc, so it has to stay in the .razor.

    private RenderFragment RenderOpponentTable(List<OpponentRecord> opponents, bool invitable) => __builder =>
    {
        @*
            §2: <Virtualize> wraps the opponent table body. A player's full head-to-head
            history is unbounded (each new opponent is a new row), so without virtualization
            a profile page with 200+ opponents scrolls janky and allocates a DOM node per
            opponent. The virtualizer recycles rows in a 48 px slot, keeping the DOM flat.
        *@
        <div class="prf-h2h-vwrap">
            <table class="prf-h2h-table">
                <thead>
                    <tr>
                        <th>Opponent</th><th>W</th><th>L</th><th>D</th><th>Record</th>
                        @if (invitable)
                        {
                            <th class="prf-h2h-invite" aria-label="Invite"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="opponents" Context="o" ItemSize="48">
                        <tr>
                            <td class="prf-h2h-name">
                                <span class="prf-h2h-badge prf-h2h-badge--@o.Type" title="@(o.Type == "microsoft" ? "Microsoft account" : "Guest")">@(o.Type == "microsoft" ? "MS" : "G")</span>
                                @o.Name
                            </td>
                            <td class="prf-h2h-w">@o.Wins</td>
                            <td class="prf-h2h-l">@o.Losses</td>
                            <td class="prf-h2h-d">@o.Draws</td>
                            <td>@o.Wins–@o.Losses–@o.Draws</td>
                            @if (invitable)
                            {
                                @* Online opponents only: a local 2-player name is whatever was
                                   typed on this device, not someone who can be reached. *@
                                <td class="prf-h2h-invite">
                                    <button type="button" class="app-btn app-btn--secondary app-btn--sm"
                                            disabled="@(_inviting == o.Name)"
                                            aria-label="@($"Invite {o.Name} to play again")"
                                            @onclick="() => InviteAsync(o)">Invite</button>
                                </td>
                            }
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    };
}

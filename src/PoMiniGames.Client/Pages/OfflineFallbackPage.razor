@page "/offline"
@namespace PoMiniGamesClient.Pages
@inject NavigationManager Nav
@inject OnlineStatusService Online
@implements IDisposable

@*
    Offline fallback page.

    Cached by service-worker.published.js via the SPA-navigation rule (any
    `request.mode === 'navigate'` falls back to the precached `index.html`,
    which the router then serves `/offline` from). The page is registered at
    /offline and reachable directly while online, but the primary use case
    is "the SW intercepted a navigation and we have nothing else to show".

    The page is intentionally sparse — no game list, no leaderboards, no
    auth flows. Those all need the network; promising them and then failing
    is worse than not showing them. Instead: a single retry button (full
    reload — the SPA caches may have come unstuck) plus a "Back to home"
    fallback. The home page itself is precached so the latter works offline.
*@

<PageTitle>Offline — PoMiniGames</PageTitle>

<div class="gl-viewport">
    <EmptyState Icon="📡"
                Title="You're offline">
        <ChildContent>
            We can't load new data while you're disconnected. Cached games still work —
            head back to the home page and pick one. If your scores don't show up yet,
            they'll sync the next time you're online.
        </ChildContent>
        <Action>
            <button class="app-btn app-btn--primary"
                    type="button"
                    @onclick="RetryAsync">
                Try again
            </button>
            <button class="app-btn app-btn--ghost"
                    type="button"
                    style="margin-left: var(--space-2);"
                    @onclick="GoHome">
                Back to home
            </button>
        </Action>
    </EmptyState>
</div>

@code {
    protected override void OnInitialized()
    {
        Online.StateChanged += HandleConnectivityChanged;
    }

    private void HandleConnectivityChanged()
    {
        // Auto-recover: when connectivity returns, kick the user back to where
        // they came from (or home if there is no history). Better than leaving
        // them staring at this card after the OS reconnects in the background.
        if (Online.IsOnline) InvokeAsync(GoHome);
    }

    private async Task RetryAsync()
    {
        // Full reload — the SPA's in-memory state is stale anyway, and a reload
        // also re-evaluates whether the SW has any new cached content for the
        // route the user was trying to reach.
        await Task.Yield();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private void GoHome() => Nav.NavigateTo("/");

    public void Dispose() => Online.StateChanged -= HandleConnectivityChanged;
}
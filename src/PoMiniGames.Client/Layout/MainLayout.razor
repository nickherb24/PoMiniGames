@inherits LayoutComponentBase
@implements IDisposable
@using PoMiniGamesClient.Models
@inject AuthStateService AuthState
@inject ToastService ToastService
@inject KioskCoordinator Kiosk
@inject ScoreSyncService ScoreSync
@inject UiFeedbackService Feedback
@inject ScreenFxService ScreenFx
@inject IJSRuntime JS
@inject SettingsService Settings
@inject OnlineStatusService OnlineStatus
@inject AppUpdateService AppUpdate
@inject PlaySessionService PlaySessions
@inject NavigationManager NavigationManager

<div class="gl-page">
    @* 2026-08-07 browser audit #9: first tab stop on every route. The header is
       persistent chrome (brand, game title, back link, identity, Sign out), so a
       keyboard or screen-reader user had to walk all of it again on every single
       navigation before reaching the game. Visually hidden until focused. *@
    <a class="gl-skip-link" href="#main-content">Skip to content</a>

    @* Offline is silent without this: the service worker serves a fully working app
       shell with no network, so an online-only game failing would read as a bug
       rather than as a connection problem. Scores earned offline are parked by
       ScoreSyncService and replayed on reconnect — say so, so it isn't lost work. *@
    @if (!OnlineStatus.IsOnline)
    {
        <div class="gl-offline-banner" role="status" aria-live="polite">
            <span class="gl-offline-dot" aria-hidden="true"></span>
            <span>Offline — you can keep playing. Scores will sync when you reconnect.</span>
        </div>
    }
    @* §9 mock banner — desktop gets the full-width shimmer banner; mobile gets
       a tappable dot that expands to the same label. Keeps the safety guard
       visible without sacrificing ~36 px of chrome on portrait phones.

       Browser audit #5 (2026-08-10): the full-width banner read as an error/
       warning to a first-time visitor who hit "Continue as Guest" on a sign-in
       page that was already gated on auth being disabled. The mock data flag
       is a server-side concern (Storage is in dev or a CI stub), not a user
       concern. Surface it as a tiny dev-only corner pill with a tooltip; the
       full banner + dot stays as a tooltip-driven secondary affordance for
       devs who actually want to see why /leaderboards is empty. *@
    @if (AuthState.UsingMockData)
    {
        <div class="gl-mock-banner">
            <span class="gl-mock-banner__pill" title="Mock data backend — leaderboards may be empty. This is a developer / preview-build signal, not an error." aria-label="Mock data backend active for this build">
                <span aria-hidden="true">🧪</span> USING MOCK DATA
            </span>
            <span class="gl-mock-banner__detail">USING MOCK DATA — leaderboards may be empty</span>
        </div>
    }
    <header class="gl-top-bar">
        @* 2026-08-08 audit #10: <nav> landmark. The brand link and the game
           Quick Switcher ARE this app's persistent navigation on every route,
           but they were plain <div>s, so a screen-reader user had no landmark to
           jump to — an axe sweep found zero navigation landmarks across all 20
           pages. Labelled because a second <nav> (in-game) may appear later, and
           unlabelled sibling landmarks are indistinguishable in a landmark list. *@
        <nav class="gl-top-bar-left" aria-label="Main">
            <a href="/" class="gl-brand">
                <span class="gl-brand-icon">
                    <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="3" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                        <rect x="23" y="5" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                        <rect x="3" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.5"/>
                        <rect x="23" y="23" width="14" height="14" rx="2" fill="currentColor" opacity="0.8"/>
                    </svg>
                </span>
                <span class="gl-brand-text">PoMiniGames</span>
            </a>

            @* 2026-08-12 (user request): the Browse menu added in audit #4 was
               removed on the same day — same fate as the 2026-08-10 "Games"
               quick-switcher and the GameShell "← Game hub" pill. The brand
               already returns to the catalog grid, which is one tap from any
               game; a top-bar control that navigates away from the game
               duplicates that and crowds the chrome. *@
        </nav>

        @* Consolidated game header: the active game (via GameShell) projects its
           status + settings into this single top bar, so game pages no longer
           render a separate second row. Empty on non-game pages. The game's
           status lives on the right of the middle rail (after the FPS counter)
           so the FPS pill sits closer to the visual centre, between the brand
           on the left and the session controls on the right. *@
        <div class="gl-top-bar-center">
            <FpsCounter />
            <div class="gl-top-bar-game">
                <SectionOutlet SectionName="game-header" />
            </div>
        </div>

        <div class="gl-auth">
            @* ⚙️ settings gear and 🔧 dev switch-user wrench removed per user
               request (2026-07-13). Master mute / FPS-badge toggles and the
               dev-only identity switcher are gone from the top bar entirely. *@
            @if (AuthState.IsConfigured && !AuthState.IsLoading)
            {
                @* Live ELO badge for single-player rated games, projected here by
                   GameShell so it sits right beside the player's identity. Renders
                   nothing outside a rated 1P game. *@
                <SectionOutlet SectionName="game-elo" />
                @* The account menu (2026-10-01): the name chip is the one button, and it
                   holds every page-level destination. It replaced a bare name, an
                   always-visible Sign out pill, three of the hub's four action buttons
                   and the footer's Settings link, and it is the only way to the settings
                   sheet from inside a game (the footer is hidden on game routes). No
                   gear: the 2026-07-13 call stands.

                   There is no signed-out branch. AuthGate renders the login screen in
                   place of this layout until a session exists, so the Sign in / ANON /
                   ⋯ controls that used to sit here could only ever show on the
                   /auth/callback page, for the moment it takes to finish signing in.

                   Native Popover API: light-dismiss, Escape-to-close and the top layer
                   come free. popovertargetaction="hide" closes the panel on activation
                   and the @onclick still runs. *@
                @if (AuthState.IsAuthenticated)
                {
                    <button type="button" class="gl-account-trigger"
                            popovertarget="gl-account-menu"
                            aria-label="@($"Account menu, signed in as {AuthUserLabel}")"
                            title="@AuthUserTitle">
                        <span class="gl-account-initial" aria-hidden="true">@AuthUserInitial</span>
                        <span class="gl-account-name" aria-hidden="true">@AuthUserLabel</span>
                        <span class="gl-account-caret" aria-hidden="true">▾</span>
                    </button>
                    <div id="gl-account-menu" popover="auto" class="gl-overflow-panel">
                        <button type="button" class="gl-overflow-item"
                                popovertarget="gl-account-menu" popovertargetaction="hide"
                                @onclick='() => GoTo("/profile")'>My Stats</button>
                        <button type="button" class="gl-overflow-item"
                                popovertarget="gl-account-menu" popovertargetaction="hide"
                                @onclick='() => GoTo("/leaderboards")'>Leaderboards</button>
                        <button type="button" class="gl-overflow-item"
                                popovertarget="gl-account-menu" popovertargetaction="hide"
                                @onclick="Settings.RequestOpen">Settings</button>
                        <button type="button" class="gl-overflow-item gl-overflow-item--sep"
                                popovertarget="gl-account-menu" popovertargetaction="hide"
                                @onclick="SignOut">Sign out</button>
                    </div>
                }
            }
        </div>
    </header>

    @* tabindex="-1" so the skip link can actually move focus here: without it the
       browser scrolls to <main> but leaves focus on the link, and the next Tab
       goes straight back into the header. *@
    <main class="gl-content" id="main-content" tabindex="-1">
        @Body
    </main>

    @if (ToastService.Toasts.Count > 0)
    {
        <div class="toast-stack" role="log" aria-live="polite" aria-label="Notifications">
            @foreach (var toast in ToastService.Toasts)
            {
                @* data-toast-id: the after-render FX pass needs to burst from THIS
                   toast's box, and a selector on the class alone would always hit
                   the oldest one in the stack. *@
                <div class="toast toast--@toast.Type.ToString().ToLowerInvariant()"
                     data-toast-id="@toast.Id" role="alert">
                    <span class="toast-msg">@toast.Message</span>
                    @if (toast.Action is not null)
                    {
                        <button class="toast-action" @onclick="() => RunToastAction(toast)">@toast.ActionLabel</button>
                    }
                    <button class="toast-close" @onclick="() => ToastService.Dismiss(toast.Id)" aria-label="Dismiss">×</button>
                </div>
            }
        </div>
    }

    @* Kiosk reel controls. Restored after the 2026-07-04 cleanup removed the bar
       but left the coordinator's Pause/Skip/Exit API — and left a player who
       started the reel unable to stop it from inside a demo. Renders nothing
       unless the reel is actually running, so the portrait-chrome concern that
       motivated the original removal does not apply. *@
    <KioskControlBar />

    <!-- §9 Bottom-tab-bar REMOVED per user request (2026-07-05): the 3-icon
         Home/Scores/Me strip on mobile portrait was removed. The top bar's
         brand + Sign in/Sign out affordance is the only nav surface now. -->

    @* 2026-08-10 audit: the app had <header>, <nav>, and <main> landmarks but
       no <footer>, so a screen-reader user had no site-info landmark to jump
       to on the 18 routes. Footer renders below the page content (no overlap
       with the sticky top bar) and surfaces the build version + a "support"
       link — both of which were previously only available via /api/diag.

       2026-09-11 UI sweep (option 9): the ~54px footer was exactly the space a
       portrait game page needed to fit without vertical scroll (measured: PoBrawl
       +33px, PoJoker +49px over the fold — both under the footer's height), and
       its links are support/dev surfaces, not gameplay surfaces; the brand link
       already returns to the hub, where the footer remains. Hidden on game
       routes only — the contentinfo landmark stays on every other route. *@
    @if (!IsGameRoute)
    {
        <footer class="gl-footer" aria-label="Site information">
            <span class="gl-footer-build">PoMiniGames</span>
            @* Settings lives in the top bar's account menu, which is on every route. *@
            <a class="gl-footer-link" href="/health" aria-label="Service health">Status</a>
        </footer>
    }

    @* The one settings sheet. Mounted here so it exists on every route; it opens
       itself when anything calls Settings.RequestOpen(). *@
    <SettingsSheet />
</div>

@code {
    private Action? _onAuthStateChanged;
    private Action? _onOnlineStateChanged;
    private Action? _onToastsChanged;
    private Action<int>? _onScoresFlushed;
    private Action? _onOnlineFlush;
    private EventHandler<LocationChangedEventArgs>? _onLocationChanged;

    // 2026-09-11 UI sweep: first path segment match — every game keeps all of
    // its routes under one segment (/pobrawl, /pobrawl/demo, /posports/lobby,
    // /couplequiz/game, …), so segment[0] alone decides. Keep in sync with
    // src/PoMiniGames.Client/Games/. Drives footer suppression (see footer note).
    private static readonly HashSet<string> GameRoutePrefixes = new()
    {
        "tictactoe", "connectfive", "pobrawl", "funquiz", "pojoker",
        "pomarblerace", "posports", "povoxelstrike",
        "sandplayground", "poecosystem", "poracer", "couplequiz",
        "pocabinet", "pojevarena",
    };

    private bool IsGameRoute
    {
        get
        {
            var path = new Uri(NavigationManager.Uri).AbsolutePath.Trim('/');
            if (path.Length == 0) return false;
            return GameRoutePrefixes.Contains(path.Split('/')[0]);
        }
    }

    // Top-bar identity for a signed-in user: prefer the display name, fall back to
    // the email/username. The full email is surfaced via the tooltip so a truncated
    // name in the pill is still resolvable on hover.
    private string AuthUserLabel
    {
        get
        {
            var user = AuthState.User;
            if (user is null) return string.Empty;
            if (!string.IsNullOrWhiteSpace(user.DisplayName)) return user.DisplayName;
            return user.Email ?? string.Empty;
        }
    }

    private string AuthUserInitial =>
        AuthUserLabel.Length > 0 ? char.ToUpperInvariant(AuthUserLabel[0]).ToString() : "?";

    private string AuthUserTitle
    {
        get
        {
            var user = AuthState.User;
            if (user is null) return string.Empty;
            return string.IsNullOrWhiteSpace(user.Email) ? AuthUserLabel : user.Email;
        }
    }

    // `IsHome` lived here to gate the 🎮 quick switcher on non-home routes. The switcher
    // was removed on 2026-08-10 and nothing else read the property, so it went with it.

    protected override void OnInitialized()
    {
        // Auth is initialized by <AuthGate> before MainLayout ever renders, so here we
        // only subscribe for live updates (e.g. sign-out). The handler is held in a
        // field so Dispose can detach it — an inline lambda could never be
        // unsubscribed and would leak this component on every re-creation.
        _onAuthStateChanged = () => InvokeAsync(StateHasChanged);
        AuthState.StateChanged += _onAuthStateChanged;

        // §10 fire the mock-data buzz once on mount so the developer notices
        // the safety guard when they hit the home page in a mock-data env.
        if (AuthState.UsingMockData)
        {
            _ = Feedback.MockDataAsync();
        }

        _onOnlineStateChanged = () => InvokeAsync(StateHasChanged);
        OnlineStatus.StateChanged += _onOnlineStateChanged;

        // The payoff moment for the whole offline-score story: parked runs reaching
        // the board. Subscribed to the service rather than fired at the sign-in call
        // site, because a flush now has three triggers (sign-in, app start,
        // reconnect) and the celebration should not belong to whichever one the
        // feature started life with.
        _onScoresFlushed = count => InvokeAsync(() => CelebrateFlushAsync(count));
        ScoreSync.Flushed += _onScoresFlushed;

        // Coming back online is the canonical moment to drain the queue — the
        // service's own summary has always promised "whenever the API is reachable
        // again", but sign-in was the only thing that ever called it, so a player
        // who went offline mid-session and came back had to sign out and in to get
        // their runs onto the board.
        _onOnlineFlush = () =>
        {
            if (OnlineStatus.IsOnline) _ = ScoreSync.FlushAsync();
        };
        OnlineStatus.StateChanged += _onOnlineFlush;

        // The toast stack is rendered by THIS component but filled by services and
        // by whatever page happens to be inside @Body. Blazor re-renders only the
        // component that handled an event, so without this subscription a toast
        // raised from a page or a background flush did not appear until something
        // unrelated — an auth change, an online/offline flip — re-rendered the
        // layout for other reasons.
        _onToastsChanged = () => InvokeAsync(StateHasChanged);
        ToastService.StateChanged += _onToastsChanged;

        // Route-transition wipe, tinted to the destination's accent. Driven from here
        // because Blazor WASM navigation raises no DOM event a JS module could hear —
        // paletteBus only catches popstate, and the musicDirector polls at 1.2 s,
        // which is far too coarse to start a 260 ms transition on.
        _onLocationChanged = (_, args) => _ = PlayRouteWipeAsync(args.Location);
        NavigationManager.LocationChanged += _onLocationChanged;

        Settings.Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Before the firstRender gate: a toast can arrive at any point in the
        // session, so its entry effect has to be flushed on every render.
        await FlushToastFxAsync();

        // JS interop is only legal after the first render on WASM. Both calls are
        // idempotent and swallow their own failures — offline support is an
        // enhancement, so a browser without service workers just gets the app.
        if (!firstRender) return;
        await OnlineStatus.InitializeAsync();
        await AppUpdate.InitializeAsync();
        // Score integrity: subscribes to LocationChanged and mints a play session for whatever
        // game route is showing. Started here, once, for the same reason the two above are —
        // it is app-wide behaviour, and no individual game page should have to remember it.
        await PlaySessions.InitializeAsync();
        // Third flush trigger: a queue that survived a reload (localStorage-backed)
        // should drain as soon as the app is up, without waiting for the player to
        // sign in again. Deliberately not awaited — a slow or unreachable API must
        // not delay the rest of this after-render pass, and FlushAsync is
        // re-entrancy guarded so racing the reconnect handler is harmless.
        _ = ScoreSync.FlushAsync();
        // The pre-paint script in index.html has already stamped the theme, so
        // this is not what avoids a flash. It attaches the OS-preference
        // listener that keeps "Auto" live when the system flips mid-session.
        await Settings.ApplyAsync();
    }

    /// <summary>
    /// Fire the route wipe for a navigation. Best-effort and fire-and-forget: a
    /// transition effect must never be able to delay or fail a navigation.
    /// </summary>
    private async Task PlayRouteWipeAsync(string location)
    {
        try
        {
            // routeFx wants a pathname, not the absolute URI the event carries.
            var path = new Uri(location).AbsolutePath;
            await JS.InvokeVoidAsync("PoRouteFx.play", path);
        }
        catch
        {
            // Module not loaded yet, or reduced motion pruned it — either way the
            // navigation itself has already happened and nothing is owed.
        }
    }

    /// <summary>
    /// Celebrate a completed flush: a toast naming how many runs landed, plus
    /// confetti scaled by the size of the backlog that just cleared.
    /// </summary>
    /// <remarks>
    /// The scale is deliberately sub-linear and capped — a player returning from a
    /// long offline stretch might flush a dozen runs, and a strictly proportional
    /// celebration would bury the screen. Confetti is the one effect that delegates
    /// to the WebGPU compute backend, so the big end of this range is also the
    /// cheapest it could be.
    /// </remarks>
    private async Task CelebrateFlushAsync(int synced)
    {
        if (synced <= 0) return;

        ToastService.Show(
            synced == 1 ? "Your score was saved to the leaderboard." : $"{synced} scores saved to the leaderboard.",
            ToastType.Success);

        await ScreenFx.CelebrateAsync(Math.Min(1.8, 0.7 + (0.28 * synced)));
        await Feedback.PersonalBestAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Fire the entry effect for any toast that has been rendered but not yet
    /// decorated. ToastService already played the sound on creation — this is the
    /// half that needs the element to exist, so it runs here rather than there.
    /// </summary>
    /// <remarks>
    /// Success gets particles from the toast's own box: it is the one outcome
    /// worth a flourish, and the "chime" cue ToastService fires for it would
    /// otherwise burst from the centre of the viewport (gameCues falls back to
    /// screen centre when given no position), which reads as unrelated to the
    /// notification that caused it. Every other type gets only the scale pop —
    /// an error that threw confetti would be absurd, and an info toast is too
    /// frequent to decorate at all.
    /// </remarks>
    private async Task FlushToastFxAsync()
    {
        // Snapshot before iterating. ToastService.Toasts is the live backing list and
        // the 5-second auto-dismiss removes from it on a timer continuation — which,
        // on WASM's single thread, lands during one of the awaits below. Enumerating
        // the live list would then throw "collection was modified", from a decoration
        // path, for every toast that happened to expire mid-effect.
        foreach (var toast in ToastService.Toasts.ToArray())
        {
            if (!toast.FxPending) continue;
            toast.FxPending = false;   // claim it before awaiting, so a re-entrant
                                       // render cannot fire the same effect twice

            var selector = $"[data-toast-id='{toast.Id}']";
            await ScreenFx.PopAsync(selector);
            if (toast.Type == ToastType.Success)
            {
                await ScreenFx.BurstAtAsync(selector, ScreenFxService.Sparks, 0.55);
            }
        }
    }

    // Dismiss first: the update action reloads the page, and leaving the toast up
    // through the reload flashes a stale prompt on the new build.
    private async Task RunToastAction(ToastItem toast)
    {
        ToastService.Dismiss(toast.Id);
        if (toast.Action is not null)
        {
            await toast.Action();
        }
    }

    // Account-menu destinations. NavigateTo, not an <a>: app.js turns every in-app
    // link click into a full page load.
    private async Task GoTo(string path)
    {
        await Feedback.TapAsync();
        NavigationManager.NavigateTo(path);
    }

    private async Task SignOut()
    {
        await Feedback.TapAsync();
        await AuthState.SignOutAsync();
    }

    public void Dispose()
    {
        if (_onAuthStateChanged is not null)
        {
            AuthState.StateChanged -= _onAuthStateChanged;
        }
        if (_onOnlineStateChanged is not null)
        {
            OnlineStatus.StateChanged -= _onOnlineStateChanged;
        }
        if (_onToastsChanged is not null)
        {
            ToastService.StateChanged -= _onToastsChanged;
        }
        if (_onScoresFlushed is not null)
        {
            ScoreSync.Flushed -= _onScoresFlushed;
        }
        if (_onOnlineFlush is not null)
        {
            OnlineStatus.StateChanged -= _onOnlineFlush;
        }
        if (_onLocationChanged is not null)
        {
            NavigationManager.LocationChanged -= _onLocationChanged;
        }
    }
}
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props.
         Trimming safeguards. The client references Domain directly (for the
         leaderboard row types and GameKey), so a non-trim-safe API in a public type
         here reaches the browser payload. Analyse it at its own source, not at the
         far end of the reference chain where the diagnostic loses its origin.

         The interfaces (IStorageService, a diagnostics provider interface) are under
         Abstractions/, the DTOs under Models/. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
</Project>
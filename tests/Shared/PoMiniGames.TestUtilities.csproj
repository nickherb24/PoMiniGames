<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props -->
    <!-- Shared utilities referenced by UnitTests, IntegrationTests, E2EAPI, and E2EUI.
         Must be net10.0 to align with every test host it serves. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- TierCeilingGuard is an xUnit base class, so this project compiles against xunit
         and FluentAssertions. IsTestProject stays false above: the abstract base declares
         no discoverable tests of its own, only the [Fact] its per-tier subclasses inherit. -->
    <PackageReference Include="xunit" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied into every referencing test host's output (PoCabinetLapProofs reads it there). -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- E2E-API: pure HTTP-contract tests. Boots the host in-process through
         WebApplicationFactory (TestServer) and asserts the BFF's public routes,
         status codes, and JSON shape — no browser. Browser/UI coverage lives in
         the sibling PoMiniGames.E2EUI project. -->
    <UserSecretsId>pomini-games-e2e-secret-id</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spin the real host in-process (the Blazor WASM client is BFF-served
         by the host on :5000; no separate Vite/Node). -->
    <ProjectReference Include="..\..\src\PoMiniGames.API\PoMiniGames.API.csproj" />
    <!-- Shared test utilities (TestBudgetGuard, etc.) — explicit ProjectReference
         so the fixture compiles whether or not tests/Shared/PoMiniGames.TestUtilities.csproj
         is registered in the solution. -->
    <ProjectReference Include="..\Shared\PoMiniGames.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <!-- ArmAntiforgeryAsync is needed by every test that writes; a global using keeps
         the CSRF plumbing out of each file's header. -->
    <Using Include="PoMiniGames.TestUtilities" />
  </ItemGroup>

</Project>

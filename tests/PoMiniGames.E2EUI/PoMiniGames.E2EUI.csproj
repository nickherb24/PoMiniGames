<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- E2E-UI: real-browser tests driven by Microsoft.Playwright (C#).
         The host is started on a real Kestrel port (see KestrelServerFixture)
         so Playwright can navigate to it over HTTP, then assert the rendered
         Blazor WASM UI. Pure HTTP-contract checks live in PoMiniGames.E2EAPI. -->
    <UserSecretsId>pomini-games-e2e-secret-id</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Testcontainers.Azurite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PoMiniGames.API\PoMiniGames.API.csproj" />
    <!-- Shared test utilities (TestBudgetGuard, etc.) — explicit ProjectReference
         so the fixture compiles whether or not tests/Shared/PoMiniGames.TestUtilities.csproj
         is registered in the solution. -->
    <ProjectReference Include="..\Shared\PoMiniGames.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <!--
    Zero-waste E2E-UI preflight. The Playwright Chromium binary must be
    present before VSTest runs, otherwise every test fails in <2s with
    "Executable doesn't exist at …\chrome-win\headless_shell.exe".
    scripts/test-all.ps1 has a try/catch preflight that warns on install
    failure; a developer (or CI) running this project in isolation would
    otherwise hit four red tests and a misleading Playwright exception.
    This target fails the build (not the test) if the browser is missing,
    so the signal is "Playwright Chromium not installed" not "test failure".
    Skip with `-p:SkipPlaywrightInstall=true` when the environment already
    has Chromium provisioned (e.g. a cached build agent image).
  -->
  <Target Name="EnsurePlaywrightBrowsers" BeforeTargets="VSTest" Condition="'$(SkipPlaywrightInstall)' != 'true' AND '$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <_PlaywrightScript>$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0\playwright.ps1</_PlaywrightScript>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_PlaywrightScript)&quot; install chromium" IgnoreExitCode="false" ContinueOnError="false" />
  </Target>

</Project>

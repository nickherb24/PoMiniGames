<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM / Nullable / ImplicitUsings inherited from Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <!-- Project name == assembly name == root namespace, matching the
         <sln>.<Tier> convention (PoMiniGames.Unit / .Integration / .E2EAPI / .E2EUI). -->
    <AssemblyName>PoMiniGames.Integration</AssemblyName>
    <RootNamespace>PoMiniGames.Integration</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.Azurite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PoMiniGames.API\PoMiniGames.API.csproj" />
    <ProjectReference Include="..\..\src\PoMiniGames.Client\PoMiniGamesClient.csproj" />
    <!-- Shared test utilities (TestBudgetGuard, etc.) — explicit ProjectReference
         so the fixture compiles whether or not tests/Shared/PoMiniGames.TestUtilities.csproj
         is registered in the solution. -->
    <ProjectReference Include="..\Shared\PoMiniGames.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- ArmAntiforgeryAsync is needed by every test that writes; a global using keeps
         the CSRF plumbing out of each file's header. -->
    <Using Include="PoMiniGames.TestUtilities" />
  </ItemGroup>

</Project>